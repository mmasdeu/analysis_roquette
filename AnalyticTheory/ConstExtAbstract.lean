import AnalyticTheory.Basic

/-!
# Constant extensions as tensor products (abstract form)

Let `E` and `L'` be `K`-algebras (fields) and `D` a field containing images of both, with
`D = L'-span of E` and such that a `K`-basis of `E` stays `L'`-linearly independent in `D`. Then any
field `FL` generated by (images of) `E` and `L'` is `L'`-isomorphic to `D`: both are quotients of
`L' ⊗_K E`, and for `D` this quotient map is bijective.
-/

namespace AnalyticTheory

open TensorProduct

universe u

variable {K E L' D FL : Type u} [Field K] [Field E] [Field L'] [Field D] [Field FL]
  [Algebra K E] [Algebra K L'] [Algebra L' D] [Algebra K D] [IsScalarTower K L' D]
  [Algebra E FL] [Algebra L' FL] [Algebra K FL] [IsScalarTower K E FL] [IsScalarTower K L' FL]

theorem exists_algEquiv_of_basis (ι : E →ₐ[K] D)
    (hspan : ∀ x : D, x ∈ Submodule.span L' (Set.range ι))
    (hind : LinearIndependent L' (fun j => ι (Module.Free.chooseBasis K E j)))
    (hgen : Subfield.closure
      (Set.range (algebraMap E FL) ∪ Set.range (algebraMap L' FL)) = ⊤) :
    Nonempty (FL ≃ₐ[L'] D) := by
  classical
  let B := Module.Free.chooseBasis K E
  let φ : L' ⊗[K] E →ₐ[L'] D :=
    Algebra.TensorProduct.lift (Algebra.ofId L' D) ι (fun _ _ => Commute.all _ _)
  have hφ : ∀ (m : L') (e : E), φ (m ⊗ₜ e) = algebraMap L' D m * ι e := fun m e => by
    rw [Algebra.TensorProduct.lift_tmul]; rfl
  have hinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro t ht
    obtain ⟨b, rfl⟩ := TensorProduct.eq_repr_basis_right B t
    have hb : b = 0 := by
      refine (linearIndependent_iff.mp hind) b ?_
      rw [Finsupp.linearCombination_apply]
      rw [map_finsuppSum] at ht
      simpa [hφ, Algebra.smul_def, Finsupp.sum] using ht
    simp [hb]
  have hsurj : Function.Surjective φ := by
    intro x
    have hx := hspan x
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨e, rfl⟩ := hy
      exact ⟨1 ⊗ₜ e, by rw [hφ, map_one, one_mul]⟩
    | zero => exact ⟨0, map_zero _⟩
    | add y z _ _ hy hz =>
      obtain ⟨a, rfl⟩ := hy
      obtain ⟨b, rfl⟩ := hz
      exact ⟨a + b, map_add _ _ _⟩
    | smul c y _ hy =>
      obtain ⟨a, rfl⟩ := hy
      exact ⟨c • a, map_smul _ _ _⟩
  let Φ := AlgEquiv.ofBijective φ ⟨hinj, hsurj⟩
  let ψ : L' ⊗[K] E →ₐ[L'] FL :=
    Algebra.TensorProduct.lift (Algebra.ofId L' FL) (IsScalarTower.toAlgHom K E FL)
      (fun _ _ => Commute.all _ _)
  let χ : D →ₐ[L'] FL := ψ.comp Φ.symm.toAlgHom
  have hχψ : ∀ t, χ (φ t) = ψ t := fun t => by
    show ψ (Φ.symm (Φ t)) = ψ t
    rw [AlgEquiv.symm_apply_apply]
  have hχinj : Function.Injective χ := χ.toRingHom.injective
  have hχsurj : Function.Surjective χ := by
    have hle : Subfield.closure
        (Set.range (algebraMap E FL) ∪ Set.range (algebraMap L' FL)) ≤ χ.fieldRange.toSubfield := by
      rw [Subfield.closure_le]
      rintro x (⟨f, rfl⟩ | ⟨l, rfl⟩)
      · refine ⟨φ (1 ⊗ₜ f), ?_⟩
        show χ (φ (1 ⊗ₜ f)) = _
        rw [hχψ, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      · refine ⟨φ (l ⊗ₜ 1), ?_⟩
        show χ (φ (l ⊗ₜ 1)) = _
        rw [hχψ, Algebra.TensorProduct.lift_tmul, map_one, mul_one]
        rfl
    rw [hgen] at hle
    intro x
    exact hle (Subfield.mem_top x)
  exact ⟨(AlgEquiv.ofBijective χ ⟨hχinj, hχsurj⟩).symm⟩

section galois

variable {K E L' M F : Type u} [Field K] [Field E] [Field L'] [Field M] [Field F]
  [Algebra K E] [Algebra K L'] [Algebra L' M] [Algebra M F] [Algebra L' F] [Algebra K F]
  [IsScalarTower L' M F] [FiniteDimensional L' M] [IsGalois L' M]
  [MulSemiringAction (M ≃ₐ[L'] M) F]

/-- Fixed vectors lying in the `M`-span of an `M`-independent family of fixed vectors lie in its
`L'`-span. -/
theorem mem_span_of_fixed {J : Type*} (v : J → F) (hind : LinearIndependent M v)
    (hfix : ∀ (g : M ≃ₐ[L'] M) j, g • v j = v j)
    (hsemi : ∀ (g : M ≃ₐ[L'] M) (m : M) (x : F), g • (m • x) = g m • g • x)
    (x : F) (hx : x ∈ Submodule.span M (Set.range v)) (hfx : ∀ g : M ≃ₐ[L'] M, g • x = x) :
    x ∈ Submodule.span L' (Set.range v) := by
  classical
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hx
  have hinjc := hind.finsuppLinearCombination_injective
  have hfixc : ∀ (g : M ≃ₐ[L'] M) j, g (c j) = c j := fun g j => by
    have h1 : g • x = Finsupp.linearCombination M v (Finsupp.mapRange g (map_zero g) c) := by
      rw [← hc, Finsupp.linearCombination_apply, Finsupp.sum_mapRange_index (h := fun i a => a • v i) (fun _ => zero_smul _ _),
        Finsupp.sum, Finset.smul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hsemi, hfix]
    have h2 : Finsupp.linearCombination M v (Finsupp.mapRange g (map_zero g) c) =
        Finsupp.linearCombination M v c := by
      rw [← h1, Finsupp.linearCombination_apply, hc, hfx]
    have := congrArg (fun d => d j) (hinjc h2)
    simpa using this
  have hmem : ∀ j, ∃ a : L', algebraMap L' M a = c j := fun j => by
    have := (IsGalois.mem_bot_iff_fixed (F := L') (E := M) (c j)).mpr (hfixc · j)
    exact IntermediateField.mem_bot.mp this
  choose a ha using hmem
  rw [← hc, Finsupp.sum]
  refine Submodule.sum_mem _ fun j _ => ?_
  rw [← ha j, algebraMap_smul]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)

end galois

end AnalyticTheory
