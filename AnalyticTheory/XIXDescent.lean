import AnalyticTheory.XIXPeriod
import AnalyticTheory.Sec4Torsor

/-!
# §6, Theorem XIX: descent of elliptic subfields of `F_K(𝐐)`

For an elliptic subfield `E` of `F = F_K(𝐐) ⊂ F_L(q)`, the field `EL ⊂ F_L(q)` generated by `E` and
`L` is stable under `ρ = τ_Q σ`; by Theorem XVIII over `L` it is `F_L(q̄ | Xᵐ)`, and the stability
forces `σ q̄ = q̄`, i.e. `q̄ ∈ K`.
-/

namespace AnalyticTheory

universe u

section descent

variable {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable {L : Type u} [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
variable [NormedAlgebra K L] [FiniteDimensional K L] [IsGalois K L]
variable (q : K) (T : SemiPeriodicTriple K L q)

/-- `Q` as a unit. -/
noncomputable def tQ : Lˣ := Units.mk0 T.Q T.Q_ne

/-- The automorphism `ρ = τ_Q σ` of `F_L(q)` whose fixed field is `F_K(𝐐)`. -/
noncomputable def rhoT : FqSub L (algebraMap K L q) ≃+* FqSub L (algebraMap K L q) :=
  (galFq q T.gen).trans (translationFq (algebraMap K L q) (tQ q T))

theorem rhoT_coe (f : FqSub L (algebraMap K L q)) :
    ((rhoT q T f : FqSub L (algebraMap K L q)) : MeroRing L) =
      translation L (tQ q T) (meroGal T.gen (f : MeroRing L)) := rfl

theorem rhoT_fkq (f : FqSub L (algebraMap K L q)) (hf : f ∈ FKQ K L q T) : rhoT q T f = f :=
  Subtype.ext (hf (T.gen, tQ q T) rfl (meroGal T.gen) (isGalAct_meroGal T.gen))

theorem rhoT_const (l : L) :
    rhoT q T (algebraMap L (FqSub L (algebraMap K L q)) l) =
      algebraMap L (FqSub L (algebraMap K L q)) (T.gen l) := by
  apply Subtype.ext
  rw [rhoT_coe]
  show translation L (tQ q T) (meroGal T.gen (algebraMap L (MeroRing L) l)) =
    algebraMap L (MeroRing L) (T.gen l)
  rw [meroGal_algebraMap, translation_algebraMap]

/-- The embedding `E ⊂ F_K(𝐐) ⊂ F_L(q)`. -/
noncomputable def xiIota (E : Subfield (FKQ K L q T)) : E →+* FqSub L (algebraMap K L q) :=
  (FKQ K L q T).subtype.comp E.subtype

/-- `EL` is stable under `ρ = τ_Q σ`. -/
theorem rhoT_mem_elSub (E : Subfield (FKQ K L q T)) {x : FqSub L (algebraMap K L q)}
    (hx : x ∈ elSub (L := L) (xiIota q T E)) : rhoT q T x ∈ elSub (L := L) (xiIota q T E) := by
  have hle : elSub (L := L) (xiIota q T E) ≤
      (elSub (L := L) (xiIota q T E)).comap (rhoT q T).toRingHom := by
    unfold elSub
    rw [Subfield.closure_le]
    rintro _ (⟨e, rfl⟩ | ⟨l, rfl⟩)
    · rw [SetLike.mem_coe, Subfield.mem_comap]
      show rhoT q T (xiIota q T E e) ∈ Subfield.closure _
      rw [show rhoT q T (xiIota q T E e) = xiIota q T E e from rhoT_fkq q T _ (e : FKQ K L q T).2]
      exact Subfield.subset_closure (Or.inl ⟨e, rfl⟩)
    · rw [SetLike.mem_coe, Subfield.mem_comap]
      show rhoT q T (algebraMap L _ l) ∈ Subfield.closure _
      rw [rhoT_const]
      exact Subfield.subset_closure (Or.inr ⟨_, rfl⟩)
  exact hle hx

/-- If `EL = F_L(q̄ | Xᵐ)` then `σ q̄ = q̄` for the generator `σ`. -/
theorem gen_fixes_period (E : Subfield (FKQ K L q T)) {qb : L} (hqb0 : 0 < ‖qb‖) (hqb1 : ‖qb‖ < 1)
    {m : ℕ} (hm : 0 < m)
    (hEq : (elSub (L := L) (xiIota q T E)).map (FqSub L (algebraMap K L q)).subtype =
      FqbarXm L qb m) : T.gen qb = qb := by
  set σ := T.gen with hσ
  have hmz : (m : ℤ) ≠ 0 := by exact_mod_cast hm.ne'
  have hqb : qb ≠ 0 := norm_pos_iff.mp hqb0
  have hσ0 : 0 < ‖σ qb‖ := by rw [gal_norm]; exact hqb0
  have hσ1 : ‖σ qb‖ < 1 := by rw [gal_norm]; exact hqb1
  have hσqb : σ qb ≠ 0 := norm_pos_iff.mp hσ0
  -- stability of `F_L(q̄|Xᵐ)` under `τ_Q σ`
  have hstab : ∀ x ∈ FqbarXm L qb m, translation L (tQ q T) (meroGal σ x) ∈ FqbarXm L qb m := by
    intro x hx
    rw [← hEq] at hx ⊢
    obtain ⟨y, hy, rfl⟩ := hx
    exact ⟨rhoT q T y, rhoT_mem_elSub q T E hy, rfl⟩
  have hsub : ∀ g ∈ FqSub L (σ qb), g ∈ FqSub L qb := by
    intro g hg
    set g1 := translation L ((tQ q T) ^ (-(m : ℤ))) g with hg1
    have hg1m : g1 ∈ FqSub L (σ qb) := (translationFq (σ qb) _ ⟨g, hg⟩).2
    set h := meroGal σ⁻¹ g1 with hh
    have hhm : h ∈ FqSub L qb := by
      have := meroGal_mem_FqSub σ⁻¹ hσqb hg1m
      rwa [show (σ⁻¹ : L ≃ₐ[K] L) (σ qb) = qb from σ.symm_apply_apply qb] at this
    have hx : substPow L m h ∈ FqbarXm L qb m := ⟨h, hhm, rfl⟩
    have h2 := hstab _ hx
    have e1 : translation L (tQ q T) (meroGal σ (substPow L m h)) = substPow L m g := by
      rw [meroGal_substPow σ hmz, hh, meroGal_meroGal, mul_inv_cancel, meroGal_one,
        ← substPow_translation hmz, hg1, ← translation_mul, ← zpow_add, add_neg_cancel, zpow_zero,
        translation_one]
    rw [e1] at h2
    obtain ⟨g', hg', he⟩ := h2
    rw [substPow_injective hmz he] at hg'
    exact hg'
  have hfix : ∀ g ∈ FqSub L (σ qb), translation L (Units.mk0 qb hqb) g = g := fun g hg =>
    (mem_Fq_iff hqb g).mp (hsub g hg)
  obtain ⟨k, hk⟩ := exists_zpow_of_translation_fix hσ0 hσ1 (Units.mk0 qb hqb) hfix
  simp only [Units.val_mk0] at hk
  have hk1 : k = 1 := by
    have := congrArg norm hk
    rw [norm_zpow, gal_norm] at this
    exact ((zpow_right_inj₀ hqb0 hqb1.ne).mp (by rw [zpow_one]; exact this)).symm
  rw [hk1, zpow_one] at hk
  exact hk.symm

theorem mem_K_of_gen_fixed {x : L} (h : T.gen x = x) : x ∈ Set.range (algebraMap K L) := by
  rw [IsGalois.mem_range_algebraMap_iff_fixed]
  intro f
  obtain ⟨a, rfl⟩ := gen_zpow q T f
  have hinv : T.gen⁻¹ x = x := by
    conv_lhs => rw [← h]
    exact T.gen.symm_apply_apply x
  induction a using Int.induction_on with
  | zero => rfl
  | succ n ih => rw [zpow_add_one, AlgEquiv.mul_apply, h, ih]
  | pred n ih => rw [zpow_sub_one, AlgEquiv.mul_apply, hinv, ih]

/-- Elements of `EL` are `E`-linear combinations of a `K`-basis of `L`. -/
theorem exists_sum_of_mem_elSub (E : Subfield (FKQ K L q T)) (hKE : ∀ c : K, algebraMap K (FKQ K L q T) c ∈ E)
    {x : FqSub L (algebraMap K L q)} (hx : x ∈ elSub (L := L) (xiIota q T E)) :
    ∃ c : Fin (Module.finrank K L) → FqSub L (algebraMap K L q),
      (∀ i, c i ∈ (xiIota q T E).fieldRange) ∧
        x = ∑ i, c i * algebraMap L _ (Module.finBasis K L i) := by
  classical
  set E'' := (xiIota q T E).fieldRange with hE''
  set S : Set (FqSub L (algebraMap K L q)) := Set.range (algebraMap L (FqSub L (algebraMap K L q))) with hS
  set b := Module.finBasis K L
  -- constants of `K` lie in `E''`
  have hK : ∀ c : K, algebraMap L (FqSub L (algebraMap K L q)) (algebraMap K L c) ∈ E'' := fun c =>
    ⟨⟨algebraMap K (FKQ K L q T) c, hKE c⟩, rfl⟩
  let φ : K →+* E'' := (algebraMap L (FqSub L (algebraMap K L q))).comp (algebraMap K L) |>.codRestrict E'' hK
  have hφ : ∀ c, ((φ c : E'') : (FqSub L (algebraMap K L q))) = algebraMap L (FqSub L (algebraMap K L q)) (algebraMap K L c) := fun _ => rfl
  -- `x ∈ adjoin E'' S`
  have h1 : x ∈ IntermediateField.adjoin E'' S := by
    have hle : elSub (L := L) (xiIota q T E) ≤ (IntermediateField.adjoin E'' S).toSubfield := by
      unfold elSub
      rw [Subfield.closure_le]
      rintro _ (⟨e, rfl⟩ | ⟨l, rfl⟩)
      · exact (IntermediateField.adjoin E'' S).algebraMap_mem ⟨xiIota q T E e, e, rfl⟩
      · exact IntermediateField.subset_adjoin E'' S ⟨l, rfl⟩
    exact hle hx
  -- algebraicity of `S` over `E''`
  have halg : ∀ y ∈ S, IsAlgebraic E'' y := by
    rintro _ ⟨l, rfl⟩
    obtain ⟨p, hp, hpl⟩ := Algebra.IsAlgebraic.isAlgebraic (R := K) l
    refine ⟨p.map φ, (Polynomial.map_ne_zero_iff φ.injective).mpr hp, ?_⟩
    rw [Polynomial.aeval_def, Polynomial.eval₂_map]
    have : (algebraMap E'' (FqSub L (algebraMap K L q))).comp φ = (algebraMap L (FqSub L (algebraMap K L q))).comp (algebraMap K L) := by
      ext c; rfl
    rw [this, ← Polynomial.eval₂_map, Polynomial.eval₂_map, ← Polynomial.hom_eval₂,
      ← Polynomial.aeval_def, hpl, map_zero]
  have h2 : x ∈ Algebra.adjoin E'' S := by
    rw [← IntermediateField.adjoin_toSubalgebra_of_isAlgebraic halg]; exact h1
  have h3 : x ∈ Submodule.span E'' (Set.range fun i => algebraMap L (FqSub L (algebraMap K L q)) (b i)) := by
    have := (Submodule.ext_iff.mp (Algebra.adjoin_eq_span E'' S) x).mp h2
    refine Submodule.span_le.mpr ?_ this
    intro y hy
    have hyS : y ∈ S := by
      have hsub : Submonoid.closure S ≤ MonoidHom.mrange (algebraMap L (FqSub L (algebraMap K L q))).toMonoidHom :=
        Submonoid.closure_le.mpr (by rintro _ ⟨l, rfl⟩; exact ⟨l, rfl⟩)
      obtain ⟨l, hl⟩ := hsub hy
      exact ⟨l, hl⟩
    obtain ⟨l, rfl⟩ := hyS
    rw [← b.sum_repr l, map_sum]
    refine Submodule.sum_mem _ fun i _ => ?_
    rw [Algebra.smul_def, map_mul]
    have : algebraMap L (FqSub L (algebraMap K L q)) (algebraMap K L (b.repr l i)) *
        algebraMap L (FqSub L (algebraMap K L q)) (b i) =
        φ (b.repr l i) • algebraMap L (FqSub L (algebraMap K L q)) (b i) := by
      rw [Algebra.smul_def]; rfl
    rw [this]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun E'').mp h3
  exact ⟨fun i => (c i : (FqSub L (algebraMap K L q))), fun i => (c i).2, by rw [← hc]; rfl⟩

/-- `EL ∩ E_ζ = E`: an element of `EL` fixed by the twisted Galois action lies in `E` (trace
argument). -/
theorem mem_fieldRange_of_fixed (ζ : CocycleModQ K L q) (E : Subfield (FKQ K L q T))
    (hKE : ∀ c : K, algebraMap K (FKQ K L q T) c ∈ E)
    (hEfix : ∀ e τ, rhoZ q ζ τ (xiIota q T E e) = xiIota q T E e)
    {x : FqSub L (algebraMap K L q)} (hx : x ∈ elSub (L := L) (xiIota q T E))
    (hfix : ∀ τ, rhoZ q ζ τ x = x) : x ∈ (xiIota q T E).fieldRange := by
  classical
  obtain ⟨c, hc, rfl⟩ := exists_sum_of_mem_elSub q T E hKE hx
  set b := Module.finBasis K L
  set A := algebraMap L (FqSub L (algebraMap K L q))
  have hcfix : ∀ i τ, rhoZ q ζ τ (c i) = c i := by
    intro i τ
    obtain ⟨e, he⟩ := hc i
    rw [← he]; exact hEfix e τ
  obtain ⟨l, hl⟩ : ∃ l : L, Algebra.trace K L l ≠ 0 := by
    by_contra h
    push_neg at h
    exact Algebra.trace_ne_zero K L (LinearMap.ext h)
  have hconst : ∀ τ l, rhoZ q ζ τ (A l) = A (τ l) := fun τ l => rhoZ_const q ζ τ l
  set x := ∑ i, c i * A (b i) with hxdef
  have key1 : ∑ τ : L ≃ₐ[K] L, rhoZ q ζ τ (A l * x) = A (algebraMap K L (Algebra.trace K L l)) * x := by
    simp_rw [map_mul, hconst, hfix]
    rw [← Finset.sum_mul, ← map_sum, trace_eq_sum_automorphisms]
  have key2 : ∑ τ : L ≃ₐ[K] L, rhoZ q ζ τ (A l * x) =
      ∑ i, c i * A (algebraMap K L (Algebra.trace K L (l * b i))) := by
    rw [hxdef, Finset.mul_sum]
    simp_rw [map_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp_rw [show ∀ τ, rhoZ q ζ τ (A l * (c i * A (b i))) = c i * A (τ (l * b i)) from fun τ => by
      rw [show A l * (c i * A (b i)) = c i * A (l * b i) by rw [map_mul]; ring, map_mul, hcfix,
        hconst]]
    rw [← Finset.mul_sum, ← map_sum, trace_eq_sum_automorphisms]
  have htr : A (algebraMap K L (Algebra.trace K L l)) ≠ 0 :=
    (map_ne_zero_iff _ A.injective).mpr ((map_ne_zero_iff _ (algebraMap K L).injective).mpr hl)
  have hK : ∀ d : K, A (algebraMap K L d) ∈ (xiIota q T E).fieldRange := fun d =>
    ⟨⟨algebraMap K (FKQ K L q T) d, hKE d⟩, rfl⟩
  have heq : x = (∑ i, c i * A (algebraMap K L (Algebra.trace K L (l * b i)))) /
      A (algebraMap K L (Algebra.trace K L l)) := by
    rw [← key2, key1]; field_simp
  rw [heq]
  refine div_mem (sum_mem fun i _ => mul_mem (hc i) (hK _)) (hK _)

variable (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)

include hq0 hq1 in
/-- Theorem XVIII over `L` applied to `EL`, and `q̄ ∈ K`. -/
theorem exists_period_elSub (E : Subfield (FKQ K L q T)) (hE : IsEllipticSubfield K E) :
    ∃ (qK : K) (m : ℕ) (d : ℕ), 0 < ‖qK‖ ∧ ‖qK‖ < 1 ∧ 0 < m ∧ 0 < d ∧ qK ^ d = q ^ m ∧
      (elSub (L := L) (xiIota q T E)).map (FqSub L (algebraMap K L q)).subtype =
        FqbarXm L (algebraMap K L qK) m := by
  obtain ⟨h, hE'⟩ := hE
  letI := subfieldAlgebra K E h
  letI := fqKAlgebra (L := L) q
  haveI := fqK_tower_L (L := L) q
  let ι : E →ₐ[K] FqSub L (algebraMap K L q) :=
    { toRingHom := xiIota q T E, commutes' := fun _ => rfl }
  have hF : IsFunctionFieldOver L (FqSub L (algebraMap K L q)) :=
    fq_is_function_field L (algebraMap K L q) (norm_alg_pos (L := L) q hq0)
      (norm_alg_lt (L := L) q hq1)
  have hEL : IsEllipticOver L (EL L ι) := EL_isElliptic L ι hE' hF
  obtain ⟨qb, m, hqb0, hqb1, -, hm, ⟨d, hd⟩, hEq, -, -⟩ :=
    thmXVIII_main (norm_alg_pos (L := L) q hq0) (norm_alg_lt (L := L) q hq1)
      (elSub (L := L) ι.toRingHom) (algebraMap_mem_elSub _) hEL
  have hfix := gen_fixes_period q T E hqb0 hqb1 hm hEq
  obtain ⟨qK, rfl⟩ := mem_K_of_gen_fixed q T hfix
  rw [norm_algebraMap'] at hqb0 hqb1
  -- `d > 0`
  have hdpos : 0 < d := by
    by_contra hle
    push_neg at hle
    have h1 := congrArg norm hd
    rw [norm_zpow, norm_zpow, norm_algebraMap', norm_algebraMap'] at h1
    have h2 : 1 ≤ ‖qK‖ ^ d := one_le_zpow_of_nonpos₀ hqb0 hqb1.le hle
    have h3 : ‖q‖ ^ (m : ℤ) < 1 := by
      rw [zpow_natCast]; exact pow_lt_one₀ (norm_nonneg _) hq1 hm.ne'
    linarith
  obtain ⟨d', rfl⟩ := Int.eq_ofNat_of_zero_le hdpos.le
  refine ⟨qK, m, d', hqb0, hqb1, hm, by exact_mod_cast hdpos, ?_, hEq⟩
  apply (algebraMap K L).injective
  rw [map_pow, map_pow]
  simpa [zpow_natCast] using hd

end descent

end AnalyticTheory
