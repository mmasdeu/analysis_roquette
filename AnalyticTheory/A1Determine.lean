import AnalyticTheory.A1Unique
import AnalyticTheory.A1Classify

/-!
# Appendix A1: `j` and `γ` determine `F | K`

If `F | K` and `F' | K` have Weierstraß data with the same `j ≠ 0, 12³` and equivalent Hasse
classes, the data differ by a change of variables (`A1Classify.lean`); transporting one of them,
both fields are generated by solutions of the same Weierstraß equation, and hence isomorphic
(`A1Unique.lean`).

Blueprint nodes: `thm:A-uniqueness`.
-/

namespace AnalyticTheory

universe u

section affine

variable {K F : Type u} [Field K] [Field F] [Algebra K F] {𝔭 : PrimeDivisor K F}

theorem PoleOrd.affine2 {x : F} (hx : PoleOrd 𝔭 x 2) {a : K} (ha : a ≠ 0) (b : K) :
    PoleOrd 𝔭 (algebraMap K F a * x + algebraMap K F b) 2 := by
  refine ⟨?_, fun hmem => hx.2 ?_⟩
  · refine Submodule.add_mem _ ?_ (const_mem_Ln (by norm_num) b)
    rw [← Algebra.smul_def]
    exact Submodule.smul_mem _ _ hx.1
  · have h1 := Submodule.sub_mem _ hmem (const_mem_Ln (𝔭 := 𝔭) (n := 2 - 1) (by norm_num) b)
    rw [add_sub_cancel_right, ← Algebra.smul_def] at h1
    have := Submodule.smul_mem _ a⁻¹ h1
    rwa [smul_smul, inv_mul_cancel₀ ha, one_smul] at this

theorem PoleOrd.affine3 {x y : F} (hx : PoleOrd 𝔭 x 2) (hy : PoleOrd 𝔭 y 3) {a : K} (ha : a ≠ 0)
    (b c : K) :
    PoleOrd 𝔭 (algebraMap K F a * y + algebraMap K F b * x + algebraMap K F c) 3 := by
  have hx2 : algebraMap K F b * x ∈ Ln 𝔭 2 := by
    rw [← Algebra.smul_def]; exact Submodule.smul_mem _ _ hx.1
  refine ⟨?_, fun hmem => hy.2 ?_⟩
  · refine Submodule.add_mem _ (Submodule.add_mem _ ?_ (Ln_mono 𝔭 (by norm_num) hx2))
      (const_mem_Ln (by norm_num) c)
    rw [← Algebra.smul_def]
    exact Submodule.smul_mem _ _ hy.1
  · have hx2' : algebraMap K F b * x ∈ Ln 𝔭 (3 - 1) := by simpa using hx2
    have h1 := Submodule.sub_mem _ hmem (const_mem_Ln (𝔭 := 𝔭) (n := 3 - 1) (by norm_num) c)
    have h2 := Submodule.sub_mem _ h1 hx2'
    have e : algebraMap K F a * y + algebraMap K F b * x + algebraMap K F c - algebraMap K F c -
        algebraMap K F b * x = a • y := by rw [Algebra.smul_def]; ring
    rw [e] at h2
    have := Submodule.smul_mem _ a⁻¹ h2
    rwa [smul_smul, inv_mul_cancel₀ ha, one_smul] at this

end affine

section determine

variable (K : Type u) (F F' : Type u) [Field K] [Field F] [Field F'] [Algebra K F] [Algebra K F']

theorem exists_data_of_absInv_ne_zero (hF : HasPrimeOfDegreeOne K F) (h : absInv K F hF ≠ 0) :
    Nonempty (WeierstrassData K F) := by
  by_contra hne
  apply h
  unfold absInv
  rw [dif_neg hne]

/-- Book, §A1, uniqueness: two fields with a prime divisor of degree 1 and equal absolute
invariants and equivalent Hasse invariants are `K`-isomorphic (for `j ≠ 0, 12³`). -/
theorem absolute_hasse_determine (hE : IsEllipticOver K F) (hE' : IsEllipticOver K F')
    (hF : HasPrimeOfDegreeOne K F) (hF' : HasPrimeOfDegreeOne K F')
    (hj0 : absInv K F hF ≠ 0 ∧ absInv K F hF ≠ 12 ^ 3) (hj : absInv K F hF = absInv K F' hF')
    (hγ : (ringChar K ≠ 2 → SquareEquiv (hasseInv K F hF) (hasseInv K F' hF')) ∧
      (ringChar K = 2 → PiEquiv (hasseInv K F hF) (hasseInv K F' hF'))) :
    Nonempty (F ≃ₐ[K] F') := by
  have hne := exists_data_of_absInv_ne_zero K F hF hj0.1
  have hne' := exists_data_of_absInv_ne_zero K F' hF' (hj ▸ hj0.1)
  set d := Classical.choice hne with hd
  set d' := Classical.choice hne' with hd'
  have hjF : absInv K F hF = jc d.curve := by unfold absInv; rw [dif_pos hne]; rfl
  have hjF' : absInv K F' hF' = jc d'.curve := by unfold absInv; rw [dif_pos hne']; rfl
  have hhF : hasseInv K F hF = hc d.curve := by unfold hasseInv; rw [dif_pos hne]; rfl
  have hhF' : hasseInv K F' hF' = hc d'.curve := by unfold hasseInv; rw [dif_pos hne']; rfl
  have hΔ : d.curve.Δ ≠ 0 := by
    have := d.disc
    rwa [wDisc_eq] at this
  have hΔ' : d'.curve.Δ ≠ 0 := by
    have := d'.disc
    rwa [wDisc_eq] at this
  obtain ⟨C, hC⟩ := exists_variableChange_of_invariants d.curve d'.curve hΔ hΔ'
    (by rw [← hjF, ← hjF', hj]) (by rw [← hjF]; exact hj0.1) (by rw [← hjF]; exact hj0.2)
    (by rw [← hhF, ← hhF']; exact hγ)
  -- transport the datum of `F` along `C`
  have hu : ((C.u : Kˣ) : K) ≠ 0 := C.u.ne_zero
  have hū : (((C.u⁻¹ : Kˣ)) : K) ≠ 0 := (C.u⁻¹).ne_zero
  have huū : ((C.u : Kˣ) : K) * ((C.u⁻¹ : Kˣ) : K) = 1 := by simp
  set σ := algebraMap K F with hσ
  set x₁ : F := σ (((C.u⁻¹ : Kˣ)) : K) ^ 2 * (d.x - σ C.r) with hx₁
  set y₁ : F := σ (((C.u⁻¹ : Kˣ)) : K) ^ 3 * (d.y - σ C.s * (d.x - σ C.r) - σ C.t) with hy₁
  have hσu : σ ((C.u : Kˣ) : K) * σ (((C.u⁻¹ : Kˣ)) : K) = 1 := by rw [← map_mul, huū, map_one]
  have hX : d.x = σ ((C.u : Kˣ) : K) ^ 2 * x₁ + σ C.r := by
    rw [hx₁]
    have : σ ((C.u : Kˣ) : K) ^ 2 * σ (((C.u⁻¹ : Kˣ)) : K) ^ 2 = 1 := by
      rw [← mul_pow, hσu, one_pow]
    linear_combination (-(d.x - σ C.r)) * this
  have hY : d.y = σ ((C.u : Kˣ) : K) ^ 3 * y₁ + σ ((C.u : Kˣ) : K) ^ 2 * σ C.s * x₁ + σ C.t := by
    rw [hy₁, hx₁]
    have h3 : σ ((C.u : Kˣ) : K) ^ 3 * σ (((C.u⁻¹ : Kˣ)) : K) ^ 3 = 1 := by
      rw [← mul_pow, hσu, one_pow]
    have h2 : σ ((C.u : Kˣ) : K) ^ 2 * σ (((C.u⁻¹ : Kˣ)) : K) ^ 2 = 1 := by
      rw [← mul_pow, hσu, one_pow]
    linear_combination (-(d.y - σ C.s * (d.x - σ C.r) - σ C.t)) * h3 -
      σ C.s * (d.x - σ C.r) * h2
  have hnf : NormalForm d'.curve x₁ y₁ := by
    rw [hC]
    exact normalForm_smul C hX hY d.normalForm
  have hx1 : PoleOrd d.𝔭 x₁ 2 := by
    have := d.poleOrd_x.affine2 (a := (((C.u⁻¹ : Kˣ)) : K) ^ 2) (pow_ne_zero _ hū)
      (-(((C.u⁻¹ : Kˣ)) : K) ^ 2 * C.r)
    convert this using 1
    rw [hx₁]; simp only [map_mul, map_pow, map_neg]; ring
  have hy1 : PoleOrd d.𝔭 y₁ 3 := by
    have := PoleOrd.affine3 d.poleOrd_x d.poleOrd_y (a := (((C.u⁻¹ : Kˣ)) : K) ^ 3)
      (pow_ne_zero _ hū) (-(((C.u⁻¹ : Kˣ)) : K) ^ 3 * C.s)
      ((((C.u⁻¹ : Kˣ)) : K) ^ 3 * (C.s * C.r - C.t))
    convert this using 1
    rw [hy₁]; simp only [map_mul, map_pow, map_neg, map_sub]; ring
  have hgen1 : IntermediateField.adjoin K ({x₁, y₁} : Set F) = ⊤ := by
    rw [eq_top_iff]
    intro z _
    have hz : z ∈ IntermediateField.adjoin K ({d.x, d.y} : Set F) := by rw [d.gen]; trivial
    have hle : IntermediateField.adjoin K ({d.x, d.y} : Set F) ≤
        IntermediateField.adjoin K ({x₁, y₁} : Set F) := by
      rw [IntermediateField.adjoin_le_iff]
      intro w hw
      rcases hw with h1 | h1
      · rw [h1, hX]
        refine add_mem (mul_mem (pow_mem (IntermediateField.algebraMap_mem _ _) 2)
          (IntermediateField.subset_adjoin K _ (Set.mem_insert _ _)))
          (IntermediateField.algebraMap_mem _ _)
      · rw [h1, hY]
        refine add_mem (add_mem (mul_mem (pow_mem (IntermediateField.algebraMap_mem _ _) 3)
          (IntermediateField.subset_adjoin K _ (Set.mem_insert_of_mem _ (Set.mem_singleton _))))
          (mul_mem (mul_mem (pow_mem (IntermediateField.algebraMap_mem _ _) 2)
            (IntermediateField.algebraMap_mem _ _))
            (IntermediateField.subset_adjoin K _ (Set.mem_insert _ _))))
          (IntermediateField.algebraMap_mem _ _)
    exact hle hz
  exact exists_algEquiv_of_normalForm d'.curve hx1 hy1 d'.poleOrd_x d'.poleOrd_y hnf d'.normalForm
    hgen1 d'.gen

end determine

end AnalyticTheory
