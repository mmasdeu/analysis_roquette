module

public import AnalyticTheory.ConstExtAbstract
public import AnalyticTheory.EzetaElliptic

/-!
# Constant field extensions of the descended fields `E_ζ`

Let `L | K` be finite Galois, `L' | K` finite, and `M` a finite Galois extension of `L'`
containing (a copy of) `L`, generated by `L'` and `L`. A cocycle `ζ` for `L | K` gives a cocycle
`ζ''` for `M | L'` by restriction, the embedding `F_L(q) ⊂ F_M(q)` is equivariant, and the constant
extension `E_ζ L'` is the descended field `E_{ζ''}`.
-/

@[expose] public section

set_option linter.unusedSectionVars false

namespace AnalyticTheory

universe u

/-- Instance shortcut: `map_add`, `map_sum`, ... for ring homs between the subfields used below
would otherwise first try (and slowly fail) the `ℚ≥0`-linear-map route. -/
private local instance (priority := high) ringHom_addMonoidHomClass {A B : Type*}
    [NonAssocSemiring A] [NonAssocSemiring B] : AddMonoidHomClass (A →+* B) A B :=
  RingHomClass.toAddMonoidHomClass

section compat

variable {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable {L : Type u} [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
  [NormedAlgebra K L] [FiniteDimensional K L] [IsGalois K L]
variable {L' : Type u} [NontriviallyNormedField L'] [IsUltrametricDist L'] [CompleteSpace L']
  [NormedAlgebra K L']
variable {M : Type u} [NontriviallyNormedField M] [IsUltrametricDist M] [CompleteSpace M]
  [NormedAlgebra L M] [FiniteDimensional L M] [NormedAlgebra L' M] [FiniteDimensional L' M]
  [IsGalois L' M]

theorem holExt_holGal_compat (σ : L ≃ₐ[K] L) (τ : M ≃ₐ[L'] M)
    (hτ : ∀ x : L, τ (algebraMap L M x) = algebraMap L M (σ x)) (g : holSubring L) :
    holExt (K := L) (L := M) (holGal σ g) = holGal τ (holExt (K := L) (L := M) g) := by
  apply holCoeff_injective M
  rw [holCoeff_holExt, holCoeff_holGal, holCoeff_holGal, holCoeff_holExt]
  funext n
  simp only [hτ]

theorem meroExt_meroGal_compat (σ : L ≃ₐ[K] L) (τ : M ≃ₐ[L'] M)
    (hτ : ∀ x : L, τ (algebraMap L M x) = algebraMap L M (σ x)) (f : MeroRing L) :
    meroExt (K := L) (L := M) (meroGal σ f) = meroGal τ (meroExt (K := L) (L := M) f) := by
  obtain ⟨x, y, -, rfl⟩ := IsFractionRing.div_surjective (A := holSubring L) f
  simp only [map_div₀, meroGal_alg, meroExt_alg, holExt_holGal_compat σ τ hτ]

end compat

section cocycle

variable {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable {L : Type u} [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
  [NormedAlgebra K L] [FiniteDimensional K L] [IsGalois K L]
variable {L' : Type u} [NontriviallyNormedField L'] [IsUltrametricDist L'] [CompleteSpace L']
  [NormedAlgebra K L']
variable {M : Type u} [NontriviallyNormedField M] [IsUltrametricDist M] [CompleteSpace M]
  [NormedAlgebra L M] [FiniteDimensional L M] [NormedAlgebra L' M] [FiniteDimensional L' M]
  [IsGalois L' M]
variable [Algebra K M] [IsScalarTower K L M] [IsScalarTower K L' M]

variable (K L L' M) in
/-- Restriction `Gal(M | L') → Gal(L | K)`. -/
noncomputable def resHom : (M ≃ₐ[L'] M) →* (L ≃ₐ[K] L) :=
  (AlgEquiv.restrictNormalHom (F := K) (K₁ := M) L).comp (AlgEquiv.restrictScalarsHom K)

theorem resHom_commutes (τ : M ≃ₐ[L'] M) (x : L) :
    algebraMap L M (resHom K L L' M τ x) = τ (algebraMap L M x) :=
  AlgEquiv.restrictNormal_commutes (τ.restrictScalars K) L x

theorem algebraMap_q_eq (q : K) :
    algebraMap L M (algebraMap K L q) = algebraMap L' M (algebraMap K L' q) := by
  rw [← IsScalarTower.algebraMap_apply K L M, ← IsScalarTower.algebraMap_apply K L' M]

/-- The cocycle of `M | L'` induced by a cocycle of `L | K` (through `res`). -/
noncomputable def cocycleExt (q : K) (ζ : CocycleModQ K L q) :
    CocycleModQ L' M (algebraMap K L' q) :=
  ⟨fun τ => Units.map (algebraMap L M : L →* M) (ζ.1 (resHom K L L' M τ)), by
    intro τ τ'
    obtain ⟨k, hk⟩ := ζ.2 (resHom K L L' M τ) (resHom K L L' M τ')
    refine ⟨k, ?_⟩
    have h1 := congrArg (algebraMap L M) hk
    rw [RingHom.map_mul, RingHom.map_mul, map_zpow₀ (algebraMap L M),
      algebraMap_q_eq (L := L) (L' := L') (M := M) q, resHom_commutes] at h1
    show algebraMap L M ((ζ.1 (resHom K L L' M (τ * τ')) : Lˣ) : L) =
      algebraMap L M ((ζ.1 (resHom K L L' M τ) : Lˣ) : L) *
        τ (algebraMap L M ((ζ.1 (resHom K L L' M τ') : Lˣ) : L)) *
          (algebraMap L' M (algebraMap K L' q)) ^ k
    rw [map_mul (resHom K L L' M)]
    exact h1⟩

theorem cocycleExt_apply (q : K) (ζ : CocycleModQ K L q) (τ : M ≃ₐ[L'] M) :
    ((cocycleExt (L' := L') (M := M) q ζ).1 τ : Mˣ) =
      Units.map (algebraMap L M : L →* M) (ζ.1 (resHom K L L' M τ)) := rfl

end cocycle

section decomp

variable {L : Type u} [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
variable {M : Type u} [NontriviallyNormedField M] [IsUltrametricDist M] [CompleteSpace M]
  [NormedAlgebra L M] [FiniteDimensional L M]
variable (q0 : L) (hq : q0 ≠ 0) (q1 : M) (h : algebraMap L M q0 = q1)

/-- The inclusion `F_L(q0) ⊂ F_M(q1)` for `q1 = q0`. -/
noncomputable def embedGen : FqSub L q0 →+* FqSub M q1 :=
  ((meroExt (K := L) (L := M)).comp (FqSub L q0).subtype).codRestrict _
    (fun f => by
      intro a ha
      have hp : (a : M) = algebraMap L M q0 := by rw [ha, h]
      have : a = Units.map (algebraMap L M : L →* M) (Units.mk0 q0 hq) := Units.ext hp
      rw [this]
      show translation M (Units.map (algebraMap L M : L →* M) (Units.mk0 q0 hq))
        (meroExt (K := L) (L := M) (f : MeroRing L)) = meroExt (K := L) (L := M) (f : MeroRing L)
      rw [← meroExt_translation]
      congr 1
      exact (mem_Fq_iff hq _).mp f.2)

theorem embedGen_coe (f : FqSub L q0) :
    ((embedGen q0 hq q1 h f : FqSub M q1) : MeroRing M) =
      meroExt (K := L) (L := M) (f : MeroRing L) :=
  rfl

theorem embedGen_const_mul (l : L) (f : FqSub L q0) :
    embedGen q0 hq q1 h (FqHom L q0 l * f) =
      FqHom M q1 (algebraMap L M l) * embedGen q0 hq q1 h f := by
  apply Subtype.ext
  show meroExt (K := L) (L := M) (algebraMap L (MeroRing L) l * (f : MeroRing L)) =
    algebraMap M (MeroRing M) (algebraMap L M l) * meroExt (K := L) (L := M) (f : MeroRing L)
  rw [map_mul, meroExt_algebraMap]

variable {ι : Type*} [Fintype ι] (b : Module.Basis ι L M)

theorem fqM_decomp (y : FqSub M q1) :
    ∃ f : ι → FqSub L q0, y = ∑ i, FqHom M q1 (b i) * embedGen q0 hq q1 h (f i) := by
  subst h
  obtain ⟨e, he⟩ := fq_decomp b hq y
  refine ⟨e, Subtype.ext ?_⟩
  rw [he, mcombo]
  have := map_sum (FqSub M (algebraMap L M q0)).subtype
    (fun i => FqHom M (algebraMap L M q0) (b i) * embedGen q0 hq (algebraMap L M q0) rfl (e i))
    Finset.univ
  exact this.symm

theorem fqM_decomp_eq_zero (f : ι → FqSub L q0)
    (hf : ∑ i, FqHom M q1 (b i) * embedGen q0 hq q1 h (f i) = 0) (i : ι) : f i = 0 := by
  subst h
  have h0 : mcombo b (fun i => (f i : MeroRing L)) = 0 := by
    have := congrArg (FqSub M _).subtype hf
    rw [map_sum] at this
    rw [mcombo]
    exact this
  exact Subtype.ext (mcombo_eq_zero b h0 i)


end decomp
end AnalyticTheory
