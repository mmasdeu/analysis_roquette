/-!
# Semi-periodic functions (book, §4 and §5)

Characters of Galois groups, `q`-trivial characters, the cohomological lemma (Lemma 2),
Theorems IX, X, XI (fields `F_K(Q)` of semi-periodic functions and their character invariants),
and §5: Theorems XII–XVI (norm theorem), the cohomology table, Brauer group corollaries.

The Galois group acts on `M_L` through the Laurent coefficients (`IsGalAct`); the fields of
semi-periodic functions are fixed fields of the maps `τ_ζ(σ) σ` inside `F_L(q)`.
Cohomology of the cyclic group `G_Q` is the Tate cohomology `Ĥ⁰ = A^s / N A`,
`Ĥ¹ = ker N / (s − 1) A` of a generator `s` (`cycH0`, `cycH1`).

Blueprint nodes: `def:q-trivial`, `lem:2`, `thm:IX`, `thm:X`, `thm:XI`, `thm:XII`, `thm:XIII`,
`thm:XIV`, `cor:XIIIa`, `cor:XIIIb`, `thm:XV`, `cor:XVa`, `thm:XVI`, `tab:cohomology`,
`cor:XVIa`, `cor:XVIb`.
-/

open Filter Topology


namespace AnalyticTheory

universe u

/-! ### Tate cohomology of a cyclic group -/

section Cyclic

variable {Amb : Type*} [AddCommGroup Amb]

/-- Book, §5: the fixed points of an automorphism `s`. -/
def cycFixed (s : AddMonoid.End Amb) : AddSubgroup Amb :=
  (s - 1 : AddMonoid.End Amb).ker

/-- The norm operator `N = ∑_{i<n} sⁱ`. -/
def cycNorm (s : AddMonoid.End Amb) (n : ℕ) : AddMonoid.End Amb :=
  ∑ i ∈ Finset.range n, s ^ i

/-- Book, §5 (cohomology of the cyclic group generated by `s` of order `n`, acting on the
subgroup `A` of `Amb`): `Ĥ⁰ = A^s / N A`. -/
def cycH0 (s : AddMonoid.End Amb) (n : ℕ) (A : AddSubgroup Amb) : Type _ :=
  ↥(A ⊓ cycFixed s) ⧸ (A.map (cycNorm s n)).addSubgroupOf (A ⊓ cycFixed s)

/-- Book, §5: `Ĥ¹ = ker N / (s − 1) A`. -/
def cycH1 (s : AddMonoid.End Amb) (n : ℕ) (A : AddSubgroup Amb) : Type _ :=
  ↥(A ⊓ (cycNorm s n).ker) ⧸
    (A.map (s - 1 : AddMonoid.End Amb)).addSubgroupOf (A ⊓ (cycNorm s n).ker)

noncomputable instance (s : AddMonoid.End Amb) (n : ℕ) (A : AddSubgroup Amb) :
    AddCommGroup (cycH0 s n A) := by unfold cycH0; infer_instance

noncomputable instance (s : AddMonoid.End Amb) (n : ℕ) (A : AddSubgroup Amb) :
    AddCommGroup (cycH1 s n A) := by unfold cycH1; infer_instance

end Cyclic

/-! ### Galois groups, characters, the invariants of §4 -/

section Galois

variable (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable (L : Type u) [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
variable [NormedAlgebra K L] [FiniteDimensional K L] [IsGalois K L]

/-- The Galois group `G` of `L | K`. -/
abbrev GalGroup := L ≃ₐ[K] L

/-- Book, §4: characters `χ : G → W` of `G` (values in the unit circle). -/
abbrev CharGroup := GalGroup K L →* Circle

/-- Book, §4: `K_χ`, the field of fixed elements of the kernel of `χ`. -/
noncomputable def Kchi (χ : CharGroup K L) : IntermediateField K L :=
  IntermediateField.fixedField (MonoidHom.ker χ)

/-- Book, §4, Definition: `χ` is *`q`-trivial* if `q` is the norm of some `Q ∈ K_χ`. -/
def IsQTrivial (q : K) (χ : CharGroup K L) : Prop :=
  ∃ Q : Kchi K L χ, Algebra.norm K Q = q

/-- The constants `K ⊂ L ⊂ M_L`. -/
noncomputable def kConst : K →+* MeroRing L := (algebraMap L (MeroRing L)).comp (algebraMap K L)

/-- Book, §4: `ρ` is the action of `σ ∈ G` on `M_L` through the coefficients of the Laurent
series: a ring automorphism of `M_L` which maps `∑ aₙ Xⁿ` to `∑ σ(aₙ) Xⁿ`. -/
def IsGalAct (σ : GalGroup K L) (ρ : MeroRing L ≃+* MeroRing L) : Prop :=
  (∀ c : L, ρ (algebraMap L (MeroRing L) c) = algebraMap L (MeroRing L) (σ c)) ∧
  ∀ (g : holSubring L) (a : ℤ → L), IsConvergentLaurent L a →
    (∀ α : OmegaX L, HasSum (fun n : ℤ => algebraMap L (Omega L) (a n) * α.1 ^ n) (g.1 α)) →
    ∃ g' : holSubring L,
      ρ (algebraMap (holSubring L) (MeroRing L) g) = algebraMap (holSubring L) (MeroRing L) g' ∧
      ∀ α : OmegaX L, HasSum (fun n : ℤ => algebraMap L (Omega L) (σ (a n)) * α.1 ^ n) (g'.1 α)

/-- The action of `σ ∈ G` on `M_L` (the unique ring automorphism with `IsGalAct`). -/
noncomputable def galActM (σ : GalGroup K L) : MeroRing L ≃+* MeroRing L :=
  haveI : Nonempty (MeroRing L ≃+* MeroRing L) := ⟨RingEquiv.refl _⟩
  Classical.epsilon (IsGalAct K L σ)

/-- Book, §4: the subfield of `F_L(q)` of elements `f` with `τ_a(ρ f) = f` for all pairs
`(σ, a) ∈ S` (`S ⊂ G × L^×`) and all realisations `ρ` of `σ` on `M_L`. -/
def semiFixed (q : L) (S : Set (GalGroup K L × Lˣ)) : Subfield (FqSub L q) where
  carrier := {f | ∀ p ∈ S, ∀ ρ : MeroRing L ≃+* MeroRing L, IsGalAct K L p.1 ρ →
    translation L p.2 (ρ (f : MeroRing L)) = (f : MeroRing L)}
  mul_mem' := fun {f g} hf hg p hp ρ hρ => by
    simp only [Subfield.coe_mul, map_mul, hf p hp ρ hρ, hg p hp ρ hρ]
  one_mem' := fun p hp ρ hρ => by simp
  add_mem' := fun {f g} hf hg p hp ρ hρ => by
    simp only [Subfield.coe_add, map_add, hf p hp ρ hρ, hg p hp ρ hρ]
  zero_mem' := fun p hp ρ hρ => by simp
  neg_mem' := fun {f} hf p hp ρ hρ => by
    simp only [Subfield.coe_neg, map_neg, hf p hp ρ hρ]
  inv_mem' := fun {f} hf p hp ρ hρ => by
    simp only [Subfield.coe_inv, map_inv₀, hf p hp ρ hρ]

/-- The constants `K → F_L(q)`. -/
noncomputable def kConstFq (q : K) : K →+* FqSub L (algebraMap K L q) :=
  (FqHom L (algebraMap K L q)).comp (algebraMap K L)

omit [IsUltrametricDist K] [CompleteSpace K] [FiniteDimensional K L] [IsGalois K L] in
/-- The constants `K` lie in `semiFixed`. -/
theorem kConstFq_mem (q : K) (S : Set (GalGroup K L × Lˣ)) (c : K) :
    kConstFq K L q c ∈ semiFixed K L (algebraMap K L q) S := by
  intro p hp ρ hρ
  have h1 : ((kConstFq K L q c : FqSub L (algebraMap K L q)) : MeroRing L) =
      algebraMap L (MeroRing L) (algebraMap K L c) := rfl
  rw [h1, hρ.1, AlgEquiv.commutes, translation_algebraMap]

/-- The `K`-algebra structure on the fixed fields. -/
noncomputable instance semiFixedAlgebra (q : K) (S : Set (GalGroup K L × Lˣ)) :
    Algebra K (semiFixed K L (algebraMap K L q) S) :=
  RingHom.toAlgebra
    { toFun := fun c => ⟨kConstFq K L q c, kConstFq_mem K L q S c⟩
      map_one' := Subtype.ext (map_one _)
      map_mul' := fun _c _d => Subtype.ext (map_mul _ _ _)
      map_zero' := Subtype.ext (map_zero _)
      map_add' := fun _c _d => Subtype.ext (map_add _ _ _) }

/-! #### Cocycles with values in `L^×/q` and the map `e_q` -/

/-- Book, §4: a 1-cocycle `G → L^×/q`, represented by a map `ζ : G → L^×` satisfying the cocycle
relation modulo `q`. -/
def IsCocycleModQ (q : K) (ζ : GalGroup K L → Lˣ) : Prop :=
  ∀ σ τ : GalGroup K L, ∃ k : ℤ,
    ((ζ (σ * τ) : Lˣ) : L) = (ζ σ : L) * σ (ζ τ : L) * (algebraMap K L q) ^ k

/-- The subtype of cocycles `G → L^×/q`. -/
def CocycleModQ (q : K) : Type u := {ζ : GalGroup K L → Lˣ // IsCocycleModQ K L q ζ}

/-- Two cocycles are cohomologous if they differ by a coboundary `σ a / a` mod `q`. -/
def CocycleEquiv (q : K) (ζ ζ' : CocycleModQ K L q) : Prop :=
  ∃ a : Lˣ, ∀ σ : GalGroup K L, ∃ k : ℤ,
    ((ζ'.1 σ : Lˣ) : L) = (ζ.1 σ : L) * (σ (a : L) / (a : L)) * (algebraMap K L q) ^ k

/-- The cohomology group `H¹(G, L^×/q)` of the Galois module `L^×/q`: cocycles modulo
coboundaries. -/
def H1Lq (q : K) : Type u := Quot (CocycleEquiv K L q)

/-- Book, §4, (50): `e_q(a) = exp(2πi log|a| / log|q|)`. -/
noncomputable def expq (q : K) (a : L) : Circle :=
  Circle.exp (2 * Real.pi * (Real.log ‖a‖ / Real.log ‖q‖))

/-- Book, §4, (51): the map `e_q : H¹(G, L^×/q) → Ĝ`, `ζ ↦ (σ ↦ e_q(ζ(σ)))`. -/
noncomputable def eQ (q : K) (c : H1Lq K L q) : CharGroup K L :=
  haveI : Nonempty (CharGroup K L) := ⟨1⟩
  Classical.epsilon fun χ : CharGroup K L =>
    ∃ ζ : CocycleModQ K L q, Quot.mk _ ζ = c ∧ ∀ σ, χ σ = expq K L q (ζ.1 σ)

/-- Book, §4: the character invariant `χ_E` of an elliptic field `E | K` of period `q` split by
`L`: a character `χ = e_q(ζ)` where `E` is `K`-isomorphic to the fixed field in `F_L(q)` of the
automorphisms `τ_{ζ(σ)} σ` (determined by `E` up to `χ ↦ χ⁻¹`, Theorem IX). -/
noncomputable def charInvariant (q : K) (E : Type u) [Field E] [Algebra K E]
    (_hE : IsEllipticOver K E) (_hsplit : SplitsOver K E L) : CharGroup K L :=
  haveI : Nonempty (CharGroup K L) := ⟨1⟩
  Classical.epsilon fun χ : CharGroup K L =>
    ∃ ζ : CocycleModQ K L q, (∀ σ, χ σ = expq K L q (ζ.1 σ)) ∧
      ∃ φ : E ≃+* semiFixed K L (algebraMap K L q) {p | p.2 = ζ.1 p.1},
        ∀ c : K, ((φ (algebraMap K E c) : semiFixed K L (algebraMap K L q) _) :
          FqSub L (algebraMap K L q)) = kConstFq K L q c

/-- Book, §4: the semi-periodic data `𝐐 = (L, σ, Q)`: a generator `σ` of the cyclic group `G`
and `Q ∈ L` with `N(Q) = q`. -/
structure SemiPeriodicTriple (q : K) where
  gen : GalGroup K L
  Q : L
  Q_ne : Q ≠ 0
  gen_generates : Subgroup.closure ({gen} : Set (GalGroup K L)) = ⊤
  norm_eq : Algebra.norm K Q = q

/-- Book, §4, (59): the automorphism `τ_Q σ` of `M_L` (translation by `Q` after `σ`). -/
noncomputable def tauQSigma (q : K) (T : SemiPeriodicTriple K L q) :
    MeroRing L ≃+* MeroRing L :=
  (galActM K L T.gen).trans (translation L (Units.mk0 T.Q T.Q_ne))

/-- Book, §4, the field `F_K(𝐐)` of `𝐐`-semi-periodic functions: the fixed field of `τ_Q σ`
in `F_L(q)`. -/
def FKQ (q : K) (T : SemiPeriodicTriple K L q) : Subfield (FqSub L (algebraMap K L q)) :=
  semiFixed K L (algebraMap K L q) {(T.gen, Units.mk0 T.Q T.Q_ne)}

/-- The `K`-algebra structure on `F_K(𝐐)`. -/
noncomputable instance FKQAlgebra (q : K) (T : SemiPeriodicTriple K L q) :
    Algebra K (FKQ K L q T) :=
  semiFixedAlgebra K L q _

/-! ### §5: properties of semi-periodic function fields -/

/-! Theorem XII (`thmXII_elliptic`) is proved in `Sec4.lean`, after the bridge `Ezeta_isElliptic`. -/

/-- Book, §5: the extension `σ'` of `σ ∈ G` to an automorphism of `Ω_L`. -/
def IsExtension (σ : GalGroup K L) (σ' : Omega L ≃+* Omega L) : Prop :=
  ∀ x : L, σ' (algebraMap L (Omega L) x) = algebraMap L (Omega L) (σ x)

/-- Book, §5: the permutation `α ↦ Q σ'(α)` of `Ω_L^×` (`Qσ` of the text). -/
noncomputable def semiPerm {q : K} (T : SemiPeriodicTriple K L q) (σ' : Omega L ≃+* Omega L) :
    Equiv.Perm (Omega L) :=
  σ'.toEquiv.trans (Equiv.mulLeft₀ (algebraMap L (Omega L) T.Q)
    ((map_ne_zero (algebraMap L (Omega L))).mpr T.Q_ne))

/-- Book, §5: `α, β ∈ Ω^×` are *`L`-conjugate mod^× Qσ*: some `L`-conjugate `γ` of `β` equals
`(Qσ)^m α` for an integer `m`. -/
def IsSemiConj {q : K} (T : SemiPeriodicTriple K L q) (α β : Omega L) : Prop :=
  ∃ σ' : Omega L ≃+* Omega L, IsExtension K L T.gen σ' ∧ ∃ (γ : Omega L) (m : ℤ),
    minpoly L γ = minpoly L β ∧ γ = ((semiPerm K L T σ') ^ m) α

/-! Theorem XIII (`thmXIII_prime_degrees`) is proved in `Sec5.lean`. -/

/-- Book, §5: the group `D_K(𝐐)` of `𝐐`-semi-periodic divisors, `τ_Q σ 𝔪 = 𝔪`. -/
def SemiPeriodicDivisors (q : K) (T : SemiPeriodicTriple K L q) : AddSubgroup (Omega L → ℤ) where
  carrier := {m | m ∈ Divisors L ∧ ∀ σ' : Omega L ≃+* Omega L, IsExtension K L T.gen σ' →
    ∀ α : Omega L, m (semiPerm K L T σ' α) = m α}
  zero_mem' := ⟨(Divisors L).zero_mem, fun σ' _ α => rfl⟩
  add_mem' := fun {m n} hm hn => ⟨(Divisors L).add_mem hm.1 hn.1, fun σ' h α => by
    simp [hm.2 σ' h α, hn.2 σ' h α]⟩
  neg_mem' := fun {m} hm => ⟨(Divisors L).neg_mem hm.1, fun σ' h α => by
    simp [hm.2 σ' h α]⟩

/-- Book, §5, Theorem XIV: the algebraic divisor group of `F_K(𝐐)` is the group `D_K(𝐐)`
(the prime divisor `𝔮_α` has multiplicity `1` at the `β` which are `L`-conjugate to `α` mod^×
`Qσ`); algebraic degree is `deg_q`. -/
def IsSemiDivIso (q : K) (T : SemiPeriodicTriple K L q)
    (e : FFDivisor K (FKQ K L q T) ≃+ SemiPeriodicDivisors K L q T) : Prop :=
  (∀ D : FFDivisor K (FKQ K L q T),
    D.deg = degQ L (algebraMap K L q) (e D : Omega L → ℤ)) ∧
  ∀ (P : PrimeDivisor K (FKQ K L q T)) (α : Omega L), α ≠ 0 →
    (∀ x : FKQ K L q T, x ∈ P.ring ↔
      0 ≤ anVal L α ((x : FqSub L (algebraMap K L q)) : MeroRing L)) →
    ∀ β : Omega L, (e (Finsupp.single P 1) : Omega L → ℤ) β =
      open Classical in if IsSemiConj K L T α β then 1 else 0

/-! Theorem XIV (`thmXIV_divisors`) is proved in `Sec5Div.lean`. -/

/-! Corollary XIIIa (`corXIIIa_index`) is proved in `Sec5.lean`. -/

/-! Corollary XIIIb (`corXIIIb_minimal`) is proved in `Sec5.lean`. -/

/-- The norm group `N L^× ⊂ K^× ⊂ L^×`. -/
noncomputable def normGroup : Subgroup Lˣ :=
  MonoidHom.range ((Units.map (algebraMap K L : K →* L)).comp
    (Units.map (Algebra.norm K : L →* K)))

/-- The norm group `N L^× ⊂ K^×`. -/
noncomputable def normGroupK : Subgroup Kˣ :=
  MonoidHom.range (Units.map (Algebra.norm K : L →* K))

/-- Book, §5, Theorem XV (Abel–Jacobi for semi-periodic functions): the Jacobi isomorphism
`Φ_q` induces `C⁰_K(𝐐) ≅ N L^×/q`, where `D_K(𝐐)` is identified with the divisor group of
`F_K(𝐐)` as in Theorem XIV. -/
theorem thmXV_abel_jacobi (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)
    (T : SemiPeriodicTriple K L q)
    (e : FFDivisor K (FKQ K L q T) ≃+ SemiPeriodicDivisors K L q T) (he : IsSemiDivIso K L q T e)
    (hqL : algebraMap K L q ≠ 0) :
    ∃ ψ : Multiplicative (FFClassGroupDegZero K (FKQ K L q T)) ≃*
        ↥((normGroup K L).map (QuotientGroup.mk' (Subgroup.zpowers (Units.mk0 _ hqL)))),
      ∀ D : FFDivisor.degZero K (FKQ K L q T),
        (ψ (Multiplicative.ofAdd (QuotientAddGroup.mk D)) : Lˣ ⧸ Subgroup.zpowers (Units.mk0 _ hqL)) =
          PhiQ L (algebraMap K L q) hqL (e (D : FFDivisor K (FKQ K L q T)) : Omega L → ℤ) := by
  sorry

/-- Book, §5, Corollary XVa: `C⁰_K(𝐐) ⊂ C⁰_K(q)`, with quotient isomorphic to `K^×/N L^×`. -/
theorem corXVa_quotient (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)
    (T : SemiPeriodicTriple K L q) :
    ∃ ι : Multiplicative (FFClassGroupDegZero K (FKQ K L q T)) →*
        Multiplicative (classGroupDegZero K q),
      Function.Injective ι ∧
        Nonempty ((Multiplicative (classGroupDegZero K q) ⧸ ι.range) ≃* (Kˣ ⧸ normGroupK K L)) := by
  sorry

/-! Theorem XVI (`thmXVI_norm`) is proved in `Sec5Norm.lean`. -/

/-- The cyclic automorphism `τ_Q σ` acting on divisors (`m ↦ m ∘ (Qσ)⁻¹`), for a chosen extension
`σ'` of `σ` to `Ω_L`. -/
noncomputable def divAct (q : K) (T : SemiPeriodicTriple K L q) :
    AddMonoid.End (Omega L → ℤ) :=
  haveI : Nonempty (Omega L ≃+* Omega L) := ⟨RingEquiv.refl _⟩
  { toFun := fun m α => m (((semiPerm K L T
      (Classical.epsilon (IsExtension K L T.gen))) ⁻¹) α)
    map_zero' := rfl
    map_add' := fun _ _ => rfl }

/-- The automorphism `σ` of `L^×/q` (written additively). -/
noncomputable def sigmaOnQuot (q : K) (hqL : algebraMap K L q ≠ 0) (σ : GalGroup K L) :
    AddMonoid.End (Additive (Lˣ ⧸ Subgroup.zpowers (Units.mk0 _ hqL))) :=
  MonoidHom.toAdditive
    (QuotientGroup.map (Subgroup.zpowers (Units.mk0 _ hqL)) (Subgroup.zpowers (Units.mk0 _ hqL))
      (Units.map ((σ : L →+* L) : L →* L)) (by
        rw [Subgroup.zpowers_le]
        refine ⟨1, ?_⟩
        ext
        simp))

/-! The cohomology table (`table_cohomology`) is proved in `Sec5Table.lean`/`Sec5Row4.lean`/`Sec5Row5.lean`
and assembled in `Sec5Final.lean`. -/

/-- Book, §5, Corollary XVIa: the natural map `Br(F_K(𝐐)) → Br(F_L(q))` is injective: a central
simple algebra over `F_K(𝐐)` which is split by `F_L(q)` is split. -/
theorem corXVIa_brauer (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)
    (T : SemiPeriodicTriple K L q)
    (A : Type u) [Ring A] [Algebra (FKQ K L q T) A] [Algebra.IsCentral (FKQ K L q T) A]
    [IsSimpleRing A] [FiniteDimensional (FKQ K L q T) A]
    (hsplit : ∃ m : ℕ, Nonempty (TensorProduct (FKQ K L q T) (FqSub L (algebraMap K L q)) A ≃ₐ[FqSub L (algebraMap K L q)]
      Matrix (Fin m) (Fin m) (FqSub L (algebraMap K L q)))) :
    ∃ m : ℕ, Nonempty (A ≃ₐ[FKQ K L q T] Matrix (Fin m) (Fin m) (FKQ K L q T)) := by
  sorry

/-- Book, §5, Corollary XVIb: a central simple algebra over `K` is split by `F_K(𝐐)` iff it is
split by `L`. -/
theorem corXVIb_splitting (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)
    (T : SemiPeriodicTriple K L q)
    (A : Type u) [Ring A] [Algebra K A] [Algebra.IsCentral K A] [IsSimpleRing A]
    [FiniteDimensional K A] :
    (∃ m : ℕ, Nonempty (TensorProduct K (FKQ K L q T) A ≃ₐ[FKQ K L q T]
        Matrix (Fin m) (Fin m) (FKQ K L q T))) ↔
      (∃ m : ℕ, Nonempty (TensorProduct K L A ≃ₐ[L] Matrix (Fin m) (Fin m) L)) := by
  sorry

end Galois

end AnalyticTheory
