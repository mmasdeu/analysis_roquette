import AnalyticTheory.Hilbert90U

/-!
# Hilbert 90 for a ring automorphism of finite order

If `σ` is an automorphism of finite order `d` of a field `F`, then `F` is a cyclic Galois extension
of the fixed field `E` of `σ`, with group generated by `σ`. Hence every `x` with
`∏_{i<d} σⁱ(x) = 1` is of the form `y / σ y`.
-/

namespace AnalyticTheory

universe u

theorem exists_h90_of_finOrder {F : Type u} [Field F] (σ : F ≃+* F) (hfin : IsOfFinOrder σ) {x : F}
    (hx : ∏ i ∈ Finset.range (orderOf σ), (σ ^ i) x = 1) :
    ∃ y : Fˣ, (y : F) / σ y = x := by
  classical
  set G : Subgroup (F ≃+* F) := Subgroup.zpowers σ with hG
  have : Finite G := finite_zpowers.mpr hfin
  have : Fintype G := Fintype.ofFinite G
  set E' := FixedPoints.subfield G F with hE'
  have : IsGalois E' F := IsGalois.of_fixed_field F G
  have : FiniteDimensional E' F := inferInstance
  let g : F ≃ₐ[E'] F := AlgEquiv.ofRingEquiv (f := σ) fun e => e.2 ⟨σ, Subgroup.mem_zpowers σ⟩
  have hgσ : ∀ (j : ℕ) (y : F), (g ^ j) y = (σ ^ j) y := by
    intro j
    induction j with
    | zero => intro y; rfl
    | succ j ih =>
      intro y
      rw [pow_succ, pow_succ]
      exact ih (g y)
  have hord : orderOf g = orderOf σ := by
    apply orderOf_eq_orderOf_iff.mpr
    intro k
    constructor
    · intro h
      ext y
      have := congrArg (fun τ : F ≃ₐ[E'] F => τ y) h
      simpa [hgσ] using this
    · intro h
      ext y
      have := congrArg (fun τ : F ≃+* F => τ y) h
      simpa [hgσ] using this
  have hcard : Nat.card (F ≃ₐ[E'] F) = orderOf σ := by
    rw [IsGalois.card_aut_eq_finrank, FixedPoints.finrank_eq_card G F, Fintype.card_eq_nat_card,
      hG, Nat.card_zpowers]
  have hg : ∀ τ, τ ∈ Subgroup.zpowers g := by
    have : Subgroup.zpowers g = ⊤ := by
      apply Subgroup.eq_top_of_card_eq
      rw [Nat.card_zpowers, hord, hcard]
    intro τ
    rw [this]; trivial
  have hnorm : Algebra.norm E' x = 1 := by
    apply (algebraMap E' F).injective
    rw [Algebra.norm_eq_prod_automorphisms, map_one, ← hx]
    have hpos : 0 < orderOf g := orderOf_pos g
    rw [← hord] at hx
    symm
    refine Finset.prod_bij (fun j _ => g ^ j) (fun j _ => Finset.mem_univ _) ?_ ?_ (fun j _ => (hgσ j x).symm)
    · intro j hj j' hj' h
      rw [← hord] at hj hj'
      exact pow_injOn_Iio_orderOf (Finset.mem_range.mp hj) (Finset.mem_range.mp hj') h
    · intro τ _
      obtain ⟨a, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg τ)
      refine ⟨(a % (orderOf g : ℤ)).toNat, ?_, ?_⟩
      · have h1 := Int.emod_lt_of_pos a (by exact_mod_cast hpos : (0 : ℤ) < orderOf g)
        have h0 := Int.emod_nonneg a (by exact_mod_cast hpos.ne' : (orderOf g : ℤ) ≠ 0)
        rw [Finset.mem_range, ← hord]; omega
      · have h1 : ((a % (orderOf g : ℤ)).toNat : ℤ) = a % (orderOf g : ℤ) :=
          Int.toNat_of_nonneg (Int.emod_nonneg a (by exact_mod_cast hpos.ne'))
        show g ^ (a % (orderOf g : ℤ)).toNat = g ^ a
        rw [← zpow_natCast, h1]
        have := Int.emod_add_mul_ediv a (orderOf g)
        conv_rhs => rw [← this]
        rw [zpow_add, zpow_mul, zpow_natCast, pow_orderOf_eq_one, one_zpow, mul_one]
  obtain ⟨y, hy⟩ := exists_h90 g hg hnorm
  exact ⟨y, hy⟩

end AnalyticTheory
