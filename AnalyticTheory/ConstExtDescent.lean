module

public import AnalyticTheory.ConstExtAbstract
public import AnalyticTheory.EzetaElliptic

/-!
# Constant field extensions of the descended fields `E_ζ`

Let `L | K` be finite Galois, `L' | K` finite, and `M` a finite Galois extension of `L'`
containing (a copy of) `L`, generated by `L'` and `L`. A cocycle `ζ` for `L | K` gives a cocycle
`ζ''` for `M | L'` by restriction, the embedding `F_L(q) ⊂ F_M(q)` is equivariant, and the constant
extension `E_ζ L'` is the descended field `E_{ζ''}`.
-/

@[expose] public section

set_option linter.unusedSectionVars false

namespace AnalyticTheory

universe u

/-- Instance shortcut: `map_add`, `map_sum`, ... for ring homs between the subfields used below
would otherwise first try (and slowly fail) the `ℚ≥0`-linear-map route. -/
private local instance (priority := high) ringHom_addMonoidHomClass {A B : Type*}
    [NonAssocSemiring A] [NonAssocSemiring B] : AddMonoidHomClass (A →+* B) A B :=
  RingHomClass.toAddMonoidHomClass

section compat

variable {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable {L : Type u} [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
  [NormedAlgebra K L] [FiniteDimensional K L] [IsGalois K L]
variable {L' : Type u} [NontriviallyNormedField L'] [IsUltrametricDist L'] [CompleteSpace L']
  [NormedAlgebra K L']
variable {M : Type u} [NontriviallyNormedField M] [IsUltrametricDist M] [CompleteSpace M]
  [NormedAlgebra L M] [FiniteDimensional L M] [NormedAlgebra L' M] [FiniteDimensional L' M]
  [IsGalois L' M]

theorem holExt_holGal_compat (σ : L ≃ₐ[K] L) (τ : M ≃ₐ[L'] M)
    (hτ : ∀ x : L, τ (algebraMap L M x) = algebraMap L M (σ x)) (g : holSubring L) :
    holExt (K := L) (L := M) (holGal σ g) = holGal τ (holExt (K := L) (L := M) g) := by
  apply holCoeff_injective M
  rw [holCoeff_holExt, holCoeff_holGal, holCoeff_holGal, holCoeff_holExt]
  funext n
  simp only [hτ]

theorem meroExt_meroGal_compat (σ : L ≃ₐ[K] L) (τ : M ≃ₐ[L'] M)
    (hτ : ∀ x : L, τ (algebraMap L M x) = algebraMap L M (σ x)) (f : MeroRing L) :
    meroExt (K := L) (L := M) (meroGal σ f) = meroGal τ (meroExt (K := L) (L := M) f) := by
  obtain ⟨x, y, -, rfl⟩ := IsFractionRing.div_surjective (A := holSubring L) f
  simp only [map_div₀, meroGal_alg, meroExt_alg, holExt_holGal_compat σ τ hτ]

end compat

section cocycle

variable {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable {L : Type u} [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
  [NormedAlgebra K L] [FiniteDimensional K L] [IsGalois K L]
variable {L' : Type u} [NontriviallyNormedField L'] [IsUltrametricDist L'] [CompleteSpace L']
  [NormedAlgebra K L']
variable {M : Type u} [NontriviallyNormedField M] [IsUltrametricDist M] [CompleteSpace M]
  [NormedAlgebra L M] [FiniteDimensional L M] [NormedAlgebra L' M] [FiniteDimensional L' M]
  [IsGalois L' M]
variable [Algebra K M] [IsScalarTower K L M] [IsScalarTower K L' M]

variable (K L L' M) in
/-- Restriction `Gal(M | L') → Gal(L | K)`. -/
noncomputable def resHom : (M ≃ₐ[L'] M) →* (L ≃ₐ[K] L) :=
  (AlgEquiv.restrictNormalHom (F := K) (K₁ := M) L).comp (AlgEquiv.restrictScalarsHom K)

theorem resHom_commutes (τ : M ≃ₐ[L'] M) (x : L) :
    algebraMap L M (resHom K L L' M τ x) = τ (algebraMap L M x) :=
  AlgEquiv.restrictNormal_commutes (τ.restrictScalars K) L x

theorem algebraMap_q_eq (q : K) :
    algebraMap L M (algebraMap K L q) = algebraMap L' M (algebraMap K L' q) := by
  rw [← IsScalarTower.algebraMap_apply K L M, ← IsScalarTower.algebraMap_apply K L' M]

/-- The cocycle of `M | L'` induced by a cocycle of `L | K` (through `res`). -/
noncomputable def cocycleExt (q : K) (ζ : CocycleModQ K L q) :
    CocycleModQ L' M (algebraMap K L' q) :=
  ⟨fun τ => Units.map (algebraMap L M : L →* M) (ζ.1 (resHom K L L' M τ)), by
    intro τ τ'
    obtain ⟨k, hk⟩ := ζ.2 (resHom K L L' M τ) (resHom K L L' M τ')
    refine ⟨k, ?_⟩
    have h1 := congrArg (algebraMap L M) hk
    rw [RingHom.map_mul, RingHom.map_mul, map_zpow₀ (algebraMap L M),
      algebraMap_q_eq (L := L) (L' := L') (M := M) q, resHom_commutes] at h1
    show algebraMap L M ((ζ.1 (resHom K L L' M (τ * τ')) : Lˣ) : L) =
      algebraMap L M ((ζ.1 (resHom K L L' M τ) : Lˣ) : L) *
        τ (algebraMap L M ((ζ.1 (resHom K L L' M τ') : Lˣ) : L)) *
          (algebraMap L' M (algebraMap K L' q)) ^ k
    rw [map_mul (resHom K L L' M)]
    exact h1⟩

theorem cocycleExt_apply (q : K) (ζ : CocycleModQ K L q) (τ : M ≃ₐ[L'] M) :
    ((cocycleExt (L' := L') (M := M) q ζ).1 τ : Mˣ) =
      Units.map (algebraMap L M : L →* M) (ζ.1 (resHom K L L' M τ)) := rfl

end cocycle

section decomp

variable {L : Type u} [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
variable {M : Type u} [NontriviallyNormedField M] [IsUltrametricDist M] [CompleteSpace M]
  [NormedAlgebra L M] [FiniteDimensional L M]
variable (q0 : L) (hq : q0 ≠ 0) (q1 : M) (h : algebraMap L M q0 = q1)

/-- The inclusion `F_L(q0) ⊂ F_M(q1)` for `q1 = q0`. -/
noncomputable def embedGen : FqSub L q0 →+* FqSub M q1 :=
  ((meroExt (K := L) (L := M)).comp (FqSub L q0).subtype).codRestrict _
    (fun f => by
      intro a ha
      have hp : (a : M) = algebraMap L M q0 := by rw [ha, h]
      have : a = Units.map (algebraMap L M : L →* M) (Units.mk0 q0 hq) := Units.ext hp
      rw [this]
      show translation M (Units.map (algebraMap L M : L →* M) (Units.mk0 q0 hq))
        (meroExt (K := L) (L := M) (f : MeroRing L)) = meroExt (K := L) (L := M) (f : MeroRing L)
      rw [← meroExt_translation]
      congr 1
      exact (mem_Fq_iff hq _).mp f.2)

theorem embedGen_coe (f : FqSub L q0) :
    ((embedGen q0 hq q1 h f : FqSub M q1) : MeroRing M) =
      meroExt (K := L) (L := M) (f : MeroRing L) :=
  rfl

theorem embedGen_const_mul (l : L) (f : FqSub L q0) :
    embedGen q0 hq q1 h (FqHom L q0 l * f) =
      FqHom M q1 (algebraMap L M l) * embedGen q0 hq q1 h f := by
  apply Subtype.ext
  show meroExt (K := L) (L := M) (algebraMap L (MeroRing L) l * (f : MeroRing L)) =
    algebraMap M (MeroRing M) (algebraMap L M l) * meroExt (K := L) (L := M) (f : MeroRing L)
  rw [map_mul, meroExt_algebraMap]

variable {ι : Type*} [Fintype ι] (b : Module.Basis ι L M)

theorem fqM_decomp (y : FqSub M q1) :
    ∃ f : ι → FqSub L q0, y = ∑ i, FqHom M q1 (b i) * embedGen q0 hq q1 h (f i) := by
  subst h
  obtain ⟨e, he⟩ := fq_decomp b hq y
  refine ⟨e, Subtype.ext ?_⟩
  rw [he, mcombo]
  have := map_sum (FqSub M (algebraMap L M q0)).subtype
    (fun i => FqHom M (algebraMap L M q0) (b i) * embedGen q0 hq (algebraMap L M q0) rfl (e i))
    Finset.univ
  exact this.symm

theorem fqM_decomp_eq_zero (f : ι → FqSub L q0)
    (hf : ∑ i, FqHom M q1 (b i) * embedGen q0 hq q1 h (f i) = 0) (i : ι) : f i = 0 := by
  subst h
  have h0 : mcombo b (fun i => (f i : MeroRing L)) = 0 := by
    have := congrArg (FqSub M _).subtype hf
    rw [map_sum] at this
    rw [mcombo]
    exact this
  exact Subtype.ext (mcombo_eq_zero b h0 i)

theorem linearCombination_embed {J : Type*} (w : J → FqSub L q0) (c : J →₀ M) :
    Finsupp.linearCombination M (fun j => embedGen q0 hq q1 h (w j)) c =
      ∑ i, FqHom M q1 (b i) * embedGen q0 hq q1 h
        (Finsupp.linearCombination L w (Finsupp.mapRange (fun m => b.repr m i)
          (by rw [LinearEquiv.map_zero, Finsupp.coe_zero, Pi.zero_apply]) c)) := by
  classical
  simp only [Finsupp.linearCombination_apply]
  simp_rw [Finsupp.sum_mapRange_index (h := fun (i : J) (a : L) => a • w i)
    (fun _ => zero_smul _ _)]
  simp only [Finsupp.sum, map_sum, Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => ?_
  conv_lhs => rw [← b.sum_repr (c j)]
  rw [Finset.sum_smul]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Algebra.smul_def (b.repr (c j) i) (w j)]
  have e1 := embedGen_const_mul q0 hq q1 h (b.repr (c j) i) (w j)
  have e2 : ((b.repr (c j) i • b i) • embedGen q0 hq q1 h (w j) : FqSub M q1) =
      FqHom M q1 (algebraMap L M (b.repr (c j) i)) * FqHom M q1 (b i) *
        embedGen q0 hq q1 h (w j) := by
    rw [Algebra.smul_def (b.repr (c j) i) (b i), Algebra.smul_def, map_mul]
    rfl
  rw [e2]
  change _ = _ * embedGen q0 hq q1 h (FqHom L q0 _ * w j)
  rw [e1]
  ring

theorem embedGen_linearIndependent {J : Type*} (w : J → FqSub L q0) (hw : LinearIndependent L w) :
    LinearIndependent M (fun j => embedGen q0 hq q1 h (w j)) := by
  classical
  rw [linearIndependent_iff]
  intro c hc
  rw [linearCombination_embed q0 hq q1 h (Module.finBasis L M)] at hc
  have h1 := fqM_decomp_eq_zero q0 hq q1 h (Module.finBasis L M) _ hc
  ext j
  apply (Module.finBasis L M).repr.injective
  ext i
  have h2 := (linearIndependent_iff.mp hw) _ (h1 i)
  have := congrArg (fun d => d j) h2
  simpa using this

theorem embedGen_mem_span (T : Set (FqSub L q0)) {f : FqSub L q0} (hf : f ∈ Submodule.span L T) :
    embedGen q0 hq q1 h f ∈ Submodule.span M (embedGen q0 hq q1 h '' T) := by
  induction hf using Submodule.span_induction with
  | mem x hx => exact Submodule.subset_span ⟨x, hx, rfl⟩
  | zero => rw [RingHom.map_zero]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [RingHom.map_add]; exact Submodule.add_mem _ hx hy
  | smul c x _ hx =>
    have : embedGen q0 hq q1 h (c • x) = algebraMap L M c • embedGen q0 hq q1 h x := by
      rw [Algebra.smul_def c x]
      change embedGen q0 hq q1 h (FqHom L q0 c * x) = _
      rw [embedGen_const_mul, Algebra.smul_def]
      rfl
    rw [this]
    exact Submodule.smul_mem _ _ hx

theorem fqM_mem_span (T : Set (FqSub L q0)) (hT : ∀ f, f ∈ Submodule.span L T) (y : FqSub M q1) :
    y ∈ Submodule.span M (embedGen q0 hq q1 h '' T) := by
  obtain ⟨f, rfl⟩ := fqM_decomp q0 hq q1 h (Module.finBasis L M) y
  refine Submodule.sum_mem _ fun i _ => ?_
  have := Submodule.smul_mem (Submodule.span M (embedGen q0 hq q1 h '' T)) (Module.finBasis L M i)
    (embedGen_mem_span q0 hq q1 h T (hT (f i)))
  rwa [Algebra.smul_def] at this

end decomp

section embed

variable {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable {L : Type u} [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
  [NormedAlgebra K L] [FiniteDimensional K L] [IsGalois K L]
variable {L' : Type u} [NontriviallyNormedField L'] [IsUltrametricDist L'] [CompleteSpace L']
  [NormedAlgebra K L']
variable {M : Type u} [NontriviallyNormedField M] [IsUltrametricDist M] [CompleteSpace M]
  [NormedAlgebra L M] [FiniteDimensional L M] [NormedAlgebra L' M] [FiniteDimensional L' M]
  [IsGalois L' M]
variable [Algebra K M] [IsScalarTower K L M] [IsScalarTower K L' M]
variable (q : K) (hq0 : 0 < ‖q‖)

/-- The inclusion `F_L(q) ⊂ F_M(q)` (coefficients extended along `L ⊂ M`). -/
noncomputable def embedFq : FqSub L (algebraMap K L q) →+*
    FqSub M (algebraMap L' M (algebraMap K L' q)) :=
  embedGen (algebraMap K L q)
    ((map_ne_zero_iff _ (algebraMap K L).injective).mpr (norm_pos_iff.mp hq0))
    (algebraMap L' M (algebraMap K L' q)) (algebraMap_q_eq (L := L) (L' := L') (M := M) q)

theorem embedFq_coe (f : FqSub L (algebraMap K L q)) :
    ((embedFq (L := L) (L' := L') (M := M) q hq0 f : FqSub M (algebraMap L' M (algebraMap K L' q))) :
      MeroRing M) = meroExt (K := L) (L := M) (f : MeroRing L) := rfl

theorem embedFq_injective : Function.Injective (embedFq (L := L) (L' := L') (M := M) q hq0) := by
  intro a b h
  apply Subtype.ext
  exact (meroExt (K := L) (L := M)).injective (congrArg Subtype.val h)

/-- `ρ''_τ ∘ ι = ι ∘ ρ_{res τ}`: the embedding is equivariant for the twisted actions. -/
theorem embedFq_equivariant (ζ : CocycleModQ K L q) (τ : M ≃ₐ[L'] M)
    (f : FqSub L (algebraMap K L q)) :
    rhoZ (algebraMap K L' q) (cocycleExt (L' := L') (M := M) q ζ) τ (embedFq (L := L) (L' := L') (M := M) q hq0 f) =
      embedFq (L := L) (L' := L') (M := M) q hq0 (rhoZ q ζ (resHom K L L' M τ) f) := by
  apply Subtype.ext
  show translation M ((cocycleExt (L' := L') (M := M) q ζ).1 τ) (meroGal τ (meroExt (f : MeroRing L))) =
    meroExt (translation L (ζ.1 (resHom K L L' M τ)) (meroGal (resHom K L L' M τ) (f : MeroRing L)))
  rw [meroExt_translation (K := L) (L := M), ← meroExt_meroGal_compat (K := K) (L := L) (L' := L') (M := M) (resHom K L L' M τ) τ
    (fun x => (resHom_commutes (K := K) (L := L) (L' := L') τ x).symm)]
  rfl

end embed


section ezetaBasis

variable {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable {L : Type u} [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
  [NormedAlgebra K L] [FiniteDimensional K L] [IsGalois K L]
variable (q : K) (hq0 : 0 < ‖q‖) (ζ : CocycleModQ K L q)

attribute [local instance] fqKAlgebra

/-- The family `E_ζ ⊂ F_L(q)` indexed by a `K`-basis of `E_ζ`. -/
noncomputable def EBasisFam (j : Module.Free.ChooseBasisIndex K (Ezeta q ζ)) :
    FqSub L (algebraMap K L q) := (Module.Free.chooseBasis K (Ezeta q ζ) j : Ezeta q ζ)

include hq0 in
theorem Ezeta_L_indep : LinearIndependent L (EBasisFam q ζ) := by
  let := twistAction q hq0 ζ
  have : IsScalarTower K L (FqSub L (algebraMap K L q)) := fqK_tower_L (L := L) q
  have : IsScalarTower K (Ezeta q ζ) (FqSub L (algebraMap K L q)) := fqK_tower_E q ζ
  have hc : IsSemilinear K L (FqSub L (algebraMap K L q)) := fun σ l => rhoZ_const q ζ σ l
  refine linearIndependent_of_fixed hc _ (fun j g => ?_) ?_
  · exact (mem_semiFixed_iff q ζ _).mp (Module.Free.chooseBasis K (Ezeta q ζ) j).2 g
  · have := (Module.Free.chooseBasis K (Ezeta q ζ)).linearIndependent.map'
      (IsScalarTower.toAlgHom K (Ezeta q ζ) (FqSub L (algebraMap K L q))).toLinearMap
      (LinearMap.ker_eq_bot.mpr (Subfield.subtype (Ezeta q ζ)).injective)
    exact this

include hq0 in
theorem Ezeta_L_span (f : FqSub L (algebraMap K L q)) :
    f ∈ Submodule.span L (Set.range (EBasisFam q ζ)) := by
  let := twistAction q hq0 ζ
  have : IsScalarTower K L (FqSub L (algebraMap K L q)) := fqK_tower_L (L := L) q
  have : IsScalarTower K (Ezeta q ζ) (FqSub L (algebraMap K L q)) := fqK_tower_E q ζ
  have hc : IsSemilinear K L (FqSub L (algebraMap K L q)) := fun σ l => rhoZ_const q ζ σ l
  have h1 := mem_span_fixedIn hc ⊤ (fun _ _ _ => trivial) (Submodule.mem_top (x := f))
  refine (Submodule.span_le.mpr ?_) h1
  intro x hx
  have hfix : ∀ g : L ≃ₐ[K] L, g • x = x := hx.2
  have hxE : x ∈ Ezeta q ζ := (mem_semiFixed_iff q ζ x).mpr hfix
  set B := Module.Free.chooseBasis K (Ezeta q ζ)
  have h2 : (⟨x, hxE⟩ : Ezeta q ζ) ∈ Submodule.span K (Set.range B) := by rw [B.span_eq]; trivial
  have h3 := Submodule.apply_mem_span_image_of_mem_span
    (IsScalarTower.toAlgHom K (Ezeta q ζ) (FqSub L (algebraMap K L q))).toLinearMap h2
  have h4 : x ∈ Submodule.span K (Set.range (EBasisFam q ζ)) := by
    have e : (IsScalarTower.toAlgHom K (Ezeta q ζ) (FqSub L (algebraMap K L q))).toLinearMap ''
        Set.range B = Set.range (EBasisFam q ζ) := by
      rw [← Set.range_comp]; rfl
    rw [← e]
    exact h3
  exact Submodule.span_subset_span K L _ h4

end ezetaBasis

section main

variable {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable {L : Type u} [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
  [NormedAlgebra K L] [FiniteDimensional K L] [IsGalois K L]
variable {L' : Type u} [NontriviallyNormedField L'] [IsUltrametricDist L'] [CompleteSpace L']
  [NormedAlgebra K L']
variable {M : Type u} [NontriviallyNormedField M] [IsUltrametricDist M] [CompleteSpace M]
  [NormedAlgebra L M] [FiniteDimensional L M] [NormedAlgebra L' M] [FiniteDimensional L' M]
  [IsGalois L' M]
variable [Algebra K M] [IsScalarTower K L M] [IsScalarTower K L' M]
variable (q : K) (hq0 : 0 < ‖q‖) (ζ : CocycleModQ K L q)

attribute [local instance] fqKAlgebra

include hq0 in
theorem embedFq_mem_Ezeta (e : Ezeta q ζ) :
    embedFq (L := L) (L' := L') (M := M) q hq0 (e : FqSub L (algebraMap K L q)) ∈
      Ezeta (algebraMap K L' q) (cocycleExt (L' := L') (M := M) q ζ) := by
  rw [mem_semiFixed_iff]
  intro τ
  rw [embedFq_equivariant (L := L) (L' := L') (M := M) q hq0 ζ τ]
  rw [(mem_semiFixed_iff q ζ _).mp e.2 (resHom K L L' M τ)]

/-- The embedding `E_ζ → E_{ζ''}`. -/
noncomputable def EzetaEmbed : Ezeta q ζ →+* Ezeta (algebraMap K L' q) (cocycleExt (L' := L') (M := M) q ζ) where
  toFun e := ⟨embedFq (L := L) (L' := L') (M := M) q hq0 (e : FqSub L (algebraMap K L q)),
    embedFq_mem_Ezeta q hq0 ζ e⟩
  map_one' := Subtype.ext (embedFq (L' := L') (M := M) q hq0).map_one
  map_mul' _ _ := Subtype.ext ((embedFq (L' := L') (M := M) q hq0).map_mul _ _)
  map_zero' := Subtype.ext (embedFq (L' := L') (M := M) q hq0).map_zero
  map_add' _ _ := Subtype.ext ((embedFq (L' := L') (M := M) q hq0).map_add _ _)

include hq0 in
theorem Ezeta_constExt_equiv (FL : Type u) [Field FL] [Algebra (Ezeta q ζ) FL] [Algebra L' FL]
    [Algebra K FL] [IsScalarTower K (Ezeta q ζ) FL] [IsScalarTower K L' FL]
    (hgen : Subfield.closure
      (Set.range (algebraMap (Ezeta q ζ) FL) ∪ Set.range (algebraMap L' FL)) = ⊤) :
    Nonempty (FL ≃ₐ[L'] Ezeta (algebraMap K L' q) (cocycleExt (L' := L') (M := M) q ζ)) := by
  set D := Ezeta (algebraMap K L' q) (cocycleExt (L' := L') (M := M) q ζ) with hD
  let _ : Algebra K D := ((algebraMap L' D).comp (algebraMap K L')).toAlgebra
  have hKD : IsScalarTower K L' D := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let ι : Ezeta q ζ →ₐ[K] D :=
    { EzetaEmbed (L' := L') (M := M) q hq0 ζ with
      commutes' := fun c => by
        apply Subtype.ext
        apply Subtype.ext
        show meroExt (K := L) (L := M) (algebraMap L (MeroRing L) (algebraMap K L c)) =
          algebraMap M (MeroRing M) (algebraMap L' M (algebraMap K L' c))
        rw [meroExt_algebraMap, ← IsScalarTower.algebraMap_apply K L M,
          ← IsScalarTower.algebraMap_apply K L' M] }
  have hq0'' : 0 < ‖algebraMap K L' q‖ := by
    rw [norm_algebraMap']; exact hq0
  have hqne : algebraMap K L q ≠ 0 :=
    (map_ne_zero_iff _ (algebraMap K L).injective).mpr (norm_pos_iff.mp hq0)
  have hL := Ezeta_L_indep q hq0 ζ
  have hTL : IsScalarTower L' M (FqSub M (algebraMap L' M (algebraMap K L' q))) :=
    fqK_tower_L (K := L') (L := M) (algebraMap K L' q)
  have hM : LinearIndependent M (fun j => embedFq (L := L) (L' := L') (M := M) q hq0
      (EBasisFam q ζ j)) :=
    embedGen_linearIndependent _ hqne _ _ _ hL
  have hL' : LinearIndependent L' (fun j => embedFq (L := L) (L' := L') (M := M) q hq0
      (EBasisFam q ζ j)) := hM.restrict_scalars' L'
  have hTower : IsScalarTower L' D (FqSub M (algebraMap L' M (algebraMap K L' q))) :=
    fqK_tower_E (algebraMap K L' q) (cocycleExt (L' := L') (M := M) q ζ)
  let f : D →ₗ[L'] FqSub M (algebraMap L' M (algebraMap K L' q)) :=
    (IsScalarTower.toAlgHom L' D (FqSub M (algebraMap L' M (algebraMap K L' q)))).toLinearMap
  have hf : Function.Injective f := (Subfield.subtype D).injective
  refine (exists_algEquiv_of_basis ι ?_ ?_ hgen).map (fun x => x)
  · intro x
    let _ := twistAction (algebraMap K L' q) hq0'' (cocycleExt (L' := L') (M := M) q ζ)
    have hsemi : ∀ (g : M ≃ₐ[L'] M) (m : M)
        (y : FqSub M (algebraMap L' M (algebraMap K L' q))), g • (m • y) = g m • g • y := by
      intro g m y
      show rhoZ (algebraMap K L' q) (cocycleExt (L' := L') (M := M) q ζ) g (m • y) =
        g m • rhoZ (algebraMap K L' q) (cocycleExt (L' := L') (M := M) q ζ) g y
      have e : ∀ (m : M) (y : FqSub M (algebraMap L' M (algebraMap K L' q))),
          m • y = FqHom M _ m * y := fun m y => rfl
      rw [e, e, map_mul]
      congr 1
      exact rhoZ_const (algebraMap K L' q) _ g m
    have hfix : ∀ (g : M ≃ₐ[L'] M) j, g • embedFq (L := L) (L' := L') (M := M) q hq0
        (EBasisFam q ζ j) = embedFq (L := L) (L' := L') (M := M) q hq0 (EBasisFam q ζ j) :=
      fun g j => (mem_semiFixed_iff (algebraMap K L' q) _ _).mp
        (EzetaEmbed (L' := L') (M := M) q hq0 ζ
          (Module.Free.chooseBasis K (Ezeta q ζ) j)).2 g
    have hspanM : ∀ y : FqSub M (algebraMap L' M (algebraMap K L' q)),
        y ∈ Submodule.span M (Set.range fun j => embedFq (L := L) (L' := L') (M := M) q hq0
          (EBasisFam q ζ j)) := fun y => by
      have := fqM_mem_span _ hqne _ (algebraMap_q_eq (L := L) (L' := L') (M := M) q)
        (Set.range (EBasisFam q ζ)) (Ezeta_L_span q hq0 ζ) y
      rwa [← Set.range_comp] at this
    have hx := mem_span_of_fixed (L' := L') (M := M) _ hM hfix hsemi (f x) (hspanM _)
      (fun g => (mem_semiFixed_iff (algebraMap K L' q) _ _).mp x.2 g)
    have h5 : f x ∈ (Submodule.span L' (Set.range fun j => ι (Module.Free.chooseBasis K (Ezeta q ζ) j))).map f := by
      rw [Submodule.map_span, ← Set.range_comp]; exact hx
    obtain ⟨y, hy, hyx⟩ := h5
    rw [← hf hyx]
    exact Submodule.span_mono (Set.range_comp_subset_range _ _) hy
  · refine LinearIndependent.of_comp f ?_
    exact hL'

end main

section conservative

variable {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable {L : Type u} [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
  [NormedAlgebra K L] [FiniteDimensional K L] [IsGalois K L]
variable (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) (ζ : CocycleModQ K L q)

attribute [local instance] fqKAlgebra

include hq0 hq1 in
/-- **Conservativity of `E_ζ`**: under every finite constant field extension `L'`, `E_ζ L'` is the
descended field `E_{ζ''}` of `F_M(q)` for a finite Galois `M | L'` containing `L`, hence of
genus one. -/
theorem Ezeta_conservative : IsConservative K (Ezeta q ζ) := by
  intro L' _ _ hL' FL _ _ _ _ _ _ hFL
  have hgenus := Ezeta_genus q hq0 hq1 ζ
  have : Algebra.IsAlgebraic K L' := Algebra.IsAlgebraic.of_finite K L'
  -- the norm of `L'`
  let : NontriviallyNormedField L' := spectralNorm.nontriviallyNormedField K L'
  let : NormedAlgebra K L' := spectralNorm.normedAlgebra K L'
  have : IsUltrametricDist L' :=
    IsUltrametricDist.isUltrametricDist_of_isNonarchimedean_norm
      (isNonarchimedean_spectralNorm (K := K) (L := L'))
  have : CompleteSpace L' := FiniteDimensional.complete K L'
  -- the field `M`
  obtain ⟨g, hgsep, hgsplit⟩ := IsGalois.is_separable_splitting_field K L
  let g' : Polynomial L' := g.map (algebraMap K L')
  let M := g'.SplittingField
  have hGal : IsGalois L' M := IsGalois.of_separable_splitting_field (p := g') (hgsep.map)
  have hfinM : FiniteDimensional L' M := Polynomial.IsSplittingField.finiteDimensional M g'
  have hKL'M : IsScalarTower K L' M := inferInstance
  have hsplitM : Polynomial.Splits (g.map (algebraMap K M)) := by
    have := Polynomial.SplittingField.splits g'
    change Polynomial.Splits ((g.map (algebraMap K L')).map (algebraMap L' M)) at this
    rwa [Polynomial.map_map, ← IsScalarTower.algebraMap_eq] at this
  let σ : L →ₐ[K] M := Polynomial.IsSplittingField.lift L g hsplitM
  let _ : Algebra L M := σ.toRingHom.toAlgebra
  have hKLM : IsScalarTower K L M := IsScalarTower.of_algebraMap_eq fun c => (σ.commutes c).symm
  have hfinKM : FiniteDimensional K M := Module.Finite.trans L' M
  have : Algebra.IsAlgebraic K M := Algebra.IsAlgebraic.of_finite K M
  let : NontriviallyNormedField M := spectralNorm.nontriviallyNormedField K M
  let : NormedAlgebra K M := spectralNorm.normedAlgebra K M
  have : IsUltrametricDist M :=
    IsUltrametricDist.isUltrametricDist_of_isNonarchimedean_norm
      (isNonarchimedean_spectralNorm (K := K) (L := M))
  have : CompleteSpace M := FiniteDimensional.complete K M
  let : NormedAlgebra L M := spectralNorm.normedAlgebra' (K := K) L M
  let : NormedAlgebra L' M := spectralNorm.normedAlgebra' (K := K) L' M
  have : FiniteDimensional L M := Module.Finite.of_restrictScalars_finite K L M
  obtain ⟨e⟩ := Ezeta_constExt_equiv (L' := L') (M := M) q hq0 ζ FL hFL.generated
  rw [genus_eq_of_algEquiv e]
  have hq0'' : 0 < ‖algebraMap K L' q‖ := by rw [norm_algebraMap']; exact hq0
  have hq1'' : ‖algebraMap K L' q‖ < 1 := by rw [norm_algebraMap']; exact hq1
  rw [Ezeta_genus (algebraMap K L' q) hq0'' hq1'' (cocycleExt (L' := L') (M := M) q ζ), hgenus]

end conservative

end AnalyticTheory
