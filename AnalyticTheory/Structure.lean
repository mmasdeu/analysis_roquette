import AnalyticTheory.Normalize

/-!
# Structure of `F_K(q)` (book, §2: items I–V, Corollaries Va, Vb)

The Artin–Whaples description of `F_K(q)` as an elliptic function field, the
identification of the prime divisors with the classes of `Ω^×` mod `^× q`, and the
Abel–Jacobi isomorphism `C⁰_K(q) ≅ K^×/q`.

Blueprint nodes: `thm:fq-function-field` (I), `thm:fq-valuations` (II),
`thm:fq-residue` (III), `thm:fq-elliptic` (IV), `thm:abel-jacobi-iso` (V),
`cor:translation-Va`, `cor:translation-Vb`.
-/

open Filter Topology

namespace AnalyticTheory

universe u

variable (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]

/-- Book, §2: the principal divisors `P_K(q)`: the group generated by the divisors `(f)`
of non-zero `q`-periodic functions `f ∈ F_K(q)` (it consists of exactly these, as
`divisorOf` is additive). Blueprint: `def:principal-divisors`. -/
noncomputable def principalDivisors (q : K) : AddSubgroup (Omega K → ℤ) :=
  AddSubgroup.closure {m | ∃ f : MeroRing K, f ∈ Fq K q ∧ f ≠ 0 ∧ divisorOf K f = m}

/-- Book, §2: the divisors of degree `0` in `D_K(q)`: the group generated by the `q`-periodic
divisors `m` with `deg_q(m) = 0` (it consists of exactly these, as `deg_q` is additive on
`D_K(q)`). Blueprint: `def:D0q`. -/
noncomputable def divisorsDegZero (q : K) : AddSubgroup (Omega K → ℤ) :=
  AddSubgroup.closure {m | m ∈ DivisorsPeriodic K q ∧ degQ K q m = 0}

/-- The group `P_K(q)` consists of the divisors `(f)` of non-zero `q`-periodic functions.
Blueprint: `def:principal-divisors`. -/
theorem mem_principalDivisors_iff (q : K) (m : Omega K → ℤ) :
    m ∈ principalDivisors K q ↔ ∃ f : MeroRing K, f ∈ Fq K q ∧ f ≠ 0 ∧ divisorOf K f = m := by
  constructor
  · intro h
    unfold principalDivisors at h
    induction h using AddSubgroup.closure_induction with
    | mem x hx => exact hx
    | zero => exact ⟨1, (FqSub K q).one_mem, one_ne_zero, divisorOf_one K⟩
    | add x y _ _ hx hy =>
      obtain ⟨f, hf, hf0, rfl⟩ := hx
      obtain ⟨g, hg, hg0, rfl⟩ := hy
      exact ⟨f * g, (FqSub K q).mul_mem hf hg, mul_ne_zero hf0 hg0, divisorOf_mul K hf0 hg0⟩
    | neg x _ hx =>
      obtain ⟨f, hf, hf0, rfl⟩ := hx
      refine ⟨f⁻¹, (FqSub K q).inv_mem hf, inv_ne_zero hf0, ?_⟩
      have := divisorOf_mul K hf0 (inv_ne_zero hf0)
      rw [mul_inv_cancel₀ hf0, divisorOf_one] at this
      funext α
      have := congrFun this α
      simp at this ⊢
      omega
  · rintro ⟨f, hf, hf0, rfl⟩
    exact AddSubgroup.subset_closure ⟨f, hf, hf0, rfl⟩

/-- Principal divisors are divisors. Blueprint: `def:principal-divisors`. -/
theorem principalDivisors_le (q : K) : principalDivisors K q ≤ Divisors K := by
  unfold principalDivisors
  rw [AddSubgroup.closure_le]
  rintro m ⟨f, -, -, rfl⟩
  exact divisorOf_mem_Divisors K f

/-- The group `D⁰_K(q)` consists of the `q`-periodic divisors of degree `0`.
Blueprint: `def:D0q`. -/
theorem mem_divisorsDegZero_iff (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) (m : Omega K → ℤ) :
    m ∈ divisorsDegZero K q ↔ m ∈ DivisorsPeriodic K q ∧ degQ K q m = 0 := by
  constructor
  · intro h
    unfold divisorsDegZero at h
    induction h using AddSubgroup.closure_induction with
    | mem x hx => exact hx
    | zero => exact ⟨(DivisorsPeriodic K q).zero_mem, by simp [degQ]⟩
    | add x y _ _ hx hy =>
      refine ⟨(DivisorsPeriodic K q).add_mem hx.1 hy.1, ?_⟩
      rw [degQ_add K q hq0 hq1 x y hx.1 hy.1, hx.2, hy.2]; rfl
    | neg x _ hx =>
      refine ⟨(DivisorsPeriodic K q).neg_mem hx.1, ?_⟩
      have := degQ_add K q hq0 hq1 x (-x) hx.1 ((DivisorsPeriodic K q).neg_mem hx.1)
      rw [add_neg_cancel, hx.2] at this
      have h0 : degQ K q 0 = 0 := by simp [degQ]
      omega
  · exact fun h => AddSubgroup.subset_closure h

/-- Book, §2: the group `C⁰_K(q) = D⁰_K(q) / P_K(q)` of divisor classes of degree `0`.
Blueprint: `def:C0q`. -/
noncomputable abbrev classGroupDegZero (q : K) : Type u :=
  divisorsDegZero K q ⧸ (principalDivisors K q).addSubgroupOf (divisorsDegZero K q)

/-- Book, §2, item I: `F_K(q)` is a function field over `K`. Blueprint: `thm:fq-function-field`. -/
theorem fq_is_function_field (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) :
    IsFunctionFieldOver K (FqSub K q) := by
  sorry

/-- Book, §2, item II (first part): `w_α = w_β` on `F_K(q)` iff `α` and `β` are
`K`-conjugate mod `^× q`. Blueprint: `thm:fq-valuations`. -/
theorem fq_valuation_eq_iff (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)
    (α β : Omega K) (hα : α ≠ 0) (hβ : β ≠ 0) :
    (∀ f ∈ Fq K q, anVal K α f = anVal K β f) ↔ ConjModQ K q α β := by
  sorry

/-- Book, §2, item II (value group): the value group of `w_α` on `F_K(q)` is `ℤ`, in
the sense that some `f ∈ F_K(q)` has `w_α(f) = 1`. Blueprint: `thm:fq-valuations`. -/
theorem fq_valuation_surjective (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)
    (α : Omega K) (hα : α ≠ 0) :
    ∃ f ∈ Fq K q, anVal K α f = 1 := by
  sorry

/-- Book, §2, item I–II: every valuation of `F_K(q)` over `K` is equivalent to some `w_α`.
Here equivalence is expressed by having the same valuation ring. Blueprint: `thm:fq-valuations`. -/
theorem fq_valuations_classified (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)
    (v : AddValuation (FqSub K q) (WithTop ℤ))
    (hv : ∀ c : K, v (algebraMap K (FqSub K q) c) = 0) :
    ∃ α : Omega K, α ≠ 0 ∧
      ∀ x : FqSub K q, v x = 0 ↔ anVal K α (x : MeroRing K) = 0 := by
  sorry

/-- Book, §2, item III: the valuation ring `{x ∈ F_K(q) | w_α(x) ≥ 0}` of `w_α` is the ring of a
prime divisor of `F_K(q) | K` whose degree (the degree of its residue field over `K`) is `[K(α):K]`.
Blueprint: `thm:fq-residue`. -/
theorem fq_residue_degree (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) (α : Omega K) (hα : α ≠ 0) :
    ∃ P : PrimeDivisor K (FqSub K q),
      (∀ x : FqSub K q, x ∈ P.ring ↔ 0 ≤ anVal K α (x : MeroRing K)) ∧
      P.degree = Module.finrank K (IntermediateField.adjoin K ({α} : Set (Omega K))) := by
  sorry

/-- Book, §2, item IV: `F_K(q)` is an elliptic function field over `K` (with the
constant field extensions `F_K(q) L = F_L(q)`). Blueprint: `thm:fq-elliptic`. -/
theorem fq_is_elliptic (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) :
    IsEllipticOver K (FqSub K q) := by
  sorry

/-- Book, §2, item V (Abel–Jacobi isomorphism): the Jacobi map induces a group isomorphism
`C⁰_K(q) ≅ K^×/q`. Blueprint: `thm:abel-jacobi-iso`. -/
theorem abel_jacobi_iso (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) :
    ∃ e : Multiplicative (classGroupDegZero K q) ≃*
        (Kˣ ⧸ Subgroup.zpowers (Units.mk0 q (norm_pos_iff.mp hq0))),
      ∀ m : divisorsDegZero K q,
        e (Multiplicative.ofAdd (QuotientAddGroup.mk m)) =
          PhiQ K q (norm_pos_iff.mp hq0) (m : Omega K → ℤ) := by
  sorry

/-- Book, §2, Corollary Va: for `a ∈ K^×` there is a unique class `c_a ∈ C⁰_K(q)` with
`Φ_q(c_a) = a mod^× q`; the translation `τ_a` acts on prime divisors of degree `1` by
`p ↦ p + c_a`. Blueprint: `cor:translation-Va`. -/
theorem translation_class_unique (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) (a : Kˣ) :
    ∃! c : Multiplicative (classGroupDegZero K q),
      ∃ m : divisorsDegZero K q,
        c = Multiplicative.ofAdd (QuotientAddGroup.mk m) ∧
        PhiQ K q (norm_pos_iff.mp hq0) (m : Omega K → ℤ) = QuotientGroup.mk a := by
  sorry

/-- The divisor `[α]` of the point `α ∈ Ω^×`: `1` on the `K`-conjugates of `α` mod `^× q`
and `0` elsewhere. Blueprint: `def:translation-class`. -/
noncomputable def pointDivisor (q : K) (α : Omega K) : Omega K → ℤ :=
  open Classical in fun x => if ConjModQ K q α x then 1 else 0

/-- Book, §2: the algebraic translation automorphism of `F_K(q)` attached to a divisor class
`c ∈ C⁰_K(q)`: the `K`-automorphism `τ` moving the prime divisor of a point `α ∈ K^×` to that of
`β ∈ K^×` whenever `c = [β] − [α]`, i.e. `w_β(τ f) = w_α(f)`.
Blueprint: `def:translation-class`. -/
noncomputable def translationOfClass (q : K) (c : classGroupDegZero K q) :
    FqSub K q ≃+* FqSub K q :=
  haveI : Nonempty (FqSub K q ≃+* FqSub K q) := ⟨RingEquiv.refl _⟩
  Classical.epsilon fun τ : FqSub K q ≃+* FqSub K q =>
    (∀ x : K, τ (algebraMap K (FqSub K q) x) = algebraMap K (FqSub K q) x) ∧
    ∀ α β : Kˣ, (∃ m : divisorsDegZero K q,
        (QuotientAddGroup.mk m : classGroupDegZero K q) = c ∧
        (m : Omega K → ℤ) = pointDivisor K q (algebraMap K (Omega K) β) -
          pointDivisor K q (algebraMap K (Omega K) α)) →
      ∀ f : FqSub K q, anVal K (algebraMap K (Omega K) β) ((τ f : FqSub K q) : MeroRing K) =
        anVal K (algebraMap K (Omega K) α) (f : MeroRing K)

/-- Book, §2, Corollary Vb: the analytic translation `τ_a` and the algebraic translation
attached to any class `c` with `Φ_q(c) = a` coincide on `F_K(q)`.
Blueprint: `cor:translation-Vb`. -/
theorem translation_analytic_eq_algebraic (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)
    (a : K) (ha : a ≠ 0) (c : classGroupDegZero K q)
    (hc : ∀ m : divisorsDegZero K q,
      (QuotientAddGroup.mk m : classGroupDegZero K q) = c →
        PhiQ K q (norm_pos_iff.mp hq0) (m : Omega K → ℤ) = QuotientGroup.mk (Units.mk0 a ha))
    (x : FqSub K q) :
    ((translationOfClass K q c x : FqSub K q) : MeroRing K) =
      translation K (Units.mk0 a ha) (x : MeroRing K) := by
  sorry

end AnalyticTheory
