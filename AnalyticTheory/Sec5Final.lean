module

public import AnalyticTheory.Sec5Row4
public import AnalyticTheory.Sec5Row5

/-!
# §5: the cohomology table, assembled
-/

@[expose] public section

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace AnalyticTheory

universe u

section final

variable {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable {L : Type u} [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
variable [NormedAlgebra K L] [FiniteDimensional K L] [IsGalois K L]
variable (q : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) (T : SemiPeriodicTriple K L q)

attribute [local instance 10] fqKAlgebra
attribute [-instance] fqSubfieldAlgebra fqSubfieldSMul
attribute [local instance] resAlg

include hq0 hq1 in
/-- Book, §5, the table of cohomology groups of `G_𝐐` (generated by `s = τ_Q σ` of order
`n = [L:K]`): `Ĥ⁰, Ĥ¹` of `D_L(q)`, `D⁰_L(q)`, `C⁰_L(q) ≅ L^×/q` (via `Φ_q`, formula (69)),
`P_L(q)`, `F_L(q)^×`. -/
theorem table_cohomology (hqL : algebraMap K L q ≠ 0) :
    -- `D_L(q)`
    (Subsingleton (cycH0 (divAct K L q T) (Module.finrank K L) (DivisorsPeriodic L (algebraMap K L q))) ∧
      Subsingleton (cycH1 (divAct K L q T) (Module.finrank K L)
        (DivisorsPeriodic L (algebraMap K L q)))) ∧
    -- `D⁰_L(q)`
    (Subsingleton (cycH0 (divAct K L q T) (Module.finrank K L) (divisorsDegZero L (algebraMap K L q))) ∧
      Nonempty (cycH1 (divAct K L q T) (Module.finrank K L) (divisorsDegZero L (algebraMap K L q)) ≃+
        ZMod (Module.finrank K L))) ∧
    -- `C⁰_L(q) ≅ L^×/q`
    (Nonempty (cycH0 (Amb := Additive (Lˣ ⧸ Subgroup.zpowers (Units.mk0 _ hqL))) (sigmaOnQuot K L q hqL T.gen) (Module.finrank K L) ⊤ ≃+
        Additive (Kˣ ⧸ normGroupK K L)) ∧
      Nonempty (cycH1 (Amb := Additive (Lˣ ⧸ Subgroup.zpowers (Units.mk0 _ hqL))) (sigmaOnQuot K L q hqL T.gen) (Module.finrank K L) ⊤ ≃+
        ZMod (Module.finrank K L))) ∧
    -- `P_L(q)`
    (Subsingleton (cycH0 (divAct K L q T) (Module.finrank K L) (principalDivisors L (algebraMap K L q))) ∧
      Nonempty (cycH1 (divAct K L q T) (Module.finrank K L) (principalDivisors L (algebraMap K L q)) ≃+
        Additive (Kˣ ⧸ normGroupK K L))) ∧
    -- `F_L(q)^×`
    (Subsingleton (cycH0
        (MonoidHom.toAdditive (Units.map (tauQSigma K L q T : MeroRing L →* MeroRing L)))
        (Module.finrank K L)
        (Subgroup.toAddSubgroup (MonoidHom.range
          (Units.map (((FqSub L (algebraMap K L q)).subtype : FqSub L (algebraMap K L q) →+* MeroRing L) :
            FqSub L (algebraMap K L q) →* MeroRing L))))) ∧
      Subsingleton (cycH1
        (MonoidHom.toAdditive (Units.map (tauQSigma K L q T : MeroRing L →* MeroRing L)))
        (Module.finrank K L)
        (Subgroup.toAddSubgroup (MonoidHom.range
          (Units.map (((FqSub L (algebraMap K L q)).subtype : FqSub L (algebraMap K L q) →+* MeroRing L) :
            FqSub L (algebraMap K L q) →* MeroRing L)))))) :=
  ⟨row_D q hq0 hq1 T, row_D0 q hq0 hq1 T, ⟨row3_H0 q hq0 hq1 T hqL, row3_H1 q hq0 hq1 T hqL⟩,
    ⟨subsingleton_cycH0 _ _ _ (row4_H0 q hq0 hq1 T), row4_H1 q hq0 hq1 T hqL⟩,
    ⟨subsingleton_cycH0 _ _ _ (row5_H0 q hq0 hq1 T), subsingleton_cycH1 _ _ _ (row5_H1 q hq0 hq1 T)⟩⟩


end final

end AnalyticTheory
