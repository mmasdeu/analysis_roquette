import Mathlib

/-!
# Algebraic function fields: prime divisors, divisors, Riemann–Roch spaces, genus

Prime divisors of a function field `F | K` are modelled as discrete valuation rings of `F`
containing `K`; divisors are finitely supported integer functions on them. The
Riemann–Roch space `L(D)` and the genus (through the Riemann–Roch formula
`dim L(D) = deg D − g + 1` for `deg D` large) are defined from these.

Blueprint nodes: `def:prime-divisor`, `def:divisor-ff`, `def:rr-space`, `def:genus`,
`def:degree-one-prime`, `def:principal-divisor-ff`.
-/

namespace AnalyticTheory

universe u

/-- Book, Introduction/§A1: a *prime divisor* of the function field `F | K`: a discrete
valuation ring of `F` (with fraction field `F`) containing `K`.
Blueprint: `def:prime-divisor`. -/
structure PrimeDivisor (K : Type u) (F : Type u) [Field K] [Field F] [Algebra K F] where
  ring : ValuationSubring F
  isDVR : IsDiscreteValuationRing ring
  contains : ∀ c : K, algebraMap K F c ∈ ring

variable {K : Type u} {F : Type u} [Field K] [Field F] [Algebra K F]

namespace PrimeDivisor

/-- The inclusion `K → O_P` of the constants into the valuation ring of a prime divisor. -/
def toRing (P : PrimeDivisor K F) : K →+* P.ring where
  toFun c := ⟨algebraMap K F c, P.contains c⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' c d := Subtype.ext (map_mul _ _ _)
  map_zero' := Subtype.ext (map_zero _)
  map_add' c d := Subtype.ext (map_add _ _ _)

/-- The degree of a prime divisor: the degree of its residue field over `K`.
Blueprint: `def:prime-divisor`. -/
noncomputable def degree (P : PrimeDivisor K F) : ℕ :=
  letI : Algebra K (IsLocalRing.ResidueField P.ring) :=
    ((IsLocalRing.residue P.ring).comp P.toRing).toAlgebra
  Module.finrank K (IsLocalRing.ResidueField P.ring)

/-- A uniformizer of the discrete valuation ring of `P`, viewed in `F`.
Blueprint: `def:prime-divisor`. -/
noncomputable def uniformizer (P : PrimeDivisor K F) : F :=
  Classical.epsilon (fun π : F => ∃ h : π ∈ P.ring, Irreducible (⟨π, h⟩ : P.ring))

/-- The normalized valuation `ord_P(f)`: the integer `n` with `f = u · πⁿ`, `u` a unit
of the valuation ring (for `f ≠ 0`; the value at `0` is irrelevant). Blueprint: `def:prime-divisor`. -/
noncomputable def ord (P : PrimeDivisor K F) (f : F) : ℤ :=
  Classical.epsilon (fun n : ℤ => ∃ u : (P.ring)ˣ, f = (u : F) * (P.uniformizer) ^ n)

end PrimeDivisor

/-- Book, appendix: the divisor group of `F | K`: finitely supported integer functions on the
prime divisors. Blueprint: `def:divisor-ff`. -/
abbrev FFDivisor (K : Type u) (F : Type u) [Field K] [Field F] [Algebra K F] :=
  PrimeDivisor K F →₀ ℤ

/-- The degree homomorphism of divisors, `D ↦ ∑ n_P deg P`. Blueprint: `def:divisor-ff`. -/
noncomputable def FFDivisor.degHom : FFDivisor K F →+ ℤ :=
  Finsupp.liftAddHom fun P : PrimeDivisor K F => AddMonoidHom.mulRight (P.degree : ℤ)

/-- The degree of a divisor, `∑ n_P deg P`. Blueprint: `def:divisor-ff`. -/
noncomputable def FFDivisor.deg (D : FFDivisor K F) : ℤ := FFDivisor.degHom D

/-- Principal divisors: the subgroup generated by the divisors `(f)` of nonzero `f ∈ F`
(that is, the divisors `D` with `D P = ord_P f` for all `P`). Blueprint: `def:principal-divisor-ff`. -/
def FFDivisor.principal (K : Type u) (F : Type u) [Field K] [Field F] [Algebra K F] :
    AddSubgroup (FFDivisor K F) :=
  AddSubgroup.closure {D | ∃ f : F, f ≠ 0 ∧ ∀ P : PrimeDivisor K F, D P = P.ord f}

/-- The group of divisors of degree `0`. Blueprint: `def:divisor-ff`. -/
noncomputable def FFDivisor.degZero (K : Type u) (F : Type u) [Field K] [Field F] [Algebra K F] :
    AddSubgroup (FFDivisor K F) :=
  (FFDivisor.degHom (K := K) (F := F)).ker

/-- The group `C⁰(F | K)` of divisor classes of degree `0`: degree-zero divisors modulo principal
divisors. Blueprint: `def:principal-divisor-ff`. -/
abbrev FFClassGroupDegZero (K : Type u) (F : Type u) [Field K] [Field F] [Algebra K F] : Type u :=
  FFDivisor.degZero K F ⧸ (FFDivisor.principal K F).addSubgroupOf (FFDivisor.degZero K F)

/-- The Riemann–Roch space `L(D) = {f | (f) + D ≥ 0}` as a `K`-submodule of `F`, i.e. the
set of `f` with `f · π_Pᴰ⁽ᴾ⁾ ∈ O_P` for every prime divisor `P`.
Blueprint: `def:rr-space`. -/
noncomputable def rrSpace (D : FFDivisor K F) : Submodule K F where
  carrier := {f | ∀ P : PrimeDivisor K F, f * (P.uniformizer) ^ (D P) ∈ P.ring}
  add_mem' := fun {f g} hf hg P => by
    rw [add_mul]
    exact P.ring.add_mem _ _ (hf P) (hg P)
  zero_mem' := fun P => by simp
  smul_mem' := fun c f hf P => by
    rw [Algebra.smul_def, mul_assoc]
    exact P.ring.mul_mem _ _ (P.contains c) (hf P)

/-- The genus of the function field `F | K`: the (least) `g` for which
`dim_K L(D) = deg D − g + 1` holds for all divisors of sufficiently large degree
(Riemann–Roch). Blueprint: `def:genus`. -/
noncomputable def genus (K : Type u) (F : Type u) [Field K] [Field F] [Algebra K F] : ℕ :=
  sInf {g : ℕ | ∃ N : ℤ, ∀ D : FFDivisor K F, N ≤ D.deg →
    ((Module.finrank K (rrSpace D) : ℕ) : ℤ) = D.deg - g + 1}

/-- Book, Introduction: `F | K` has a *prime divisor of degree `1`*.
Blueprint: `def:degree-one-prime`. -/
def HasPrimeOfDegreeOne (K : Type u) (F : Type u) [Field K] [Field F] [Algebra K F] : Prop :=
  ∃ P : PrimeDivisor K F, P.degree = 1

end AnalyticTheory
