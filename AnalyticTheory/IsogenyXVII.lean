import AnalyticTheory.Isogeny

/-!
# Theorem XVII (i): the degree of `F_K(q)` over `F_K(q̄ | Xᵐ)`

For `q̄ᵈ = qᵐ` (`d, m > 0`) we have the tower
`F_K(q̄ | Xᵐ) ⊆ F_K(qᵐ | Xᵐ) ⊆ F_K(q)`:

* the lower step is the image under `μ_m` of `F_K(q̄) ⊆ F_K(qᵐ)`, which is cyclic of degree `d`,
  generated by the translation `τ_{q̄}` (Artin's theorem);
* the upper step has degree `m`, with basis `uᵢ = X⁻ⁱ μ_m(τ_{qⁱ}Θ / Θ)`, `0 ≤ i < m`, where `Θ` is
  the theta function of period `qᵐ` (book, (77)).

Blueprint: `thm:XVII`.
-/

open Filter Topology

namespace AnalyticTheory

universe u

variable {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]

/-! ### Relative degrees of subfields -/

section relDeg

variable {M : Type*} [Field M]

theorem relDeg_eq {E F : Subfield M} (h : E ≤ F) :
    relDeg E F = letI := (Subfield.inclusion h).toAlgebra; Module.finrank E F := by
  rw [relDeg, dite_eq_left h]

/-- Multiplicativity of relative degrees in towers. -/
theorem relDeg_mul {E E' F : Subfield M} (h1 : E ≤ E') (h2 : E' ≤ F) :
    relDeg E F = relDeg E E' * relDeg E' F := by
  rw [relDeg_eq h1, relDeg_eq h2, relDeg_eq (h1.trans h2)]
  let : Algebra E E' := (Subfield.inclusion h1).toAlgebra
  let : Algebra E' F := (Subfield.inclusion h2).toAlgebra
  let : Algebra E F := (Subfield.inclusion (h1.trans h2)).toAlgebra
  have : IsScalarTower E E' F := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  exact (Module.finrank_mul_finrank E E' F).symm

/-- A subfield is isomorphic to its image under a ring homomorphism of fields. -/
noncomputable def subfieldMapEquiv {M' : Type*} [Field M'] (μ : M →+* M') (E : Subfield M) :
    E ≃+* E.map μ :=
  RingEquiv.ofBijective (μ.restrict E (E.map μ) (fun x hx => ⟨x, hx, rfl⟩))
    ⟨fun _x _y h => Subtype.ext (μ.injective (congrArg Subtype.val h)),
      fun ⟨_, x, hx, rfl⟩ => ⟨⟨x, hx⟩, rfl⟩⟩

/-- Relative degrees are invariant under injective ring homomorphisms. -/
theorem relDeg_map {M' : Type*} [Field M'] (μ : M →+* M') {E F : Subfield M} (h : E ≤ F) :
    relDeg (E.map μ) (F.map μ) = relDeg E F := by
  have h' : E.map μ ≤ F.map μ := fun _ ⟨y, hy, hyx⟩ => ⟨y, h hy, hyx⟩
  rw [relDeg_eq h, relDeg_eq h']
  let : Algebra E F := (Subfield.inclusion h).toAlgebra
  let : Algebra (E.map μ) (F.map μ) := (Subfield.inclusion h').toAlgebra
  exact (Algebra.finrank_eq_of_equiv_equiv (subfieldMapEquiv μ E)
    (subfieldMapEquiv μ F) (by ext x; rfl)).symm

end relDeg

/-! ### Translations acting trivially on `F_K(Q)` -/

/-- A translation `τ_c` fixing all `Q`-periodic functions is a power of `Q`. -/
theorem exists_zpow_of_translation_fix {Q : K} (hQ0 : 0 < ‖Q‖) (hQ1 : ‖Q‖ < 1) (c : Kˣ)
    (h : ∀ f ∈ FqSub K Q, translation K c f = f) : ∃ k : ℤ, (c : K) = Q ^ k := by
  have hc0 : (c : K) ≠ 0 := c.ne_zero
  have hwp := h _ (wpAlg_mem_Fq hQ0 hQ1)
  have h1 := anVal_translation_shift (q := (c : K)) hc0 (one_ne_zero (α := Omega K))
    (wpAlg hQ0 hQ1)
  rw [mul_one, show Units.mk0 (c : K) hc0 = c from Units.ext rfl, hwp, anVal_wpAlg_one] at h1
  have hcΩ : algebraMap K (Omega K) (c : K) ≠ 0 := (map_ne_zero _).mpr hc0
  by_contra hno
  push Not at hno
  have hnc : ¬ ConjModQ K Q 1 (algebraMap K (Omega K) (c : K)) := by
    rw [conjModQ_one_iff (norm_pos_iff.mp hQ0)]
    rintro ⟨k, hk⟩
    exact hno k ((algebraMap K (Omega K)).injective (by rw [hk, map_zpow₀]))
  have h2 := anVal_quot_nonneg hQ0 hQ1 hcΩ hnc (Gw hQ0 hQ1) 2
  rw [← wpAlg_eq_Gw, h1] at h2
  exact absurd h2 (by decide)

/-! ### The lower step: `[F_K(qᵐ) : F_K(q̄)] = d` -/

section lower

variable {Q qbar : K} (hQ0 : 0 < ‖Q‖) (hQ1 : ‖Q‖ < 1) (hqb0 : 0 < ‖qbar‖) (hqb1 : ‖qbar‖ < 1)
  {d : ℕ} (hd : 0 < d) (hqd : qbar ^ d = Q)

/-- `τ_{q̄}` as an automorphism of `F_K(Q)`. -/
noncomputable abbrev tauBar (qbar : K) (hqb0 : 0 < ‖qbar‖) (Q : K) : FqSub K Q ≃+* FqSub K Q :=
  translationFq Q (Units.mk0 qbar (norm_pos_iff.mp hqb0))

theorem tauBar_zpow_coe (k : ℤ) (f : FqSub K Q) :
    (((tauBar qbar hqb0 Q) ^ k) f : MeroRing K) =
      translation K (Units.mk0 qbar (norm_pos_iff.mp hqb0) ^ k) (f : MeroRing K) := by
  induction k using Int.induction_on generalizing f with
  | zero => simp [translation_one]
  | succ n ih =>
    rw [zpow_add_one]
    refine (ih (tauBar qbar hqb0 Q f)).trans ?_
    rw [zpow_add_one, translation_mul]; rfl
  | pred n ih =>
    rw [zpow_sub_one]
    refine (ih ((tauBar qbar hqb0 Q)⁻¹ f)).trans ?_
    set b := Units.mk0 qbar (norm_pos_iff.mp hqb0)
    have hinv : (((tauBar qbar hqb0 Q)⁻¹ f : FqSub K Q) : MeroRing K) =
        translation K b⁻¹ (f : MeroRing K) := by
      apply (translation K b).injective
      rw [← translation_mul, mul_inv_cancel, translation_one]
      show (translation K b) ((translation K b).symm (f : MeroRing K)) = _
      rw [RingEquiv.apply_symm_apply]
    rw [hinv, ← translation_mul, zpow_sub_one]

include hQ0 hQ1 hqb1 hd hqd in
/-- Book, §6, (76): `τ_{q̄}` has order `d` as an automorphism of `F_K(Q)` when `q̄ᵈ = Q`. -/
theorem orderOf_tauBar : orderOf (tauBar qbar hqb0 Q) = d := by
  have hqb0' : qbar ≠ 0 := norm_pos_iff.mp hqb0
  have hQ0' : Q ≠ 0 := norm_pos_iff.mp hQ0
  have key : ∀ k : ℤ, (tauBar qbar hqb0 Q) ^ k = 1 ↔ (d : ℤ) ∣ k := by
    intro k
    constructor
    · intro hk
      have hfix : ∀ f ∈ FqSub K Q,
          translation K (Units.mk0 qbar hqb0' ^ k) f = f := by
        intro f hf
        have := congrArg (fun φ : FqSub K Q ≃+* FqSub K Q => (φ ⟨f, hf⟩ : MeroRing K)) hk
        simpa [tauBar_zpow_coe] using this
      obtain ⟨j, hj⟩ := exists_zpow_of_translation_fix hQ0 hQ1 _ hfix
      rw [Units.val_zpow_eq_zpow_val, Units.val_mk0, ← hqd, ← zpow_natCast, ← zpow_mul] at hj
      have hinj := zpow_right_injective₀ (norm_pos_iff.mpr hqb0') (ne_of_lt hqb1)
      have : k = d * j := hinj (by simp only; rw [← norm_zpow, ← norm_zpow, hj])
      exact ⟨j, this⟩
    · rintro ⟨j, rfl⟩
      apply RingEquiv.ext
      intro f
      apply Subtype.ext
      rw [tauBar_zpow_coe]
      have hu : Units.mk0 qbar hqb0' ^ ((d : ℤ) * j) = Units.mk0 Q hQ0' ^ j := by
        apply Units.ext
        rw [Units.val_zpow_eq_zpow_val, Units.val_zpow_eq_zpow_val, Units.val_mk0, Units.val_mk0,
          zpow_mul, zpow_natCast, hqd]
      rw [hu, translation_zpow_of_periodic (rfl : ((Units.mk0 Q hQ0' : Kˣ) : K) = Q) f.2]
      rfl
  rw [orderOf_eq_iff hd]
  refine ⟨?_, fun k hk hk0 hk' => ?_⟩
  · have := (key d).mpr dvd_rfl
    rwa [zpow_natCast] at this
  · have := (key k).mp (by rwa [zpow_natCast])
    have := Int.le_of_dvd (by exact_mod_cast hk0) this
    omega

include hd hqd in
theorem FqSub_bar_le : FqSub K qbar ≤ FqSub K Q := by
  intro f hf a ha
  have hqb0' : qbar ≠ 0 := by
    rintro rfl; rw [zero_pow (by omega : d ≠ 0)] at hqd; exact a.ne_zero (ha.trans hqd.symm)
  have : a = Units.mk0 qbar hqb0' ^ (d : ℤ) :=
    Units.ext (by rw [ha, Units.val_zpow_eq_zpow_val, Units.val_mk0, zpow_natCast, hqd])
  rw [this]
  exact translation_zpow_of_periodic rfl hf d

include hQ0 hQ1 hqb0 hqb1 hd hqd in
/-- `[F_K(Q) : F_K(q̄)] = d` for `q̄ᵈ = Q`: the extension is cyclic, generated by `τ_{q̄}`. -/
theorem relDeg_FqSub_bar : relDeg (FqSub K qbar) (FqSub K Q) = d := by
  have hqb0' : qbar ≠ 0 := norm_pos_iff.mp hqb0
  have hle : FqSub K qbar ≤ FqSub K Q := FqSub_bar_le hd hqd
  set T := tauBar qbar hqb0 Q with hT
  set G := Subgroup.zpowers T with hG
  have hord := orderOf_tauBar hQ0 hQ1 hqb0 hqb1 hd hqd
  have : Finite G :=
    (isOfFinOrder_iff_pow_eq_one.mpr ⟨d, hd, by rw [← hord]; exact pow_orderOf_eq_one T⟩).finite_zpowers
  let : Fintype G := Fintype.ofFinite G
  have hcard : Fintype.card G = d := by
    rw [Fintype.card_eq_nat_card, Nat.card_zpowers, hord]
  have hart := FixedPoints.finrank_eq_card G (FqSub K Q)
  rw [relDeg_eq hle, ← hcard, ← hart]
  let : Algebra (FqSub K qbar) (FqSub K Q) := (Subfield.inclusion hle).toAlgebra
  have hfix : ∀ x : FqSub K Q, (x : MeroRing K) ∈ FqSub K qbar →
      x ∈ FixedPoints.subfield G (FqSub K Q) := by
    intro x hx g
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp g.2
    apply Subtype.ext
    show ((g : FqSub K Q ≃+* FqSub K Q) x : MeroRing K) = x
    rw [← hk, tauBar_zpow_coe]
    exact translation_zpow_of_periodic rfl hx k
  have hfix' : ∀ x ∈ FixedPoints.subfield G (FqSub K Q), (x : MeroRing K) ∈ FqSub K qbar := by
    intro x hx a ha
    have hab : a = Units.mk0 qbar hqb0' := Units.ext ha
    have := congrArg Subtype.val (hx ⟨T, Subgroup.mem_zpowers T⟩)
    rw [hab]; exact this
  let i : FqSub K qbar ≃+* FixedPoints.subfield G (FqSub K Q) :=
    { toFun := fun x => ⟨Subfield.inclusion hle x, hfix _ x.2⟩
      invFun := fun y => ⟨((y : FqSub K Q) : MeroRing K), hfix' y y.2⟩
      left_inv := fun x => rfl
      right_inv := fun y => rfl
      map_mul' := fun x y => rfl
      map_add' := fun x y => rfl }
  exact Algebra.finrank_eq_of_equiv_equiv i (RingEquiv.refl _) (by ext x; rfl)

include hQ0 hQ1 hqb0 hqb1 hd hqd in
/-- `F_K(Q) | F_K(q̄)` is Galois, hence separable. -/
theorem isRelSeparable_FqSub_bar : IsRelSeparable (FqSub K qbar) (FqSub K Q) := by
  have hqb0' : qbar ≠ 0 := norm_pos_iff.mp hqb0
  have hle : FqSub K qbar ≤ FqSub K Q := FqSub_bar_le hd hqd
  set T := tauBar qbar hqb0 Q with hT
  set G := Subgroup.zpowers T with hG
  have hord := orderOf_tauBar hQ0 hQ1 hqb0 hqb1 hd hqd
  have : Finite G :=
    (isOfFinOrder_iff_pow_eq_one.mpr ⟨d, hd, by rw [← hord]; exact pow_orderOf_eq_one T⟩).finite_zpowers
  let : Fintype G := Fintype.ofFinite G
  have hcard : Fintype.card G = d := by
    rw [Fintype.card_eq_nat_card, Nat.card_zpowers, hord]
  refine ⟨hle, ?_⟩
  let : Algebra (FqSub K qbar) (FqSub K Q) := (Subfield.inclusion hle).toAlgebra
  have hfix : ∀ x : FqSub K Q, (x : MeroRing K) ∈ FqSub K qbar →
      x ∈ FixedPoints.subfield G (FqSub K Q) := by
    intro x hx g
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp g.2
    apply Subtype.ext
    show ((g : FqSub K Q ≃+* FqSub K Q) x : MeroRing K) = x
    rw [← hk, tauBar_zpow_coe]
    exact translation_zpow_of_periodic rfl hx k
  have hfix' : ∀ x ∈ FixedPoints.subfield G (FqSub K Q), (x : MeroRing K) ∈ FqSub K qbar := by
    intro x hx a ha
    have hab : a = Units.mk0 qbar hqb0' := Units.ext ha
    have := congrArg Subtype.val (hx ⟨T, Subgroup.mem_zpowers T⟩)
    rw [hab]; exact this
  let i : FqSub K qbar ≃+* FixedPoints.subfield G (FqSub K Q) :=
    { toFun := fun x => ⟨Subfield.inclusion hle x, hfix _ x.2⟩
      invFun := fun y => ⟨((y : FqSub K Q) : MeroRing K), hfix' y y.2⟩
      left_inv := fun x => rfl
      right_inv := fun y => rfl
      map_mul' := fun x y => rfl
      map_add' := fun x y => rfl }
  have : Algebra.IsSeparable (FixedPoints.subfield G (FqSub K Q)) (FqSub K Q) :=
    IsGalois.to_isSeparable
  exact Algebra.IsSeparable.of_equiv_equiv i.symm (RingEquiv.refl _) (by ext x; rfl)

end lower

/-- Fast instances for subfields of `M_K` (avoids slow instance search through the many algebra
structures on `M_K`). -/
noncomputable instance (priority := high) meroSubfieldAlgebra (S : Subfield (MeroRing K)) :
    Algebra S (MeroRing K) :=
  RingHom.toAlgebra S.subtype

noncomputable instance (priority := high) meroSubfieldSMul (S : Subfield (MeroRing K)) :
    SMul S (MeroRing K) :=
  (meroSubfieldAlgebra S).toSMul

noncomputable instance (priority := high) meroSubfieldModule (S : Subfield (MeroRing K)) :
    Module S (MeroRing K) :=
  (meroSubfieldAlgebra S).toModule

/-! ### The upper step, part 1: `M_K` over `μ_m(M_K)` has basis `1, X⁻¹, …, X^{-(m-1)}` -/

section upper

variable (K)

/-- `X⁻¹ ∈ M_K`. -/
noncomputable abbrev tX : MeroRing K :=
  algebraMap (holSubring K) (MeroRing K) (monoHol K (Omega K) (-1))

/-- `μ_m(M_K)`, the meromorphic functions of `Xᵐ`. -/
noncomputable abbrev Sm (m : ℤ) : Subfield (MeroRing K) := (substPow K m).fieldRange

variable {K}

theorem monoHol_neg_nat (i : ℕ) :
    monoHol K (Omega K) (-(i : ℤ)) = monoHol K (Omega K) (-1) ^ i := by
  refine Subtype.ext (funext fun x => ?_)
  rw [pow_apply_hol, monoHol_apply, monoHol_apply, ← zpow_natCast, ← zpow_mul, neg_one_mul]

theorem alg_monoHol_neg_nat (i : ℕ) :
    algebraMap (holSubring K) (MeroRing K) (monoHol K (Omega K) (-(i : ℤ))) = tX K ^ i := by
  rw [monoHol_neg_nat, map_pow]

theorem holExpand_monoHol {m : ℤ} (hm : m ≠ 0) (n : ℤ) :
    EntireLaurent.holExpand K (Omega K) m hm (monoHol K (Omega K) n) =
      monoHol K (Omega K) (m * n) := by
  refine Subtype.ext (funext fun x => ?_)
  rw [EntireLaurent.holExpand_apply, monoHol_apply, monoHol_apply, zpow_mul]

theorem tX_ne_zero : tX K ≠ 0 :=
  alg_hol_ne_zero (monoHol_ne_zero (K := K) (-1))

theorem tX_pow_mem {m : ℕ} (hm : 0 < m) : tX K ^ m ∈ Sm K m := by
  refine ⟨tX K, ?_⟩
  rw [substPow_alg (EntireLaurent.mHol_ne_zero hm), holExpand_monoHol, mul_neg_one,
    alg_monoHol_neg_nat]

/-- Every holomorphic function is a polynomial in `X⁻¹` with coefficients in `μ_m(M_K)`. -/
theorem alg_eq_sum {m : ℕ} (hm : 0 < m) (f : holSubring K) :
    algebraMap (holSubring K) (MeroRing K) f = ∑ i ∈ Finset.range m,
      tX K ^ i * substPow K m (algebraMap (holSubring K) (MeroRing K)
        (EntireLaurent.holComponent K (Omega K) hm i f)) := by
  conv_lhs => rw [EntireLaurent.hol_decomp K hm f]
  rw [map_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [map_mul, alg_monoHol_neg_nat, substPow_alg (EntireLaurent.mHol_ne_zero hm)]

/-- Linear independence of `1, X⁻¹, …, X^{-(m-1)}` over `μ_m(M_K)`. -/
theorem tX_pow_linearIndependent {m : ℕ} (hm : 0 < m) :
    LinearIndependent (Sm K m) (fun i : Fin m => tX K ^ (i : ℕ)) := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro g hg i
  have hmz := EntireLaurent.mHol_ne_zero hm
  choose y hy using fun j : Fin m => (g j).2
  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors (holSubring K))
    Finset.univ y
  choose h hh using fun j : Fin m => hb j (Finset.mem_univ j)
  have hb0 : (b : holSubring K) ≠ 0 := nonZeroDivisors.ne_zero b.2
  -- the relation with integral coefficients
  have hrel : ∑ j : Fin m, tX K ^ (j : ℕ) *
      substPow K m (algebraMap (holSubring K) (MeroRing K) (h j)) = 0 := by
    have := congrArg (fun z => substPow K m (algebraMap (holSubring K) (MeroRing K) b) * z) hg
    simp only [mul_zero, Finset.mul_sum] at this
    rw [← this]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    have e : g j • tX K ^ (j : ℕ) = ((g j : Sm K m) : MeroRing K) * tX K ^ (j : ℕ) := rfl
    rw [hh j, Algebra.smul_def, map_mul, e, ← hy j]
    ring
  let G : ℕ → holSubring K := fun j => if hj : j < m then h ⟨j, hj⟩ else 0
  have hsum : ∑ j ∈ Finset.range m, monoHol K (Omega K) (-(j : ℤ)) *
      EntireLaurent.holExpand K (Omega K) m hmz (G j) = 0 := by
    apply IsFractionRing.injective (holSubring K) (MeroRing K)
    rw [map_zero, map_sum, ← hrel, ← Fin.sum_univ_eq_sum_range (fun j =>
      algebraMap (holSubring K) (MeroRing K) (monoHol K (Omega K) (-(j : ℤ)) *
        EntireLaurent.holExpand K (Omega K) m hmz (G j)))]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_mul, alg_monoHol_neg_nat, ← substPow_alg hmz]
    simp [G, j.2]
  have hGi := EntireLaurent.eq_zero_of_sum_mono_mul_holExpand K hm G hsum i i.2
  simp only [G, i.2, dite_eq_left] at hGi
  have hGi' : h i = 0 := by simpa using hGi
  have h1 : (b : holSubring K) • y i = 0 := by
    rw [← hh i, hGi', map_zero]
  rw [Algebra.smul_def] at h1
  have hy0 : y i = 0 := (mul_eq_zero.mp h1).resolve_left (alg_hol_ne_zero hb0)
  apply Subtype.ext
  rw [← hy i, hy0, map_zero]; rfl

/-- The span of `1, X⁻¹, …, X^{-(m-1)}` over `μ_m(M_K)`. -/
noncomputable abbrev Vm (m : ℕ) : Submodule (Sm K m) (MeroRing K) :=
  Submodule.span (Sm K m) (Set.range (fun i : Fin m => tX K ^ (i : ℕ)))

theorem tX_pow_mem_Vm {m : ℕ} (hm : 0 < m) (k : ℕ) : tX K ^ k ∈ Vm (K := K) m := by
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    by_cases hk : k < m
    · exact Submodule.subset_span ⟨⟨k, hk⟩, rfl⟩
    · have e : tX K ^ k = (⟨tX K ^ m, tX_pow_mem hm⟩ : Sm K m) • tX K ^ (k - m) := by
        show _ = tX K ^ m * tX K ^ (k - m)
        rw [← pow_add, Nat.add_sub_cancel' (not_lt.mp hk)]
      rw [e]
      exact Submodule.smul_mem _ _ (ih _ (by omega))

theorem mul_mem_Vm {m : ℕ} (hm : 0 < m) {x y : MeroRing K} (hx : x ∈ Vm (K := K) m)
    (hy : y ∈ Vm (K := K) m) : x * y ∈ Vm (K := K) m := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨j, rfl⟩ := hy
      rw [← pow_add]; exact tX_pow_mem_Vm hm _
    | zero => rw [mul_zero]; exact Submodule.zero_mem _
    | add y z _ _ h1 h2 => rw [mul_add]; exact Submodule.add_mem _ h1 h2
    | smul c y _ h =>
      rw [show tX K ^ (i : ℕ) * c • y = c • (tX K ^ (i : ℕ) * y) from mul_smul_comm c _ y]
      exact Submodule.smul_mem _ _ h
  | zero => rw [zero_mul]; exact Submodule.zero_mem _
  | add x z _ _ h1 h2 => rw [add_mul]; exact Submodule.add_mem _ h1 h2
  | smul c x _ h => rw [smul_mul_assoc]; exact Submodule.smul_mem _ _ h

theorem alg_mem_Vm {m : ℕ} (hm : 0 < m) (f : holSubring K) :
    algebraMap (holSubring K) (MeroRing K) f ∈ Vm (K := K) m := by
  rw [alg_eq_sum hm f]
  refine Submodule.sum_mem _ (fun i hi => ?_)
  have hz : substPow K m (algebraMap (holSubring K) (MeroRing K)
      (EntireLaurent.holComponent K (Omega K) hm i f)) ∈ Sm K m := ⟨_, rfl⟩
  rw [mul_comm, show substPow K m (algebraMap (holSubring K) (MeroRing K)
      (EntireLaurent.holComponent K (Omega K) hm i f)) * tX K ^ i =
      (⟨_, hz⟩ : Sm K m) • tX K ^ i from rfl]
  exact Submodule.smul_mem _ _ (tX_pow_mem_Vm hm i)

theorem inv_alg_mem_Vm {m : ℕ} (hm : 0 < m) {b : holSubring K} (hb : b ≠ 0) :
    (algebraMap (holSubring K) (MeroRing K) b)⁻¹ ∈ Vm (K := K) m := by
  set B := algebraMap (holSubring K) (MeroRing K) b
  have hB0 : B ≠ 0 := alg_hol_ne_zero hb
  let : Module (Sm K m) (Vm (K := K) m) := Submodule.module _
  let φ : Vm (K := K) m →ₗ[Sm K m] Vm (K := K) m :=
    { toFun := fun v => ⟨B * v, mul_mem_Vm hm (alg_mem_Vm hm b) v.2⟩
      map_add' := fun v w => Subtype.ext (mul_add _ _ _)
      map_smul' := fun c v => Subtype.ext (mul_smul_comm c B (v : MeroRing K)) }
  have hinj : Function.Injective φ := fun v w h =>
    Subtype.ext (mul_left_cancel₀ hB0 (show B * v = B * w from congrArg Subtype.val h))
  have : FiniteDimensional (Sm K m) (Vm (K := K) m) :=
    FiniteDimensional.span_of_finite _ (Set.finite_range _)
  obtain ⟨v, hv⟩ := (LinearMap.injective_iff_surjective.mp hinj)
    ⟨1, by simpa using tX_pow_mem_Vm (K := K) hm 0⟩
  have h1 : B * v = 1 := congrArg Subtype.val hv
  rw [inv_eq_of_mul_eq_one_right h1]
  exact v.2

/-- `1, X⁻¹, …, X^{-(m-1)}` span `M_K` over `μ_m(M_K)`. -/
theorem span_tX_pow {m : ℕ} (hm : 0 < m) : Vm (K := K) m = ⊤ := by
  rw [eq_top_iff]
  intro x _
  obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := holSubring K) x
  rw [div_eq_mul_inv]
  exact mul_mem_Vm hm (alg_mem_Vm hm a) (inv_alg_mem_Vm hm (nonZeroDivisors.ne_zero hb))

/-- The basis `1, X⁻¹, …, X^{-(m-1)}` of `M_K` over `μ_m(M_K)`. -/
noncomputable def basisTX {m : ℕ} (hm : 0 < m) : Module.Basis (Fin m) (Sm K m) (MeroRing K) :=
  Module.Basis.mk (tX_pow_linearIndependent hm) (span_tX_pow (K := K) hm).ge

/-- `[M_K : μ_m(M_K)] = m`. -/
theorem finrank_Sm {m : ℕ} (hm : 0 < m) : Module.finrank (Sm K m) (MeroRing K) = m := by
  rw [Module.finrank_eq_card_basis (basisTX (K := K) hm), Fintype.card_fin]

/-! ### The upper step, part 2: the theta quotients `uᵢ` -/

theorem algebraMapK_eq (c : K) :
    algebraMap K (MeroRing K) c =
      algebraMap (holSubring K) (MeroRing K) (algebraMap K (holSubring K) c) := rfl

theorem translation_tX (a : Kˣ) :
    translation K a (tX K) = algebraMap K (MeroRing K) (a : K) * tX K := by
  rw [translation_alg, algebraMapK_eq, ← map_mul]
  congr 1
  refine Subtype.ext (funext fun x => ?_)
  rw [mul_apply_hol, algebraMap_apply_hol, monoHol_apply]
  show (monoHol K (Omega K) (-1)).1 (scalePt K a⁻¹ x) = _
  rw [monoHol_apply]
  simp only [scalePt, zpow_neg, zpow_one, mul_inv, inv_inv, Units.val_inv_eq_inv_val, map_inv₀]

theorem tX_inv_eq : (tX K)⁻¹ = algebraMap (holSubring K) (MeroRing K) (monoHol K (Omega K) 1) := by
  apply inv_eq_of_mul_eq_one_left
  rw [← map_mul, ← monoHol_add, add_neg_cancel, monoHol_zero, map_one]

theorem translation_tX_inv (a : Kˣ) :
    translation K a (tX K)⁻¹ = algebraMap K (MeroRing K) (a : K)⁻¹ * (tX K)⁻¹ := by
  rw [map_inv₀, translation_tX, mul_inv, map_inv₀]

theorem substPow_algebraMapK {m : ℤ} (hm : m ≠ 0) (c : K) :
    substPow K m (algebraMap K (MeroRing K) c) = algebraMap K (MeroRing K) c := by
  rw [algebraMapK_eq, substPow_alg hm]
  rfl

section theta

variable {Q : K} (hQ0 : 0 < ‖Q‖) (hQ1 : ‖Q‖ < 1)

/-- The theta function of period `Q`, viewed in `M_K`. -/
noncomputable abbrev ThM : MeroRing K :=
  algebraMap (holSubring K) (MeroRing K) (thetaFun hQ0 hQ1 (1 : Omega K))

theorem ThM_ne_zero : ThM hQ0 hQ1 ≠ 0 :=
  alg_hol_ne_zero (thetaFun_spec hQ0 hQ1 one_ne_zero).1

/-- `Θ(Q⁻¹X) = −X Θ(X)`. -/
theorem translation_ThM :
    translation K (Units.mk0 Q (norm_pos_iff.mp hQ0)) (ThM hQ0 hQ1) =
      -(tX K)⁻¹ * ThM hQ0 hQ1 := by
  have h := (thetaFun_spec hQ0 hQ1 (one_ne_zero (α := Omega K))).2.1
  have hmin : minpoly K (1 : Omega K) = Polynomial.X - Polynomial.C 1 := by
    rw [← map_one (algebraMap K (Omega K)), minpoly.eq_X_sub_C (Omega K) (1 : K)]
  rw [hmin, Polynomial.natDegree_X_sub_C] at h
  simp only [Polynomial.coeff_sub, Polynomial.coeff_X_zero, Polynomial.coeff_C_zero,
    zero_sub] at h
  rw [translation_alg, h]
  simp only [Nat.cast_one, map_mul, ← tX_inv_eq, inv_neg, inv_one, map_neg,
    map_one]
  ring

/-- `wᵢ = Θ(q⁻ⁱX)/Θ(X)`. -/
noncomputable def wq (a : Kˣ) (i : ℕ) : MeroRing K :=
  translation K (a ^ i) (ThM hQ0 hQ1) / ThM hQ0 hQ1

theorem wq_ne_zero (a : Kˣ) (i : ℕ) : wq hQ0 hQ1 a i ≠ 0 := by
  refine div_ne_zero ?_ (ThM_ne_zero hQ0 hQ1)
  rw [Ne, map_eq_zero_iff _ (translation K _).injective]
  exact ThM_ne_zero hQ0 hQ1

/-- `wᵢ(Q⁻¹X) = q⁻ⁱ wᵢ(X)`. -/
theorem translation_wq (a : Kˣ) (i : ℕ) :
    translation K (Units.mk0 Q (norm_pos_iff.mp hQ0)) (wq hQ0 hQ1 a i) =
      algebraMap K (MeroRing K) ((a : K) ^ i)⁻¹ * wq hQ0 hQ1 a i := by
  have hT := ThM_ne_zero hQ0 hQ1
  have htX := tX_ne_zero (K := K)
  have ha : (a : K) ≠ 0 := a.ne_zero
  unfold wq
  rw [map_div₀, translation_comm, translation_ThM, map_mul, map_neg, translation_tX_inv]
  rw [Units.val_pow_eq_pow_val]
  have hTa : translation K (a ^ i) (ThM hQ0 hQ1) ≠ 0 := by
    rw [Ne, map_eq_zero_iff _ (translation K _).injective]; exact hT
  have hc : algebraMap K (MeroRing K) ((a : K) ^ i) ≠ 0 :=
    (map_ne_zero _).mpr (pow_ne_zero _ ha)
  rw [map_inv₀]
  field_simp

end theta

section basisU

omit [IsUltrametricDist K] [CompleteSpace K] in
theorem norm_pow_pos {q : K} (hq0 : 0 < ‖q‖) (m : ℕ) : 0 < ‖q ^ m‖ := by
  rw [norm_pow]; exact pow_pos hq0 m

omit [IsUltrametricDist K] [CompleteSpace K] in
theorem norm_pow_lt_one {q : K} (hq1 : ‖q‖ < 1) {m : ℕ} (hm : 0 < m) : ‖q ^ m‖ < 1 := by
  rw [norm_pow]; exact pow_lt_one₀ (norm_nonneg _) hq1 hm.ne'

/-- The unit `q`. -/
noncomputable abbrev qU {q : K} (hq0 : 0 < ‖q‖) : Kˣ := Units.mk0 q (norm_pos_iff.mp hq0)

/-- `uᵢ = X⁻ⁱ μ_m(Θ(q^{-i}Xᵐ)/Θ(Xᵐ))`, `Θ` of period `qᵐ` (book, (77)). -/
noncomputable def uq {q : K} (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) {m : ℕ} (hm : 0 < m) (i : ℕ) :
    MeroRing K :=
  tX K ^ i * substPow K m (wq (norm_pow_pos hq0 m) (norm_pow_lt_one hq1 hm) (qU hq0) i)

/-- Book, §6, (77): the functions `uᵢ` are `q`-periodic. -/
theorem uq_mem {q : K} (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) {m : ℕ} (hm : 0 < m) (i : ℕ) :
    uq hq0 hq1 hm i ∈ FqSub K q := by
  intro a ha
  have haq : a = qU hq0 := Units.ext ha
  subst haq
  have hmz := EntireLaurent.mHol_ne_zero hm
  have hQ : qU hq0 ^ (m : ℤ) = Units.mk0 (q ^ m) (norm_pos_iff.mp (norm_pow_pos hq0 m)) :=
    Units.ext (by simp)
  unfold uq
  rw [map_mul, map_pow, translation_tX, ← substPow_translation hmz, hQ, translation_wq,
    map_mul, substPow_algebraMapK hmz]
  have hq0' : q ≠ 0 := norm_pos_iff.mp hq0
  have hc : algebraMap K (MeroRing K) q ≠ 0 := (map_ne_zero _).mpr hq0'
  simp only [Units.val_mk0, map_inv₀, map_pow]
  field_simp
  ring

end basisU

section degreeUpper

variable {q : K} (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) {m : ℕ} (hm : 0 < m)

/-- `sᵢ = μ_m(wᵢ)`, so that `uᵢ = X⁻ⁱ sᵢ`. -/
noncomputable abbrev sw (i : ℕ) : MeroRing K :=
  substPow K m (wq (norm_pow_pos hq0 m) (norm_pow_lt_one hq1 hm) (qU hq0) i)

theorem sw_mem (i : ℕ) : sw hq0 hq1 hm i ∈ Sm K m := ⟨_, rfl⟩

theorem sw_ne_zero (i : ℕ) : sw hq0 hq1 hm i ≠ 0 :=
  (map_ne_zero _).mpr (wq_ne_zero _ _ _ i)

theorem smul_Sm (a : Sm K (m : ℤ)) (x : MeroRing K) : a • x = (a : MeroRing K) * x := rfl

/-- Book, §6, (77): the functions `u₀, …, u_{m−1}` are linearly independent over `μ_m(M_K)`. -/
theorem uq_linearIndependent :
    LinearIndependent (Sm K m) (fun i : Fin m => uq hq0 hq1 hm i) := by
  rw [Fintype.linearIndependent_iff]
  intro g hg i
  have h := Fintype.linearIndependent_iff.mp (tX_pow_linearIndependent (K := K) hm)
    (fun j => g j * ⟨sw hq0 hq1 hm j, sw_mem hq0 hq1 hm j⟩) (by
      rw [← hg]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [smul_Sm, smul_Sm]
      simp only [Subfield.coe_mul, uq]
      ring) i
  exact (mul_eq_zero.mp h).resolve_right (fun h0 => sw_ne_zero hq0 hq1 hm i (congrArg Subtype.val h0))

theorem exists_uq_coeffs (x : MeroRing K) :
    ∃ e : Fin m → Sm K m, ∑ j, e j • uq hq0 hq1 hm j = x := by
  have hx : x ∈ Vm (K := K) m := by rw [span_tX_pow hm]; trivial
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hx
  refine ⟨fun j => c j * (⟨sw hq0 hq1 hm j, sw_mem hq0 hq1 hm j⟩ : Sm K m)⁻¹, ?_⟩
  rw [← hc]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [smul_Sm, smul_Sm]
  have h0 := sw_ne_zero hq0 hq1 hm j
  simp only [Subfield.coe_mul, Subfield.coe_inv, uq]
  field_simp

include hq0 hq1 hm in
/-- `[F_K(q) : F_K(qᵐ | Xᵐ)] = m` (book, (77)–(78)). -/
theorem relDeg_upper :
    relDeg (FqbarXm K (q ^ m) m) (FqSub K q) = m := by
  have hmz := EntireLaurent.mHol_ne_zero hm
  have h0 : FqbarXm K (q ^ m) m ≤ FqSub K q :=
    (fq_qbar_Xm_subset K q (q ^ m) hq0 hq1 (norm_pow_pos hq0 m) (norm_pow_lt_one hq1 hm) m
      hmz ⟨1, by simp⟩).1
  have hF0S : ∀ x ∈ FqbarXm K (q ^ m) m, x ∈ Sm K m := fun _ ⟨y, _, hy⟩ => ⟨y, hy⟩
  rw [relDeg_eq h0]
  let iA : Algebra (FqbarXm K (q ^ m) m) (FqSub K q) := (Subfield.inclusion h0).toAlgebra
  let : SMul (FqbarXm K (q ^ m) m) (FqSub K q) := iA.toSMul
  let : Module (FqbarXm K (q ^ m) m) (FqSub K q) := iA.toModule
  let v : Fin m → FqSub K q := fun i => ⟨uq hq0 hq1 hm i, uq_mem hq0 hq1 hm i⟩
  have hcoe : ∀ (g : FqbarXm K (q ^ m) m) (y : FqSub K q),
      ((g • y : FqSub K q) : MeroRing K) = (g : MeroRing K) * y := fun _ _ => rfl
  have hli : LinearIndependent (FqbarXm K (q ^ m) m) v := by
    rw [Fintype.linearIndependent_iff]
    intro g hg i
    have h := Fintype.linearIndependent_iff.mp (uq_linearIndependent hq0 hq1 hm)
      (fun j => ⟨(g j : MeroRing K), hF0S _ (g j).2⟩) (by
        have := congrArg (fun z : FqSub K q => (z : MeroRing K)) hg
        simp only [AddSubmonoidClass.coe_finsetSum, hcoe, ZeroMemClass.coe_zero] at this
        rw [← this]
        rfl) i
    have h' : ((g i : FqbarXm K (q ^ m) m) : MeroRing K) = 0 := by
      have := congrArg (fun z : Sm K m => (z : MeroRing K)) h
      simpa using this
    exact Subtype.ext h'
  have hsp : ⊤ ≤ Submodule.span (FqbarXm K (q ^ m) m) (Set.range v) := by
    intro f _
    obtain ⟨e, he⟩ := exists_uq_coeffs hq0 hq1 hm (f : MeroRing K)
    -- the coefficients are fixed by `τ_q`
    set τ := translation K (qU hq0)
    have hτS : ∀ j, τ (e j : MeroRing K) ∈ Sm K m := by
      intro j
      obtain ⟨y, hy⟩ := (e j).2
      refine ⟨translation K (qU hq0 ^ (m : ℤ)) y, ?_⟩
      rw [substPow_translation hmz, hy]
    have hfix : ∀ j, τ (e j : MeroRing K) = e j := by
      have h1 : ∑ j, (⟨τ (e j : MeroRing K), hτS j⟩ - e j : Sm K m) • uq hq0 hq1 hm j = 0 := by
        simp only [sub_smul, Finset.sum_sub_distrib, he]
        rw [sub_eq_zero]
        have := congrArg τ he
        rw [(f.2 (qU hq0) rfl)] at this
        rw [← this, map_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [smul_Sm, smul_Sm, map_mul, uq_mem hq0 hq1 hm j (qU hq0) rfl]
      intro j
      have := Fintype.linearIndependent_iff.mp (uq_linearIndependent hq0 hq1 hm) _ h1 j
      exact sub_eq_zero.mp (congrArg Subtype.val this)
    have hmemF0 : ∀ j, (e j : MeroRing K) ∈ FqbarXm K (q ^ m) m := by
      intro j
      obtain ⟨y, hy⟩ := (e j).2
      refine ⟨y, fun a ha => ?_, hy⟩
      have ha' : a = qU hq0 ^ (m : ℤ) := Units.ext (by simp [ha])
      rw [ha']
      apply substPow_injective hmz
      rw [substPow_translation hmz, hy]
      exact hfix j
    rw [Submodule.mem_span_range_iff_exists_fun]
    refine ⟨fun j => ⟨e j, hmemF0 j⟩, Subtype.ext ?_⟩
    simp only [AddSubmonoidClass.coe_finsetSum, hcoe]
    rw [← he]
    rfl
  rw [Module.finrank_eq_card_basis (Module.Basis.mk hli hsp), Fintype.card_fin]

end degreeUpper

/-- **Theorem XVII (i)**: for `q̄ᵈ = qᵐ` (`d, m > 0`), `[F_K(q) : F_K(q̄ | Xᵐ)] = d m`. -/
theorem relDeg_FqbarXm {q qbar : K} (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) (hqb0 : 0 < ‖qbar‖)
    (hqb1 : ‖qbar‖ < 1) {m d : ℕ} (hm : 0 < m) (hd : 0 < d) (hqd : qbar ^ d = q ^ m) :
    relDeg (FqbarXm K qbar m) (FqSub K q) = d * m := by
  have hmz := EntireLaurent.mHol_ne_zero hm
  have hle1 : FqbarXm K qbar m ≤ FqbarXm K (q ^ m) m := by
    rintro _ ⟨y, hy, rfl⟩
    exact ⟨y, FqSub_bar_le hd hqd hy, rfl⟩
  have hle2 : FqbarXm K (q ^ m) m ≤ FqSub K q :=
    (fq_qbar_Xm_subset K q (q ^ m) hq0 hq1 (norm_pow_pos hq0 m) (norm_pow_lt_one hq1 hm) m
      hmz ⟨1, by simp⟩).1
  rw [relDeg_mul hle1 hle2, relDeg_upper hq0 hq1 hm]
  congr 1
  exact (relDeg_map (substPow K m) (FqSub_bar_le hd hqd)).trans
    (relDeg_FqSub_bar (norm_pow_pos hq0 m) (norm_pow_lt_one hq1 hm) hqb0 hqb1 hd hqd)

variable (K) in
/-- Book, §6, Theorem XVII (i): for `m > 0` a multiple of the order of `q mod^× q̄` (so that
`q̄^d = q^m` with `d > 0`), `[F_K(q) : F_K(q̄|Xᵐ)] = dm`. -/
theorem thmXVII_degree (q qbar : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)
    (hqb0 : 0 < ‖qbar‖) (hqb1 : ‖qbar‖ < 1) (m d : ℕ) (hm : 0 < m) (hd : 0 < d)
    (hqd : qbar ^ d = q ^ m) :
    relDeg (FqbarXm K qbar m) (FqSub K q) = d * m :=
  relDeg_FqbarXm hq0 hq1 hqb0 hqb1 hm hd hqd


/-! ### Theorem XVII (iii): the automorphisms -/

section autos

/-- The reflection commutes with `μ_m`. -/
theorem reflectionM_substPow {m : ℤ} (hm : m ≠ 0) (f : MeroRing K) :
    reflectionM K (substPow K m f) = substPow K m (reflectionM K f) := by
  have key : (reflectionM K : MeroRing K →+* MeroRing K).comp (substPow K m) =
      (substPow K m).comp (reflectionM K : MeroRing K →+* MeroRing K) := by
    apply IsLocalization.ringHom_ext (nonZeroDivisors (holSubring K))
    ext g
    simp only [RingHom.comp_apply, RingEquiv.coe_toRingHom]
    rw [substPow_alg hm, reflectionM_alg, reflectionM_alg, substPow_alg hm]
    congr 1
    refine Subtype.ext (funext fun α => ?_)
    refine congrArg g.1 (Subtype.ext ?_)
    show (α.1⁻¹) ^ m = (α.1 ^ m)⁻¹
    rw [inv_zpow]
  exact congrArg (fun φ : MeroRing K →+* MeroRing K => φ f) key

/-- If `τ_c ℘ = ℘` for the Weierstraß function of period `Q`, then `c ∈ Q^ℤ`. -/
theorem exists_zpow_of_translation_wp {Q : K} (hQ0 : 0 < ‖Q‖) (hQ1 : ‖Q‖ < 1) (c : Kˣ)
    (hwp : translation K c (wpAlg hQ0 hQ1) = wpAlg hQ0 hQ1) : ∃ k : ℤ, (c : K) = Q ^ k := by
  have hc0 : (c : K) ≠ 0 := c.ne_zero
  have h1 := anVal_translation_shift (q := (c : K)) hc0 (one_ne_zero (α := Omega K))
    (wpAlg hQ0 hQ1)
  rw [mul_one, show Units.mk0 (c : K) hc0 = c from Units.ext rfl, hwp, anVal_wpAlg_one] at h1
  have hcΩ : algebraMap K (Omega K) (c : K) ≠ 0 := (map_ne_zero _).mpr hc0
  by_contra hno
  push Not at hno
  have hnc : ¬ ConjModQ K Q 1 (algebraMap K (Omega K) (c : K)) := by
    rw [conjModQ_one_iff (norm_pos_iff.mp hQ0)]
    rintro ⟨k, hk⟩
    exact hno k ((algebraMap K (Omega K)).injective (by rw [hk, map_zpow₀]))
  have h2 := anVal_quot_nonneg hQ0 hQ1 hcΩ hnc (Gw hQ0 hQ1) 2
  rw [← wpAlg_eq_Gw, h1] at h2
  exact absurd h2 (by decide)

variable {q qbar : K} (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) (hqb0 : 0 < ‖qbar‖) (hqb1 : ‖qbar‖ < 1)
  {m d : ℕ} (hm : 0 < m) (hd : 0 < d) (hqd : qbar ^ d = q ^ m)

include hqb0 hqb1 hm in
/-- `τ_u` fixes `F_K(q̄ | Xᵐ)` iff `u ∈ U`, i.e. `uᵐ ∈ q̄^ℤ`. -/
theorem translation_fixes_iff (u : Kˣ) :
    (∀ x ∈ FqbarXm K qbar m, translation K u x = x) ↔
      u ∈ Usub K qbar (norm_pos_iff.mp hqb0) m := by
  have hmz := EntireLaurent.mHol_ne_zero hm
  have hqb0' : qbar ≠ 0 := norm_pos_iff.mp hqb0
  constructor
  · intro h
    have hfix : ∀ g ∈ FqSub K qbar, translation K (u ^ (m : ℤ)) g = g := by
      intro g hg
      apply substPow_injective hmz
      rw [substPow_translation hmz]
      exact h _ ⟨g, hg, rfl⟩
    obtain ⟨k, hk⟩ := exists_zpow_of_translation_fix hqb0 hqb1 _ hfix
    exact ⟨k, by rw [← hk, Units.val_zpow_eq_zpow_val, zpow_natCast]⟩
  · rintro ⟨k, hk⟩ _ ⟨g, hg, rfl⟩
    rw [← substPow_translation hmz]
    congr 1
    have hu : u ^ (m : ℤ) = Units.mk0 qbar hqb0' ^ k :=
      Units.ext (by rw [Units.val_zpow_eq_zpow_val, Units.val_zpow_eq_zpow_val, zpow_natCast,
        hk, Units.val_mk0])
    rw [hu]
    exact translation_zpow_of_periodic rfl hg k

include hqb0 hqb1 hm in
/-- A reflected translation `τ_a ε` never fixes `F_K(q̄ | Xᵐ)`. -/
theorem not_translation_refl_fixes (a : Kˣ)
    (h : ∀ x ∈ FqbarXm K qbar m, translation K a (reflectionM K x) = x) : False := by
  have hmz := EntireLaurent.mHol_ne_zero hm
  have hqb0' : qbar ≠ 0 := norm_pos_iff.mp hqb0
  -- `τ_{aᵐ}` fixes `℘` of period `q̄`, hence `aᵐ ∈ q̄^ℤ`
  have hwp := h _ ⟨wpAlg hqb0 hqb1, wpAlg_mem_Fq hqb0 hqb1, rfl⟩
  rw [reflectionM_substPow hmz, refl_wpAlg, ← substPow_translation hmz] at hwp
  obtain ⟨k, hk⟩ := exists_zpow_of_translation_wp hqb0 hqb1 _ (substPow_injective hmz hwp)
  have hak : a ^ (m : ℤ) = Units.mk0 qbar hqb0' ^ k :=
    Units.ext (by rw [hk, Units.val_zpow_eq_zpow_val, Units.val_mk0])
  -- hence `ε` is trivial on `F_K(q̄)`
  obtain ⟨ε, hεR, hne, -⟩ := reflAlg_eq_eps hqb0 hqb1
  apply hne
  rw [hεR]
  ext g
  have hg := h _ ⟨g, g.2, rfl⟩
  rw [reflectionM_substPow hmz, ← substPow_translation hmz, hak] at hg
  have hrg : reflectionM K (g : MeroRing K) ∈ FqSub K qbar := reflFq_mem qbar g
  rw [translation_zpow_of_periodic rfl hrg k] at hg
  exact substPow_injective hmz hg

include hq0 hq1 hqb0 hqb1 hm hqd in
/-- Book, §6, Theorem XVII (iii): the automorphisms of `F_K(q)` over `F_K(q̄|Xᵐ)` are exactly the
translations `τ_u` with `u ∈ U`. -/
theorem mem_autFixing_iff (φ : FqSub K q ≃+* FqSub K q) :
    φ ∈ autFixing (FqbarXm K qbar m) (FqSub K q) ↔
      ∃ u : Kˣ, u ∈ Usub K qbar (norm_pos_iff.mp hqb0) m ∧
        ∀ x : FqSub K q, (φ x : MeroRing K) = translation K u (x : MeroRing K) := by
  have hmz := EntireLaurent.mHol_ne_zero hm
  have hle : FqbarXm K qbar m ≤ FqSub K q :=
    (fq_qbar_Xm_subset K q qbar hq0 hq1 hqb0 hqb1 m hmz
      ⟨d, by rw [zpow_natCast, zpow_natCast]; exact hqd⟩).1
  constructor
  · intro hφ
    have hK : ∀ c : K, algebraMap K (MeroRing K) c ∈ FqbarXm K qbar m := fun c =>
      ⟨algebraMap K (MeroRing K) c, fun a _ => translation_algebraMap K a c,
        substPow_algebraMapK hmz c⟩
    let Φ : FqSub K q ≃ₐ[K] FqSub K q :=
      AlgEquiv.ofRingEquiv (f := φ) (fun c => hφ (algebraMap K (FqSub K q) c) (hK c))
    obtain ⟨a, ha | ha⟩ := aut_structure hq0 hq1 Φ
    · refine ⟨a, (translation_fixes_iff hqb0 hqb1 hm a).mp ?_,
        fun x => congrArg Subtype.val (ha x)⟩
      intro x hx
      calc translation K a x = ((translationAlg q a ⟨x, hle hx⟩ : FqSub K q) : MeroRing K) := rfl
        _ = (Φ ⟨x, hle hx⟩ : MeroRing K) := (congrArg Subtype.val (ha _)).symm
        _ = x := congrArg Subtype.val (hφ ⟨x, hle hx⟩ hx)
    · exfalso
      refine not_translation_refl_fixes hqb0 hqb1 hm a (fun x hx => ?_)
      calc translation K a (reflectionM K x) =
            ((translationAlg q a (reflAlg q ⟨x, hle hx⟩) : FqSub K q) : MeroRing K) := rfl
        _ = (Φ ⟨x, hle hx⟩ : MeroRing K) := (congrArg Subtype.val (ha _)).symm
        _ = x := congrArg Subtype.val (hφ ⟨x, hle hx⟩ hx)
  · rintro ⟨u, hu, hφ⟩ x hx
    apply Subtype.ext
    rw [hφ]
    exact (translation_fixes_iff hqb0 hqb1 hm u).mpr hu _ hx

end autos

section autGroup

variable {q qbar : K} (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) (hqb0 : 0 < ‖qbar‖) (hqb1 : ‖qbar‖ < 1)
  {m d : ℕ} (hm : 0 < m) (hqd : qbar ^ d = q ^ m)

/-- `u ↦ τ_u`, `U → Aut(F_K(q) | F_K(q̄|Xᵐ))`. -/
noncomputable def translationHom :
    Usub K qbar (norm_pos_iff.mp hqb0) m →* autFixing (FqbarXm K qbar m) (FqSub K q) where
  toFun u := ⟨translationFq q u,
    (mem_autFixing_iff hq0 hq1 hqb0 hqb1 hm hqd _).mpr ⟨u, u.2, fun _ => rfl⟩⟩
  map_one' := Subtype.ext (RingEquiv.ext fun _x => Subtype.ext (translation_one _))
  map_mul' u v := Subtype.ext (RingEquiv.ext fun _x =>
    Subtype.ext (translation_mul (u : Kˣ) (v : Kˣ) _))

theorem translationHom_coe (u : Usub K qbar (norm_pos_iff.mp hqb0) m) :
    ((translationHom hq0 hq1 hqb0 hqb1 hm hqd u : autFixing (FqbarXm K qbar m) (FqSub K q)) :
      FqSub K q ≃+* FqSub K q) = translationFq q u := rfl

theorem translationHom_surjective : Function.Surjective (translationHom hq0 hq1 hqb0 hqb1 hm hqd) := by
  rintro ⟨φ, hφ⟩
  obtain ⟨u, hu, hφu⟩ := (mem_autFixing_iff hq0 hq1 hqb0 hqb1 hm hqd φ).mp hφ
  exact ⟨⟨u, hu⟩, Subtype.ext (RingEquiv.ext fun x => Subtype.ext (hφu x).symm)⟩

/-- The kernel of `u ↦ τ_u` on `U` is the subgroup generated by `q`. -/
theorem translationHom_ker : (translationHom hq0 hq1 hqb0 hqb1 hm hqd).ker =
    (Subgroup.zpowers (Units.mk0 q (norm_pos_iff.mp hq0))).subgroupOf
      (Usub K qbar (norm_pos_iff.mp hqb0) m) := by
  ext ⟨u, hu⟩
  rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, Subgroup.mem_zpowers_iff]
  constructor
  · intro h
    have h' : translationFq q u = 1 := by
      rw [← translationHom_coe hq0 hq1 hqb0 hqb1 hm hqd ⟨u, hu⟩, h]; rfl
    have hfix : ∀ g ∈ FqSub K q, translation K u g = g := by
      intro g hg
      have h2 : translationFq q u ⟨g, hg⟩ = ⟨g, hg⟩ := by
        rw [h']; exact (rfl : (1 : FqSub K q ≃+* FqSub K q) ⟨g, hg⟩ = ⟨g, hg⟩)
      exact congrArg Subtype.val h2
    obtain ⟨k, hk⟩ := exists_zpow_of_translation_fix hq0 hq1 u hfix
    exact ⟨k, Units.ext (by rw [Units.val_zpow_eq_zpow_val, Units.val_mk0, hk])⟩
  · rintro ⟨k, hk⟩
    refine Subtype.ext (RingEquiv.ext fun x => Subtype.ext ?_)
    rw [translationHom_coe]
    show translation K u x = x
    rw [← show (Units.mk0 q (norm_pos_iff.mp hq0)) ^ k = u from hk]
    exact translation_zpow_of_periodic rfl x.2 k

end autGroup

variable (K) in
/-- Book, §6, Theorem XVII (iii): the automorphisms of `F_K(q)` over `F_K(q̄|Xᵐ)` are the
translations `τ_u`, `u ∈ U`, and the automorphism group is `U/q`. (The book writes `u^m ≡ 1 mod^× q`;
the proof and Corollary XIXa show that `q̄` is meant.) -/
theorem thmXVII_automorphisms (q qbar : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)
    (hqb0 : 0 < ‖qbar‖) (hqb1 : ‖qbar‖ < 1) (m d : ℕ) (hm : 0 < m) (_hd : 0 < d)
    (hqd : qbar ^ d = q ^ m) :
    (∀ φ : FqSub K q ≃+* FqSub K q, φ ∈ autFixing (FqbarXm K qbar m) (FqSub K q) ↔
      ∃ u : Kˣ, u ∈ Usub K qbar (norm_pos_iff.mp hqb0) m ∧
        ∀ x : FqSub K q, (φ x : MeroRing K) = translation K u (x : MeroRing K)) ∧
    Nonempty (autFixing (FqbarXm K qbar m) (FqSub K q) ≃*
      (Usub K qbar (norm_pos_iff.mp hqb0) m ⧸
        (Subgroup.zpowers (Units.mk0 q (norm_pos_iff.mp hq0))).subgroupOf
          (Usub K qbar (norm_pos_iff.mp hqb0) m))) :=
  ⟨mem_autFixing_iff hq0 hq1 hqb0 hqb1 hm hqd,
    ⟨((QuotientGroup.quotientMulEquivOfEq (translationHom_ker hq0 hq1 hqb0 hqb1 hm hqd)).symm.trans
      (QuotientGroup.quotientKerEquivOfSurjective _
        (translationHom_surjective hq0 hq1 hqb0 hqb1 hm hqd))).symm⟩⟩

/-! ### Theorem XVII (iv): counting `U/q` -/

section counting

variable {q qbar : K} (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) (hqb0 : 0 < ‖qbar‖) (hqb1 : ‖qbar‖ < 1)
  {m d : ℕ} (hm : 0 < m) (hd : 0 < d) (hqd : qbar ^ d = q ^ m)

include hqb0 hqb1 in
omit [IsUltrametricDist K] [CompleteSpace K] in
theorem zpow_qbar_injective {a b : ℤ} (h : qbar ^ a = qbar ^ b) : a = b := by
  have := congrArg norm h
  rw [norm_zpow, norm_zpow] at this
  exact zpow_right_injective₀ hqb0 hqb1.ne this

/-- The exponent `ψ(u)` with `uᵐ = q̄^{ψ(u)}`. -/
noncomputable def psiExp (u : Usub K qbar (norm_pos_iff.mp hqb0) m) : ℤ := Classical.choose u.2

omit [IsUltrametricDist K] [CompleteSpace K] in
theorem psiExp_spec (u : Usub K qbar (norm_pos_iff.mp hqb0) m) :
    ((u : Kˣ) : K) ^ m = qbar ^ psiExp hqb0 u := Classical.choose_spec u.2

include hqb1 in
theorem psiExp_eq {u : Usub K qbar (norm_pos_iff.mp hqb0) m} {k : ℤ}
    (h : ((u : Kˣ) : K) ^ m = qbar ^ k) : psiExp hqb0 u = k :=
  zpow_qbar_injective hqb0 hqb1 ((psiExp_spec hqb0 u).symm.trans h)

/-- `ψ : U → ℤ`, `uᵐ = q̄^{ψ(u)}`. -/
noncomputable def psiHom : Usub K qbar (norm_pos_iff.mp hqb0) m →* Multiplicative ℤ where
  toFun u := Multiplicative.ofAdd (psiExp hqb0 u)
  map_one' := by
    rw [psiExp_eq hqb0 hqb1 (k := 0) (by simp)]; rfl
  map_mul' u v := by
    rw [psiExp_eq hqb0 hqb1 (k := psiExp hqb0 u + psiExp hqb0 v) (by
      rw [Subgroup.coe_mul, Units.val_mul, mul_pow, psiExp_spec, psiExp_spec,
        zpow_add₀ (norm_pos_iff.mp hqb0)])]
    rfl

theorem mem_ker_psiHom (u : Usub K qbar (norm_pos_iff.mp hqb0) m) :
    u ∈ (psiHom hqb0 hqb1 (m := m)).ker ↔ ((u : Kˣ) : K) ^ m = 1 := by
  rw [MonoidHom.mem_ker]
  constructor
  · intro h
    have h' : psiExp hqb0 u = 0 := congrArg Multiplicative.toAdd h
    rw [psiExp_spec hqb0 u, h', zpow_zero]
  · intro h
    show Multiplicative.ofAdd (psiExp hqb0 u) = Multiplicative.ofAdd 0
    rw [psiExp_eq hqb0 hqb1 (k := 0) (by rw [h, zpow_zero])]

include hqb1 in
theorem card_ker_psiHom :
    Nat.card (psiHom hqb0 hqb1 (m := m)).ker = Nat.card (rootsOfUnity m K) := by
  refine Nat.card_congr
    { toFun := fun u => ⟨(u : Usub K qbar (norm_pos_iff.mp hqb0) m), ?_⟩
      invFun := fun w => ⟨⟨w, ⟨0, ?_⟩⟩, ?_⟩
      left_inv := fun u => rfl
      right_inv := fun w => rfl }
  · rw [mem_rootsOfUnity]; apply Units.ext
    rw [Units.val_pow_eq_pow_val, (mem_ker_psiHom hqb0 hqb1 _).mp u.2, Units.val_one]
  · rw [zpow_zero]
    have := (mem_rootsOfUnity m (w : Kˣ)).mp w.2
    rw [← Units.val_pow_eq_pow_val, this, Units.val_one]
  · rw [mem_ker_psiHom]
    have := (mem_rootsOfUnity m (w : Kˣ)).mp w.2
    rw [← Units.val_pow_eq_pow_val, this, Units.val_one]

/-- The subgroup `⟨q⟩ ⊆ U`. -/
noncomputable abbrev qSub : Subgroup (Usub K qbar (norm_pos_iff.mp hqb0) m) :=
  (Subgroup.zpowers (Units.mk0 q (norm_pos_iff.mp hq0))).subgroupOf
    (Usub K qbar (norm_pos_iff.mp hqb0) m)

include hq1 hm hqd in
theorem qSub_inf_ker : qSub hq0 hqb0 (m := m) ⊓ (psiHom hqb0 hqb1 (m := m)).ker = ⊥ := by
  rw [eq_bot_iff]
  rintro ⟨u, hu⟩ hx
  obtain ⟨h1, h2⟩ := Subgroup.mem_inf.mp hx
  rw [Subgroup.mem_subgroupOf, Subgroup.mem_zpowers_iff] at h1
  obtain ⟨k, hk⟩ := h1
  have hk' : Units.mk0 q (norm_pos_iff.mp hq0) ^ k = u := hk
  have h2' := (mem_ker_psiHom hqb0 hqb1 _).mp h2
  try simp only at h2'
  rw [← hk', Units.val_zpow_eq_zpow_val, Units.val_mk0, ← zpow_natCast, ← zpow_mul] at h2'
  have hk0 : k * m = 0 := by
    have := congrArg norm h2'
    rw [norm_zpow, norm_one] at this
    exact zpow_right_injective₀ hq0 hq1.ne (by simp only; rw [this, zpow_zero])
  have : k = 0 := by
    rcases mul_eq_zero.mp hk0 with h | h
    · exact h
    · exact absurd h (by exact_mod_cast hm.ne')
  rw [Subgroup.mem_bot]
  apply Subtype.ext
  show u = 1
  rw [← hk', this, zpow_zero]

include hqd in
omit [IsUltrametricDist K] [CompleteSpace K] in
theorem qU_mem_Usub : Units.mk0 q (norm_pos_iff.mp hq0) ∈ Usub K qbar (norm_pos_iff.mp hqb0) m :=
  ⟨d, by rw [Units.val_mk0, ← hqd, zpow_natCast]⟩

include hqd in
theorem map_qSub : (qSub hq0 hqb0 (m := m)).map (psiHom hqb0 hqb1 (m := m)) =
    Subgroup.zpowers (Multiplicative.ofAdd (d : ℤ)) := by
  have hmem := qU_mem_Usub hq0 hqb0 hqd
  have hgen : qSub hq0 hqb0 (m := m) =
      Subgroup.zpowers (⟨Units.mk0 q (norm_pos_iff.mp hq0), hmem⟩ :
        Usub K qbar (norm_pos_iff.mp hqb0) m) := by
    ext ⟨u, hu⟩
    rw [Subgroup.mem_subgroupOf, Subgroup.mem_zpowers_iff, Subgroup.mem_zpowers_iff]
    constructor
    · rintro ⟨k, hk⟩; exact ⟨k, Subtype.ext hk⟩
    · rintro ⟨k, hk⟩; exact ⟨k, congrArg Subtype.val hk⟩
  rw [hgen, MonoidHom.map_zpowers]
  congr 1
  show Multiplicative.ofAdd (psiExp hqb0 _) = _
  rw [psiExp_eq hqb0 hqb1 (k := d) (by rw [Units.val_mk0, ← hqd, zpow_natCast])]

theorem index_zpowers_ofAdd (n : ℕ) :
    (Subgroup.zpowers (Multiplicative.ofAdd (n : ℤ))).index = n := by
  have : Subgroup.zpowers (Multiplicative.ofAdd (n : ℤ)) =
      AddSubgroup.toSubgroup (AddSubgroup.zmultiples (n : ℤ)) := by
    ext x
    show x ∈ Subgroup.zpowers _ ↔ Multiplicative.toAdd x ∈ AddSubgroup.zmultiples (n : ℤ)
    rw [Subgroup.mem_zpowers_iff, AddSubgroup.mem_zmultiples_iff]
    constructor
    · rintro ⟨k, rfl⟩; exact ⟨k, by simp⟩
    · rintro ⟨k, hk⟩; exact ⟨k, by rw [← ofAdd_zsmul, hk]; rfl⟩
  rw [this, AddSubgroup.index_toSubgroup, Int.index_zmultiples, Int.natAbs_natCast]

include hq1 hm hqd in
/-- `|U/⟨q⟩| · [ℤ : ψ(U)] = |μ_m(K)| · d`. -/
theorem card_quot_mul_index :
    Nat.card (Usub K qbar (norm_pos_iff.mp hqb0) m ⧸ qSub hq0 hqb0 (m := m)) *
      (psiHom hqb0 hqb1 (m := m)).range.index = Nat.card (rootsOfUnity m K) * d := by
  set ψ := psiHom hqb0 hqb1 (m := m)
  set H := qSub hq0 hqb0 (m := m)
  rw [← Subgroup.index_eq_card]
  have h1 := Subgroup.relIndex_mul_index (le_sup_left : H ≤ H ⊔ ψ.ker)
  have h2 : H.relIndex (H ⊔ ψ.ker) = Nat.card ψ.ker := by
    rw [Subgroup.relIndex_sup_left]
    rw [Subgroup.relIndex, show H.subgroupOf ψ.ker = ⊥ from by
      rw [eq_bot_iff]
      rintro ⟨u, hu⟩ hH
      rw [Subgroup.mem_subgroupOf] at hH
      have : u ∈ H ⊓ ψ.ker := ⟨hH, hu⟩
      rw [qSub_inf_ker hq0 hq1 hqb0 hqb1 hm hqd, Subgroup.mem_bot] at this
      rw [Subgroup.mem_bot]; exact Subtype.ext (by simp [this])]
    exact Subgroup.index_bot
  have h3 : (H ⊔ ψ.ker).index = (H.map ψ).relIndex ψ.range := by
    rw [← Subgroup.comap_map_eq, Subgroup.index_comap]
  have h4 := Subgroup.relIndex_mul_index (Subgroup.map_le_range ψ H)
  rw [map_qSub hq0 hqb0 hqb1 hqd, index_zpowers_ofAdd] at h4
  rw [map_qSub hq0 hqb0 hqb1 hqd] at h3
  rw [← h1, h2, h3, mul_assoc, h4, card_ker_psiHom hqb0 hqb1]

include hqb1 hm in
/-- `ψ(U) = ℤ` iff `q̄` is an `m`-th power in `K`. -/
theorem range_psiHom_eq_top_iff :
    (psiHom hqb0 hqb1 (m := m)).range = ⊤ ↔ ∃ r : K, r ^ m = qbar := by
  constructor
  · intro h
    have : Multiplicative.ofAdd (1 : ℤ) ∈ (psiHom hqb0 hqb1 (m := m)).range := by rw [h]; trivial
    obtain ⟨u, hu⟩ := this
    refine ⟨((u : Kˣ) : K), ?_⟩
    rw [psiExp_spec hqb0 u, show psiExp hqb0 u = 1 from congrArg Multiplicative.toAdd hu, zpow_one]
  · rintro ⟨r, hr⟩
    have hr0 : r ≠ 0 := by
      rintro rfl; rw [zero_pow hm.ne'] at hr; exact (norm_pos_iff.mp hqb0) hr.symm
    have hmem : Units.mk0 r hr0 ∈ Usub K qbar (norm_pos_iff.mp hqb0) m :=
      ⟨1, by rw [Units.val_mk0, hr, zpow_one]⟩
    have h1 : psiHom hqb0 hqb1 ⟨_, hmem⟩ = Multiplicative.ofAdd (1 : ℤ) := by
      show Multiplicative.ofAdd (psiExp hqb0 _) = _
      rw [psiExp_eq hqb0 hqb1 (k := 1) (by rw [Units.val_mk0, hr, zpow_one])]
    rw [eq_top_iff]
    intro x _
    have hx : x = (Multiplicative.ofAdd (1 : ℤ)) ^ (Multiplicative.toAdd x) := by
      rw [← ofAdd_zsmul, smul_eq_mul, mul_one]; rfl
    rw [hx, ← h1]
    exact Subgroup.zpow_mem _ (MonoidHom.mem_range.mpr ⟨_, rfl⟩) _

end counting

/-- Ring automorphisms of `F` fixing a subfield `F₀` are the `F₀`-algebra automorphisms. -/
noncomputable def autFixingEquiv {M : Type*} [Field M] {E F : Subfield M} (h : E ≤ F) :
    (letI := (Subfield.inclusion h).toAlgebra; F ≃ₐ[E] F) ≃ autFixing E F :=
  letI := (Subfield.inclusion h).toAlgebra
  { toFun := fun φ => ⟨φ.toRingEquiv, fun x hx => by
      have := φ.commutes ⟨x, hx⟩
      convert this using 1 <;> rfl⟩
    invFun := fun ψ => AlgEquiv.ofRingEquiv (f := ψ.1) (fun c => ψ.2 _ c.2)
    left_inv := fun φ => by ext x; rfl
    right_inv := fun ψ => by ext x; rfl }

variable (K) in
/-- Book, §6, Theorem XVII (iv): `F_K(q)` is Galois over `F_K(q̄|Xᵐ)` iff `p ∤ m`, `K` contains the
`m`-th roots of unity, and `q̄` is an `m`-th power in `K`. -/
theorem thmXVII_galois (q qbar : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)
    (hqb0 : 0 < ‖qbar‖) (hqb1 : ‖qbar‖ < 1) (m d : ℕ) (hm : 0 < m) (hd : 0 < d)
    (hqd : qbar ^ d = q ^ m) :
    IsRelGalois (FqbarXm K qbar m) (FqSub K q) ↔
      (¬ (ringChar K ∣ m) ∧ (∃ ζ : K, IsPrimitiveRoot ζ m) ∧ ∃ r : K, r ^ m = qbar) := by
  have : NeZero m := ⟨hm.ne'⟩
  have hmz := EntireLaurent.mHol_ne_zero hm
  have hle : FqbarXm K qbar m ≤ FqSub K q :=
    (fq_qbar_Xm_subset K q qbar hq0 hq1 hqb0 hqb1 m hmz
      ⟨d, by rw [zpow_natCast, zpow_natCast]; exact hqd⟩).1
  let := (Subfield.inclusion hle).toAlgebra
  have hdeg : Module.finrank (FqbarXm K qbar m) (FqSub K q) = d * m := by
    rw [← relDeg_eq hle]; exact relDeg_FqbarXm hq0 hq1 hqb0 hqb1 hm hd hqd
  have : FiniteDimensional (FqbarXm K qbar m) (FqSub K q) :=
    Module.finite_of_finrank_pos (by rw [hdeg]; positivity)
  -- the number of automorphisms is `|U/q|`
  obtain ⟨e⟩ := (thmXVII_automorphisms K q qbar hq0 hq1 hqb0 hqb1 m d hm hd hqd).2
  have hcard : Nat.card (FqSub K q ≃ₐ[FqbarXm K qbar m] FqSub K q) =
      Nat.card (Usub K qbar (norm_pos_iff.mp hqb0) m ⧸ qSub hq0 hqb0 (m := m)) :=
    (Nat.card_congr (autFixingEquiv hle)).trans (Nat.card_congr e.toEquiv)
  have hcount := card_quot_mul_index hq0 hq1 hqb0 hqb1 hm hqd
  have hW : Nat.card (rootsOfUnity m K) ≤ m := by
    exact card_rootsOfUnity K m
  have hW1 : 1 ≤ Nat.card (rootsOfUnity m K) := Nat.card_pos (α := rootsOfUnity m K)
  have hgal : IsRelGalois (FqbarXm K qbar m) (FqSub K q) ↔
      Nat.card (FqSub K q ≃ₐ[FqbarXm K qbar m] FqSub K q) = d * m := by
    constructor
    · rintro ⟨h', hG⟩
      have : IsGalois (FqbarXm K qbar m) (FqSub K q) := hG
      rw [← hdeg]
      exact IsGalois.card_aut_eq_finrank (FqbarXm K qbar m) (FqSub K q)
    · intro h
      refine ⟨hle, ?_⟩
      exact IsGalois.of_card_aut_eq_finrank (FqbarXm K qbar m) (FqSub K q) (h.trans hdeg.symm)
  rw [hgal, hcard]
  set N := Nat.card (Usub K qbar (norm_pos_iff.mp hqb0) m ⧸ qSub hq0 hqb0 (m := m))
  set i := (psiHom hqb0 hqb1 (m := m)).range.index
  set W := Nat.card (rootsOfUnity m K)
  have hroots : W = m ↔ ∃ ζ : K, IsPrimitiveRoot ζ m := by
    show Nat.card (rootsOfUnity m K) = m ↔ _
    exact card_rootsOfUnity_eq_iff_exists_isPrimitiveRoot
  have hi1 : i = 1 ↔ ∃ r : K, r ^ m = qbar := by
    rw [Subgroup.index_eq_one]; exact range_psiHom_eq_top_iff hqb0 hqb1 hm
  have hchar : (∃ ζ : K, IsPrimitiveRoot ζ m) → ¬ (ringChar K ∣ m) := by
    rintro ⟨ζ, hζ⟩ hdvd
    have := hζ.neZero'
    exact NeZero.ne ((m : ℕ) : K) ((ringChar.spec K m).mpr hdvd)
  constructor
  · intro hN
    rw [hN] at hcount
    have hi0 : i ≠ 0 := by
      intro h0; rw [h0, mul_zero] at hcount
      exact absurd hcount.symm (Nat.mul_ne_zero (by omega) hd.ne')
    have hmi : m * i = W := by
      have : d * (m * i) = d * W := by rw [← mul_assoc, hcount, mul_comm]
      exact Nat.eq_of_mul_eq_mul_left hd this
    have hi : i = 1 := by
      by_contra hne
      have : 2 ≤ i := by omega
      nlinarith
    rw [hi, mul_one] at hmi
    have hζ := hroots.mp hmi.symm
    exact ⟨hchar hζ, hζ, hi1.mp hi⟩
  · rintro ⟨-, hζ, hr⟩
    have hW' := hroots.mpr hζ
    have hi := hi1.mpr hr
    rw [hi, mul_one, hW'] at hcount
    rw [hcount, mul_comm]

/-! ### Theorem XVII (ii): separability and inseparability -/

section separability

variable {M : Type*} [Field M]

theorem isRelSeparable_map {M' : Type*} [Field M'] (μ : M →+* M') {E F : Subfield M}
    (h : IsRelSeparable E F) : IsRelSeparable (E.map μ) (F.map μ) := by
  obtain ⟨hle, hsep⟩ := h
  have hle' : E.map μ ≤ F.map μ := fun _ ⟨y, hy, hyx⟩ => ⟨y, hle hy, hyx⟩
  refine ⟨hle', ?_⟩
  let : Algebra E F := (Subfield.inclusion hle).toAlgebra
  let : Algebra (E.map μ) (F.map μ) := (Subfield.inclusion hle').toAlgebra
  exact Algebra.IsSeparable.of_equiv_equiv (subfieldMapEquiv μ E) (subfieldMapEquiv μ F)
    (by ext x; rfl)

theorem isRelSeparable_trans {E E' F : Subfield M} (h1 : IsRelSeparable E E')
    (h2 : IsRelSeparable E' F) : IsRelSeparable E F := by
  obtain ⟨hle1, hs1⟩ := h1
  obtain ⟨hle2, hs2⟩ := h2
  refine ⟨hle1.trans hle2, ?_⟩
  let : Algebra E E' := (Subfield.inclusion hle1).toAlgebra
  let : Algebra E' F := (Subfield.inclusion hle2).toAlgebra
  let : Algebra E F := (Subfield.inclusion (hle1.trans hle2)).toAlgebra
  have : IsScalarTower E E' F := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  exact Algebra.IsSeparable.trans E E' F

theorem relInsepDeg_eq {E F : Subfield M} (h : E ≤ F) :
    relInsepDeg E F = letI := (Subfield.inclusion h).toAlgebra; Field.finInsepDegree E F := by
  rw [relInsepDeg, dite_eq_left h]

/-- Tower law for inseparable degrees. -/
theorem relInsepDeg_mul {E E' F : Subfield M} (h1 : E ≤ E') (h2 : E' ≤ F)
    (hfin : 0 < relDeg E E') :
    relInsepDeg E F = relInsepDeg E E' * relInsepDeg E' F := by
  rw [relInsepDeg_eq h1, relInsepDeg_eq h2, relInsepDeg_eq (h1.trans h2)]
  let : Algebra E E' := (Subfield.inclusion h1).toAlgebra
  let : Algebra E' F := (Subfield.inclusion h2).toAlgebra
  let : Algebra E F := (Subfield.inclusion (h1.trans h2)).toAlgebra
  have : IsScalarTower E E' F := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  rw [relDeg_eq h1] at hfin
  have : FiniteDimensional E E' := Module.finite_of_finrank_pos hfin
  exact (Field.finInsepDegree_mul_finInsepDegree_of_isAlgebraic E E' F).symm

theorem relInsepDeg_eq_one {E F : Subfield M} (h : IsRelSeparable E F) : relInsepDeg E F = 1 := by
  obtain ⟨hle, hs⟩ := h
  rw [relInsepDeg_eq hle]
  let : Algebra E F := (Subfield.inclusion hle).toAlgebra
  exact (isSeparable_iff_finInsepDegree_eq_one E F).mp hs

theorem relInsepDeg_eq_relDeg {E F : Subfield M} (h : IsRelPurelyInseparable E F) :
    relInsepDeg E F = relDeg E F := by
  obtain ⟨hle, hs⟩ := h
  rw [relInsepDeg_eq hle, relDeg_eq hle]
  let : Algebra E F := (Subfield.inclusion hle).toAlgebra
  exact IsPurelyInseparable.finInsepDegree_eq E F

end separability

section substFacts

theorem substPow_one : substPow K 1 = RingHom.id (MeroRing K) := by
  apply IsLocalization.ringHom_ext (nonZeroDivisors (holSubring K))
  ext g
  simp only [RingHom.comp_apply, RingHom.id_apply]
  rw [substPow_alg one_ne_zero]
  congr 1
  exact Subtype.ext (funext fun α => congrArg g.1 (Subtype.ext (zpow_one _)))

theorem FqbarXm_one (Q : K) : FqbarXm K Q 1 = FqSub K Q := by
  rw [FqbarXm, substPow_one]
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩; exact hy
  · intro hx; exact ⟨x, hx, rfl⟩

/-- `μ_{ab} = μ_b ∘ μ_a`. -/
theorem substPow_mul {a b : ℤ} (ha : a ≠ 0) (hb : b ≠ 0) :
    substPow K (a * b) = (substPow K b).comp (substPow K a) := by
  apply IsLocalization.ringHom_ext (nonZeroDivisors (holSubring K))
  ext g
  simp only [RingHom.comp_apply]
  rw [substPow_alg (mul_ne_zero ha hb), substPow_alg ha, substPow_alg hb]
  congr 1
  refine Subtype.ext (funext fun α => congrArg g.1 (Subtype.ext ?_))
  show α.1 ^ (a * b) = (α.1 ^ b) ^ a
  rw [← zpow_mul, mul_comm]

theorem FqbarXm_mul (Q : K) {a b : ℤ} (ha : a ≠ 0) (hb : b ≠ 0) :
    FqbarXm K Q (a * b) = (FqbarXm K Q a).map (substPow K b) := by
  rw [FqbarXm, FqbarXm, substPow_mul ha hb, Subfield.map_map]

/-- Formula (78): `μ_n(M_K) ∩ F_K(q) ⊆ F_K(qⁿ | Xⁿ)`. -/
theorem mem_FqbarXm_of_mem_Sm {q : K} (hq0 : 0 < ‖q‖) {n : ℕ} (hn : 0 < n) {x : MeroRing K}
    (hS : x ∈ Sm K n) (hF : x ∈ FqSub K q) : x ∈ FqbarXm K (q ^ n) n := by
  have hnz := EntireLaurent.mHol_ne_zero hn
  obtain ⟨y, rfl⟩ := hS
  refine ⟨y, fun a ha => ?_, rfl⟩
  have ha' : a = qU hq0 ^ (n : ℤ) := Units.ext (by simp [ha])
  rw [ha']
  apply substPow_injective hnz
  rw [substPow_translation hnz]
  exact hF (qU hq0) rfl

end substFacts

section sepUpper

/-- Every `f ∈ F_K(q)` is `∑ eⱼ uⱼ` with coefficients `eⱼ ∈ F_K(qᵐ | Xᵐ)`. -/
theorem exists_F0_coeffs {q : K} (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) {m : ℕ} (hm : 0 < m)
    {f : MeroRing K} (hf : f ∈ FqSub K q) :
    ∃ e : Fin m → MeroRing K, (∀ j, e j ∈ FqbarXm K (q ^ m) m) ∧
      ∑ j, e j * uq hq0 hq1 hm j = f := by
  have hmz := EntireLaurent.mHol_ne_zero hm
  obtain ⟨e, he⟩ := exists_uq_coeffs hq0 hq1 hm f
  set τ := translation K (qU hq0)
  have hτS : ∀ j, τ (e j : MeroRing K) ∈ Sm K m := by
    intro j
    obtain ⟨y, hy⟩ := (e j).2
    refine ⟨translation K (qU hq0 ^ (m : ℤ)) y, ?_⟩
    rw [substPow_translation hmz, hy]
  have hfix : ∀ j, τ (e j : MeroRing K) = e j := by
    have h1 : ∑ j, (⟨τ (e j : MeroRing K), hτS j⟩ - e j : Sm K m) • uq hq0 hq1 hm j = 0 := by
      simp only [sub_smul, Finset.sum_sub_distrib, he]
      rw [sub_eq_zero]
      have := congrArg τ he
      rw [hf (qU hq0) rfl] at this
      rw [← this, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [smul_Sm, smul_Sm, map_mul, uq_mem hq0 hq1 hm j (qU hq0) rfl]
    intro j
    have := Fintype.linearIndependent_iff.mp (uq_linearIndependent hq0 hq1 hm) _ h1 j
    exact sub_eq_zero.mp (congrArg Subtype.val this)
  refine ⟨fun j => e j, fun j => ?_, he⟩
  obtain ⟨y, hy⟩ := (e j).2
  refine ⟨y, fun a ha => ?_, hy⟩
  have ha' : a = qU hq0 ^ (m : ℤ) := Units.ext (by simp [ha])
  rw [ha']
  apply substPow_injective hmz
  rw [substPow_translation hmz, hy]
  exact hfix j

theorem uq_ne_zero {q : K} (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) {m : ℕ} (hm : 0 < m) (i : ℕ) :
    uq hq0 hq1 hm i ≠ 0 :=
  mul_ne_zero (pow_ne_zero _ tX_ne_zero) (sw_ne_zero hq0 hq1 hm i)

theorem uq_pow_mem {q : K} (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) {m : ℕ} (hm : 0 < m) (i : ℕ) :
    uq hq0 hq1 hm i ^ m ∈ FqbarXm K (q ^ m) m := by
  refine mem_FqbarXm_of_mem_Sm hq0 hm ?_ (pow_mem (uq_mem hq0 hq1 hm i) m)
  have e : uq hq0 hq1 hm i ^ m = (tX K ^ m) ^ i * sw hq0 hq1 hm i ^ m := by
    unfold uq; rw [mul_pow, ← pow_mul, ← pow_mul, mul_comm i m]
  rw [e]
  exact mul_mem (pow_mem (tX_pow_mem hm) i) (pow_mem (sw_mem hq0 hq1 hm i) m)

/-- `F_K(q)` is separable over `F_K(qⁿ | Xⁿ)` when `n ≠ 0` in `K`. -/
theorem isRelSeparable_upper {q : K} (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) {n : ℕ} (hn : 0 < n)
    (hnK : (n : K) ≠ 0) : IsRelSeparable (FqbarXm K (q ^ n) n) (FqSub K q) := by
  have hnz := EntireLaurent.mHol_ne_zero hn
  have h0 : FqbarXm K (q ^ n) n ≤ FqSub K q :=
    (fq_qbar_Xm_subset K q (q ^ n) hq0 hq1 (norm_pow_pos hq0 n) (norm_pow_lt_one hq1 hn) n
      hnz ⟨1, by simp⟩).1
  refine ⟨h0, ?_⟩
  let iA : Algebra (FqbarXm K (q ^ n) n) (FqSub K q) := (Subfield.inclusion h0).toAlgebra
  have hnE : ((n : ℕ) : FqbarXm K (q ^ n) n) ≠ 0 := by
    intro h
    apply hnK
    have := congrArg (fun z : FqbarXm K (q ^ n) n => (z : MeroRing K)) h
    simp only [SubringClass.coe_natCast, ZeroMemClass.coe_zero] at this
    exact (algebraMap K (MeroRing K)).injective (by rw [map_natCast, map_zero]; exact this)
  have hu : ∀ i, IsSeparable (FqbarXm K (q ^ n) n)
      (⟨uq hq0 hq1 hn i, uq_mem hq0 hq1 hn i⟩ : FqSub K q) := by
    intro i
    set c : FqbarXm K (q ^ n) n := ⟨_, uq_pow_mem hq0 hq1 hn i⟩
    have hc0 : c ≠ 0 := by
      intro h
      have := congrArg (fun z : FqbarXm K (q ^ n) n => (z : MeroRing K)) h
      exact pow_ne_zero n (uq_ne_zero hq0 hq1 hn i) this
    have hsep := Polynomial.separable_X_pow_sub_C c hnE hc0
    refine hsep.of_dvd (minpoly.dvd _ _ ?_)
    rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero]
    exact Subtype.ext rfl
  constructor
  intro f
  obtain ⟨e, he, hsum⟩ := exists_F0_coeffs hq0 hq1 hn f.2
  have hf : f = ∑ j : Fin n, algebraMap (FqbarXm K (q ^ n) n) (FqSub K q) ⟨e j, he j⟩ *
      ⟨uq hq0 hq1 hn j, uq_mem hq0 hq1 hn j⟩ := by
    apply Subtype.ext
    rw [← hsum]
    simp only [AddSubmonoidClass.coe_finsetSum, MulMemClass.coe_mul]
    rfl
  rw [hf]
  refine Finset.sum_induction _ (IsSeparable (FqbarXm K (q ^ n) n))
    (fun a b ha hb => Field.isSeparable_add ha hb) ?_ (fun j _ => ?_)
  · simpa using isSeparable_algebraMap (F := FqbarXm K (q ^ n) n) (K := FqSub K q) 0
  · exact Field.isSeparable_mul (isSeparable_algebraMap _) (hu j)

end sepUpper

section pureInsep

variable {p : ℕ} [hp : Fact p.Prime] [CharP K p]

instance charP_mero : CharP (MeroRing K) p :=
  charP_of_injective_algebraMap (algebraMap K (MeroRing K)).injective p

/-- In characteristic `p`, `F_K(q)` is purely inseparable over `F_K(q^{pᵛ} | X^{pᵛ})`. -/
theorem isRelPurelyInseparable_upper {q : K} (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) (v : ℕ) :
    IsRelPurelyInseparable (FqbarXm K (q ^ (p ^ v)) ((p ^ v : ℕ) : ℤ)) (FqSub K q) := by
  have hn : 0 < p ^ v := pow_pos hp.out.pos v
  have hnz := EntireLaurent.mHol_ne_zero hn
  have h0 : FqbarXm K (q ^ (p ^ v)) ((p ^ v : ℕ) : ℤ) ≤ FqSub K q :=
    (fq_qbar_Xm_subset K q (q ^ (p ^ v)) hq0 hq1 (norm_pow_pos hq0 _) (norm_pow_lt_one hq1 hn)
      _ hnz ⟨1, by rw [zpow_one, zpow_natCast]⟩).1
  refine ⟨h0, ?_⟩
  let : Algebra (FqbarXm K (q ^ (p ^ v)) ((p ^ v : ℕ) : ℤ)) (FqSub K q) :=
    (Subfield.inclusion h0).toAlgebra
  have : CharP (FqbarXm K (q ^ (p ^ v)) ((p ^ v : ℕ) : ℤ)) p := by
    rw [CharP.charP_iff_prime_eq_zero hp.out]
    apply Subtype.ext
    simp only [SubringClass.coe_natCast, ZeroMemClass.coe_zero]
    exact CharP.cast_eq_zero (MeroRing K) p
  rw [isPurelyInseparable_iff_pow_mem _ p]
  intro f
  refine ⟨v, ?_⟩
  obtain ⟨e, he, hsum⟩ := exists_F0_coeffs hq0 hq1 hn f.2
  have hmem : ((f : MeroRing K)) ^ p ^ v ∈ FqbarXm K (q ^ (p ^ v)) ((p ^ v : ℕ) : ℤ) := by
    rw [← hsum, sum_pow_char_pow]
    refine sum_mem (fun j _ => ?_)
    rw [mul_pow]
    exact mul_mem (pow_mem (he j) _) (uq_pow_mem hq0 hq1 hn j)
  exact ⟨⟨_, hmem⟩, Subtype.ext (by simp; rfl)⟩

end pureInsep

variable (K) in
/-- Book, §6, Theorem XVII (ii): the degree of inseparability of `F_K(q) | F_K(q̄|Xᵐ)` is the
largest power `p^r` of the characteristic dividing `m`, with maximal separable subextension
`F_K(q^{p^r} | X^{p^r})`. -/
theorem thmXVII_inseparability (q qbar : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)
    (hqb0 : 0 < ‖qbar‖) (hqb1 : ‖qbar‖ < 1) (m d : ℕ) (hm : 0 < m) (hd : 0 < d)
    (hqd : qbar ^ d = q ^ m) :
    relInsepDeg (FqbarXm K qbar m) (FqSub K q) = ringChar K ^ (m.factorization (ringChar K)) ∧
    IsRelSeparable (FqbarXm K qbar m)
      (FqbarXm K (q ^ (ringChar K ^ (m.factorization (ringChar K))))
        ((ringChar K ^ (m.factorization (ringChar K)) : ℕ) : ℤ)) ∧
    IsRelPurelyInseparable
      (FqbarXm K (q ^ (ringChar K ^ (m.factorization (ringChar K))))
        ((ringChar K ^ (m.factorization (ringChar K)) : ℕ) : ℤ)) (FqSub K q) := by
  have hmz := EntireLaurent.mHol_ne_zero hm
  have hF0 : FqbarXm K qbar m ≤ FqSub K q :=
    (fq_qbar_Xm_subset K q qbar hq0 hq1 hqb0 hqb1 m hmz
      ⟨d, by rw [zpow_natCast, zpow_natCast]; exact hqd⟩).1
  have hdeg := relDeg_FqbarXm hq0 hq1 hqb0 hqb1 hm hd hqd
  rcases CharP.char_is_prime_or_zero K (ringChar K) with hpr | h0
  · -- characteristic `p`
    set p := ringChar K with hpdef
    have : Fact p.Prime := ⟨hpr⟩
    have : CharP K p := ringChar.charP K
    set v := m.factorization p
    set P := p ^ v
    have hP : 0 < P := pow_pos hpr.pos v
    set m' := m / P
    have hmm : P * m' = m := Nat.ordProj_mul_ordCompl_eq_self m p
    have hm' : 0 < m' := Nat.pos_of_ne_zero (by rintro h; rw [h, mul_zero] at hmm; omega)
    have hm'K : (m' : K) ≠ 0 := by
      rw [Ne, CharP.cast_eq_zero_iff K p]
      exact Nat.not_dvd_ordCompl hpr hm.ne'
    have hPz : ((P : ℕ) : ℤ) ≠ 0 := by exact_mod_cast hP.ne'
    have hm'z : ((m' : ℕ) : ℤ) ≠ 0 := by exact_mod_cast hm'.ne'
    -- separability of `F_K(q̄|Xᵐ) ⊆ F_K(q^P|X^P)`
    have hsep1 : IsRelSeparable (FqbarXm K qbar m) (FqbarXm K (q ^ m) m) :=
      isRelSeparable_map (substPow K m)
        (isRelSeparable_FqSub_bar (norm_pow_pos hq0 m) (norm_pow_lt_one hq1 hm) hqb0 hqb1 hd hqd)
    have hsep2 : IsRelSeparable (FqbarXm K (q ^ m) m) (FqbarXm K (q ^ P) P) := by
      have e1 : FqbarXm K (q ^ m) m = (FqbarXm K ((q ^ P) ^ m') m').map (substPow K P) := by
        rw [← FqbarXm_mul _ hm'z hPz, ← pow_mul, hmm]
        congr 1; push_cast; rw [← hmm]; push_cast; ring
      have e2 : FqbarXm K (q ^ P) P = (FqSub K (q ^ P)).map (substPow K P) := rfl
      rw [e1, e2]
      exact isRelSeparable_map _ (isRelSeparable_upper (norm_pow_pos hq0 P)
        (norm_pow_lt_one hq1 hP) hm' hm'K)
    have hsep : IsRelSeparable (FqbarXm K qbar m) (FqbarXm K (q ^ P) P) :=
      isRelSeparable_trans hsep1 hsep2
    have hpure := isRelPurelyInseparable_upper (p := p) hq0 hq1 v
    refine ⟨?_, hsep, hpure⟩
    have hle2 := hpure.1
    have hupper := relDeg_upper hq0 hq1 hP
    have hpos : 0 < relDeg (FqbarXm K qbar m) (FqbarXm K (q ^ P) P) := by
      have := relDeg_mul hsep.1 hle2
      rw [hdeg, hupper] at this
      rcases Nat.eq_zero_or_pos (relDeg (FqbarXm K qbar m) (FqbarXm K (q ^ P) P)) with h | h
      · rw [h, zero_mul] at this; exact absurd this (Nat.mul_ne_zero hd.ne' hm.ne')
      · exact h
    rw [relInsepDeg_mul hsep.1 hle2 hpos, relInsepDeg_eq_one hsep, one_mul,
      relInsepDeg_eq_relDeg hpure, hupper]
  · -- characteristic `0`: everything is separable
    have hv : ringChar K ^ m.factorization (ringChar K) = 1 := by
      rw [h0, Nat.factorization_zero_right, pow_zero]
    simp only [hv, pow_one, Nat.cast_one, FqbarXm_one]
    have : CharP K 0 := ringChar.of_eq h0
    have : CharZero K := CharP.charP_to_charZero K
    have : CharZero (MeroRing K) :=
      (RingHom.charZero_iff (algebraMap K (MeroRing K)).injective).mp inferInstance
    have hsep : IsRelSeparable (FqbarXm K qbar m) (FqSub K q) := by
      refine ⟨hF0, ?_⟩
      let : Algebra (FqbarXm K qbar m) (FqSub K q) := (Subfield.inclusion hF0).toAlgebra
      have : CharZero (FqbarXm K qbar m) :=
        (RingHom.charZero_iff (FqbarXm K qbar m).subtype.injective).mpr inferInstance
      have hfr : 0 < Module.finrank (FqbarXm K qbar m) (FqSub K q) := by
        rw [← relDeg_eq hF0, hdeg]; exact Nat.mul_pos hd hm
      have : FiniteDimensional (FqbarXm K qbar m) (FqSub K q) := Module.finite_of_finrank_pos hfr
      exact Algebra.IsAlgebraic.isSeparable_of_perfectField
    refine ⟨relInsepDeg_eq_one hsep, hsep, le_rfl, ?_⟩
    let : Algebra (FqSub K q) (FqSub K q) := (Subfield.inclusion (le_refl (FqSub K q))).toAlgebra
    have : CharZero (FqSub K q) :=
      (RingHom.charZero_iff (FqSub K q).subtype.injective).mpr inferInstance
    rw [isPurelyInseparable_iff_pow_mem _ 1]
    intro x
    exact ⟨0, ⟨x, by simp only [pow_zero, pow_one]; rfl⟩⟩


section isogeny

/-- Book, §6: for `m ≠ 0` divisible by the order of `q mod^× q̄`, the substitution `μ_m` restricts to
a `K`-embedding (an isogeny) `F_K(q̄) → F_K(q)`. -/
theorem exists_substitution_isogeny (q qbar : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)
    (hqb0 : 0 < ‖qbar‖) (hqb1 : ‖qbar‖ < 1) (m : ℤ) (hm : m ≠ 0) (hdvd : OrderDvd K q qbar m) :
    ∃ μ : FqSub K qbar →ₐ[K] FqSub K q,
      (∀ x, (μ x : MeroRing K) = substPow K m (x : MeroRing K)) ∧ Function.Injective μ := by
  have hle : FqbarXm K qbar m ≤ FqSub K q :=
    (fq_qbar_Xm_subset K q qbar hq0 hq1 hqb0 hqb1 m hm hdvd).1
  let f : FqSub K qbar →+* FqSub K q :=
    ((substPow K m).comp (FqSub K qbar).subtype).codRestrict (FqSub K q)
      (fun x => hle ⟨x, x.2, rfl⟩)
  have hf : ∀ x, (f x : MeroRing K) = substPow K m (x : MeroRing K) := fun x => rfl
  refine ⟨{ f with commutes' := fun c => ?_ }, hf, ?_⟩
  · apply Subtype.ext
    show substPow K m ((FqHom K qbar c : FqSub K qbar) : MeroRing K) =
      ((FqHom K q c : FqSub K q) : MeroRing K)
    exact substPow_algebraMapK hm c
  · intro x y hxy
    apply Subtype.ext
    exact substPow_injective hm (by simpa [hf] using congrArg Subtype.val hxy)

/-- Book, §6, Corollary XVIIIa (first part): the isogeny `μ_m : F_K(q̄) → F_K(q)` has degree `dm`
if `q̄ᵈ = qᵐ`. -/
theorem substitution_isogeny_degree (q qbar : K) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1)
    (hqb0 : 0 < ‖qbar‖) (hqb1 : ‖qbar‖ < 1) (m : ℤ) (hm : m ≠ 0) (d : ℕ)
    (hd : qbar ^ d = q ^ m) : relDeg (FqbarXm K qbar m) (FqSub K q) = d * m.natAbs := by
  have hq0' : q ≠ 0 := norm_pos_iff.mp hq0
  rcases lt_or_gt_of_ne hm with hneg | hpos
  · exfalso
    have h1 : ‖qbar ^ d‖ ≤ 1 := by
      rw [norm_pow]; exact pow_le_one₀ (norm_nonneg _) hqb1.le
    have h2 : 1 < ‖q ^ m‖ := by
      rw [norm_zpow]
      exact one_lt_zpow_of_neg₀ hq0 hq1 hneg
    rw [hd] at h1; exact absurd h1 (not_le.mpr h2)
  · obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hpos.le
    have hn : 0 < n := by exact_mod_cast hpos
    have hd0 : 0 < d := by
      rcases Nat.eq_zero_or_pos d with rfl | h
      · exfalso
        have : ‖q ^ (n : ℤ)‖ = 1 := by rw [← hd]; simp
        rw [norm_zpow] at this
        exact absurd this (ne_of_lt (zpow_lt_one₀ hq0 hq1 hpos))
      · exact h
    have := thmXVII_degree K q qbar hq0 hq1 hqb0 hqb1 n d hn hd0 (by simpa using hd)
    simpa using this

end isogeny

end upper
