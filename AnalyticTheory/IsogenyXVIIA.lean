module

public import AnalyticTheory.Isogeny

/-!
# Theorem XVII (i): the degree of `F_K(q)` over `F_K(q̄ | Xᵐ)`

For `q̄ᵈ = qᵐ` (`d, m > 0`) we have the tower
`F_K(q̄ | Xᵐ) ⊆ F_K(qᵐ | Xᵐ) ⊆ F_K(q)`:

* the lower step is the image under `μ_m` of `F_K(q̄) ⊆ F_K(qᵐ)`, which is cyclic of degree `d`,
  generated by the translation `τ_{q̄}` (Artin's theorem);
* the upper step has degree `m`, with basis `uᵢ = X⁻ⁱ μ_m(τ_{qⁱ}Θ / Θ)`, `0 ≤ i < m`, where `Θ` is
  the theta function of period `qᵐ` (book, (77)).

Blueprint: `thm:XVII`.
-/

@[expose] public section

open Filter Topology

namespace AnalyticTheory

universe u

variable {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]

/-! Instance shortcuts for the generic `map_*` lemmas applied to ring homomorphisms and ring
equivalences (`H_K → M_K`, `K → H_K`, automorphisms of `M_K`, …): otherwise each use searches
through failing paths such as `Module ℚ≥0 H_K` or `CharZero M_K`, which takes seconds. -/

local instance (priority := high) {R S : Type*} [NonAssocSemiring R] [NonAssocSemiring S] :
    AddMonoidHomClass (R →+* S) R S := RingHomClass.toAddMonoidHomClass
local instance (priority := high) {R S : Type*} [NonAssocSemiring R] [NonAssocSemiring S] :
    MonoidWithZeroHomClass (R →+* S) R S := RingHomClass.toMonoidWithZeroHomClass
local instance (priority := high) {R S : Type*} [NonAssocSemiring R] [NonAssocSemiring S] :
    MonoidHomClass (R →+* S) R S := RingHomClass.toMonoidHomClass
local instance (priority := high) {R S : Type*} [NonAssocSemiring R] [NonAssocSemiring S] :
    AddHomClass (R →+* S) R S := AddMonoidHomClass.toAddHomClass
local instance (priority := high) {R S : Type*} [NonAssocSemiring R] [NonAssocSemiring S] :
    ZeroHomClass (R →+* S) R S := AddMonoidHomClass.toZeroHomClass
local instance (priority := high) {R S : Type*} [NonAssocSemiring R] [NonAssocSemiring S] :
    MulHomClass (R →+* S) R S := MonoidHomClass.toMulHomClass
local instance (priority := high) {R S : Type*} [NonAssocSemiring R] [NonAssocSemiring S] :
    OneHomClass (R →+* S) R S := MonoidHomClass.toOneHomClass
local instance (priority := high) {R S : Type*} [NonAssocSemiring R] [NonAssocSemiring S] :
    AddMonoidHomClass (R ≃+* S) R S := RingHomClass.toAddMonoidHomClass
local instance (priority := high) {R S : Type*} [NonAssocSemiring R] [NonAssocSemiring S] :
    MonoidWithZeroHomClass (R ≃+* S) R S := RingHomClass.toMonoidWithZeroHomClass
local instance (priority := high) {R S : Type*} [NonAssocSemiring R] [NonAssocSemiring S] :
    MulHomClass (R ≃+* S) R S := MonoidHomClass.toMulHomClass
local instance : NeZero (1 : Omega K) := NeZero.one

/-! ### Relative degrees of subfields -/

section relDeg

variable {M : Type*} [Field M]

theorem relDeg_eq {E F : Subfield M} (h : E ≤ F) :
    relDeg E F = letI := (Subfield.inclusion h).toAlgebra; Module.finrank E F := by
  rw [relDeg, dite_eq_left h]

/-- Multiplicativity of relative degrees in towers. -/
theorem relDeg_mul {E E' F : Subfield M} (h1 : E ≤ E') (h2 : E' ≤ F) :
    relDeg E F = relDeg E E' * relDeg E' F := by
  rw [relDeg_eq h1, relDeg_eq h2, relDeg_eq (h1.trans h2)]
  let : Algebra E E' := (Subfield.inclusion h1).toAlgebra
  let : Algebra E' F := (Subfield.inclusion h2).toAlgebra
  let : Algebra E F := (Subfield.inclusion (h1.trans h2)).toAlgebra
  let : Module E E' := Algebra.toModule
  let : Module E' F := Algebra.toModule
  let : Module E F := Algebra.toModule
  have : IsScalarTower E E' F := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  exact (Module.finrank_mul_finrank E E' F).symm

/-- A subfield is isomorphic to its image under a ring homomorphism of fields. -/
noncomputable def subfieldMapEquiv {M' : Type*} [Field M'] (μ : M →+* M') (E : Subfield M) :
    E ≃+* E.map μ :=
  RingEquiv.ofBijective (μ.restrict E (E.map μ) (fun x hx => ⟨x, hx, rfl⟩))
    ⟨fun _x _y h => Subtype.ext (μ.injective (congrArg Subtype.val h)),
      fun ⟨_, x, hx, rfl⟩ => ⟨⟨x, hx⟩, rfl⟩⟩

/-- Relative degrees are invariant under injective ring homomorphisms. -/
theorem relDeg_map {M' : Type*} [Field M'] (μ : M →+* M') {E F : Subfield M} (h : E ≤ F) :
    relDeg (E.map μ) (F.map μ) = relDeg E F := by
  have h' : E.map μ ≤ F.map μ := fun _ ⟨y, hy, hyx⟩ => ⟨y, h hy, hyx⟩
  rw [relDeg_eq h, relDeg_eq h']
  let : Algebra E F := (Subfield.inclusion h).toAlgebra
  let : Algebra (E.map μ) (F.map μ) := (Subfield.inclusion h').toAlgebra
  exact (Algebra.finrank_eq_of_equiv_equiv (subfieldMapEquiv μ E)
    (subfieldMapEquiv μ F) (by ext x; rfl)).symm

end relDeg

/-! ### Translations acting trivially on `F_K(Q)` -/

/-- A translation `τ_c` fixing all `Q`-periodic functions is a power of `Q`. -/
theorem exists_zpow_of_translation_fix {Q : K} (hQ0 : 0 < ‖Q‖) (hQ1 : ‖Q‖ < 1) (c : Kˣ)
    (h : ∀ f ∈ FqSub K Q, translation K c f = f) : ∃ k : ℤ, (c : K) = Q ^ k := by
  have hc0 : (c : K) ≠ 0 := c.ne_zero
  have hwp := h _ (wpAlg_mem_Fq hQ0 hQ1)
  have h1 := anVal_translation_shift (q := (c : K)) hc0 (one_ne_zero (α := Omega K))
    (wpAlg hQ0 hQ1)
  rw [mul_one, show Units.mk0 (c : K) hc0 = c from Units.ext rfl, hwp, anVal_wpAlg_one] at h1
  have hcΩ : algebraMap K (Omega K) (c : K) ≠ 0 := (map_ne_zero _).mpr hc0
  by_contra hno
  push Not at hno
  have hnc : ¬ ConjModQ K Q 1 (algebraMap K (Omega K) (c : K)) := by
    rw [conjModQ_one_iff (norm_pos_iff.mp hQ0)]
    rintro ⟨k, hk⟩
    exact hno k ((algebraMap K (Omega K)).injective (by rw [hk, map_zpow₀]))
  have h2 := anVal_quot_nonneg hQ0 hQ1 hcΩ hnc (Gw hQ0 hQ1) 2
  rw [← wpAlg_eq_Gw, h1] at h2
  exact absurd h2 (by decide)

/-! ### The lower step: `[F_K(qᵐ) : F_K(q̄)] = d` -/

section lower

variable {Q qbar : K} (hQ0 : 0 < ‖Q‖) (hQ1 : ‖Q‖ < 1) (hqb0 : 0 < ‖qbar‖) (hqb1 : ‖qbar‖ < 1)
  {d : ℕ} (hd : 0 < d) (hqd : qbar ^ d = Q)

/-- `τ_{q̄}` as an automorphism of `F_K(Q)`. -/
noncomputable abbrev tauBar (qbar : K) (hqb0 : 0 < ‖qbar‖) (Q : K) : FqSub K Q ≃+* FqSub K Q :=
  translationFq Q (Units.mk0 qbar (norm_pos_iff.mp hqb0))

theorem tauBar_zpow_coe (k : ℤ) (f : FqSub K Q) :
    (((tauBar qbar hqb0 Q) ^ k) f : MeroRing K) =
      translation K (Units.mk0 qbar (norm_pos_iff.mp hqb0) ^ k) (f : MeroRing K) := by
  induction k using Int.induction_on generalizing f with
  | zero => simp [translation_one]
  | succ n ih =>
    rw [zpow_add_one]
    refine (ih (tauBar qbar hqb0 Q f)).trans ?_
    rw [zpow_add_one, translation_mul]; rfl
  | pred n ih =>
    rw [zpow_sub_one]
    refine (ih ((tauBar qbar hqb0 Q)⁻¹ f)).trans ?_
    set b := Units.mk0 qbar (norm_pos_iff.mp hqb0)
    have hinv : (((tauBar qbar hqb0 Q)⁻¹ f : FqSub K Q) : MeroRing K) =
        translation K b⁻¹ (f : MeroRing K) := by
      apply (translation K b).injective
      rw [← translation_mul, mul_inv_cancel, translation_one]
      show (translation K b) ((translation K b).symm (f : MeroRing K)) = _
      rw [RingEquiv.apply_symm_apply]
    rw [hinv, ← translation_mul, zpow_sub_one]

include hQ0 hQ1 hqb1 hd hqd in
/-- Book, §6, (76): `τ_{q̄}` has order `d` as an automorphism of `F_K(Q)` when `q̄ᵈ = Q`. -/
theorem orderOf_tauBar : orderOf (tauBar qbar hqb0 Q) = d := by
  have hqb0' : qbar ≠ 0 := norm_pos_iff.mp hqb0
  have hQ0' : Q ≠ 0 := norm_pos_iff.mp hQ0
  have key : ∀ k : ℤ, (tauBar qbar hqb0 Q) ^ k = 1 ↔ (d : ℤ) ∣ k := by
    intro k
    constructor
    · intro hk
      have hfix : ∀ f ∈ FqSub K Q,
          translation K (Units.mk0 qbar hqb0' ^ k) f = f := by
        intro f hf
        have := congrArg (fun φ : FqSub K Q ≃+* FqSub K Q => (φ ⟨f, hf⟩ : MeroRing K)) hk
        simpa [tauBar_zpow_coe] using this
      obtain ⟨j, hj⟩ := exists_zpow_of_translation_fix hQ0 hQ1 _ hfix
      rw [Units.val_zpow_eq_zpow_val, Units.val_mk0, ← hqd, ← zpow_natCast, ← zpow_mul] at hj
      have hinj := zpow_right_injective₀ (norm_pos_iff.mpr hqb0') (ne_of_lt hqb1)
      have : k = d * j := hinj (by simp only; rw [← norm_zpow, ← norm_zpow, hj])
      exact ⟨j, this⟩
    · rintro ⟨j, rfl⟩
      apply RingEquiv.ext
      intro f
      apply Subtype.ext
      rw [tauBar_zpow_coe]
      have hu : Units.mk0 qbar hqb0' ^ ((d : ℤ) * j) = Units.mk0 Q hQ0' ^ j := by
        apply Units.ext
        rw [Units.val_zpow_eq_zpow_val, Units.val_zpow_eq_zpow_val, Units.val_mk0, Units.val_mk0,
          zpow_mul, zpow_natCast, hqd]
      rw [hu, translation_zpow_of_periodic (rfl : ((Units.mk0 Q hQ0' : Kˣ) : K) = Q) f.2]
      rfl
  rw [orderOf_eq_iff hd]
  refine ⟨?_, fun k hk hk0 hk' => ?_⟩
  · have := (key d).mpr dvd_rfl
    rwa [zpow_natCast] at this
  · have := (key k).mp (by rwa [zpow_natCast])
    have := Int.le_of_dvd (by exact_mod_cast hk0) this
    omega

include hd hqd in
theorem FqSub_bar_le : FqSub K qbar ≤ FqSub K Q := by
  intro f hf a ha
  have hqb0' : qbar ≠ 0 := by
    rintro rfl; rw [zero_pow (by omega : d ≠ 0)] at hqd; exact a.ne_zero (ha.trans hqd.symm)
  have : a = Units.mk0 qbar hqb0' ^ (d : ℤ) :=
    Units.ext (by rw [ha, Units.val_zpow_eq_zpow_val, Units.val_mk0, zpow_natCast, hqd])
  rw [this]
  exact translation_zpow_of_periodic rfl hf d

/-- The fixed field of `⟨τ_{q̄}⟩` in `F_K(Q)` is `F_K(q̄)`. -/
private theorem mem_fixedPoints_tauBar_iff (x : FqSub K Q) :
    x ∈ FixedPoints.subfield (Subgroup.zpowers (tauBar qbar hqb0 Q)) (FqSub K Q) ↔
      (x : MeroRing K) ∈ FqSub K qbar := by
  constructor
  · intro hx a ha
    rw [show a = Units.mk0 qbar (norm_pos_iff.mp hqb0) from Units.ext ha]
    exact congrArg Subtype.val (hx ⟨_, Subgroup.mem_zpowers _⟩)
  · intro hx g
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp g.2
    apply Subtype.ext
    change (((g : FqSub K Q ≃+* FqSub K Q)) x : MeroRing K) = x
    rw [← hk, tauBar_zpow_coe]
    exact translation_zpow_of_periodic rfl hx k

/-- `F_K(q̄)` is isomorphic to the fixed field of `⟨τ_{q̄}⟩` in `F_K(Q)`, compatibly with the
inclusion `F_K(q̄) ⊆ F_K(Q)`. -/
private noncomputable def fixedEquivBar (hle : FqSub K qbar ≤ FqSub K Q) :
    FqSub K qbar ≃+* FixedPoints.subfield (Subgroup.zpowers (tauBar qbar hqb0 Q)) (FqSub K Q) where
  toFun x := ⟨Subfield.inclusion hle x, (mem_fixedPoints_tauBar_iff hqb0 _).mpr x.2⟩
  invFun y := ⟨((y : FqSub K Q) : MeroRing K), (mem_fixedPoints_tauBar_iff hqb0 _).mp y.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl
  map_add' _ _ := rfl

include hQ0 hQ1 hqb1 hd hqd in
private theorem nat_card_zpowers_tauBar :
    Nat.card (Subgroup.zpowers (tauBar qbar hqb0 Q)) = d := by
  rw [Nat.card_zpowers, orderOf_tauBar hQ0 hQ1 hqb0 hqb1 hd hqd]

include hQ0 hQ1 hqb1 hd hqd in
private theorem finite_zpowers_tauBar : Finite (Subgroup.zpowers (tauBar qbar hqb0 Q)) :=
  Nat.finite_of_card_ne_zero (by rw [nat_card_zpowers_tauBar hQ0 hQ1 hqb0 hqb1 hd hqd]; omega)

include hQ0 hQ1 hqb0 hqb1 hd hqd in
/-- `[F_K(Q) : F_K(q̄)] = d` for `q̄ᵈ = Q`: the extension is cyclic, generated by `τ_{q̄}`. -/
theorem relDeg_FqSub_bar : relDeg (FqSub K qbar) (FqSub K Q) = d := by
  have hle : FqSub K qbar ≤ FqSub K Q := FqSub_bar_le hd hqd
  have := finite_zpowers_tauBar hQ0 hQ1 hqb0 hqb1 hd hqd
  let : Fintype (Subgroup.zpowers (tauBar qbar hqb0 Q)) := Fintype.ofFinite _
  rw [relDeg_eq hle, ← nat_card_zpowers_tauBar hQ0 hQ1 hqb0 hqb1 hd hqd, Nat.card_eq_fintype_card,
    ← FixedPoints.finrank_eq_card (Subgroup.zpowers (tauBar qbar hqb0 Q)) (FqSub K Q)]
  let : Algebra (FqSub K qbar) (FqSub K Q) := (Subfield.inclusion hle).toAlgebra
  exact Algebra.finrank_eq_of_equiv_equiv (fixedEquivBar hqb0 hle) (RingEquiv.refl _)
    (by ext x; rfl)

include hQ0 hQ1 hqb0 hqb1 hd hqd in
/-- `F_K(Q) | F_K(q̄)` is Galois, hence separable. -/
theorem isRelSeparable_FqSub_bar : IsRelSeparable (FqSub K qbar) (FqSub K Q) := by
  have hle : FqSub K qbar ≤ FqSub K Q := FqSub_bar_le hd hqd
  have := finite_zpowers_tauBar hQ0 hQ1 hqb0 hqb1 hd hqd
  refine ⟨hle, ?_⟩
  let : Algebra (FqSub K qbar) (FqSub K Q) := (Subfield.inclusion hle).toAlgebra
  have : Algebra.IsSeparable
      (FixedPoints.subfield (Subgroup.zpowers (tauBar qbar hqb0 Q)) (FqSub K Q)) (FqSub K Q) :=
    IsGalois.to_isSeparable
  exact Algebra.IsSeparable.of_equiv_equiv (fixedEquivBar hqb0 hle).symm (RingEquiv.refl _)
    (by ext x; rfl)

end lower

/-- Fast instances for subfields of `M_K` (avoids slow instance search through the many algebra
structures on `M_K`). -/
noncomputable instance (priority := high) meroSubfieldAlgebra (S : Subfield (MeroRing K)) :
    Algebra S (MeroRing K) :=
  RingHom.toAlgebra S.subtype

noncomputable instance (priority := high) meroSubfieldSMul (S : Subfield (MeroRing K)) :
    SMul S (MeroRing K) :=
  (meroSubfieldAlgebra S).toSMul

noncomputable instance (priority := high) meroSubfieldModule (S : Subfield (MeroRing K)) :
    Module S (MeroRing K) :=
  (meroSubfieldAlgebra S).toModule

/-! ### The upper step, part 1: `M_K` over `μ_m(M_K)` has basis `1, X⁻¹, …, X^{-(m-1)}` -/

section upper

variable (K)

/-- `X⁻¹ ∈ M_K`. -/
noncomputable abbrev tX : MeroRing K :=
  algebraMap (holSubring K) (MeroRing K) (monoHol K (Omega K) (-1))

/-- `μ_m(M_K)`, the meromorphic functions of `Xᵐ`. -/
noncomputable abbrev Sm (m : ℤ) : Subfield (MeroRing K) := (substPow K m).fieldRange

variable {K}

theorem monoHol_neg_nat (i : ℕ) :
    monoHol K (Omega K) (-(i : ℤ)) = monoHol K (Omega K) (-1) ^ i := by
  refine Subtype.ext (funext fun x => ?_)
  rw [pow_apply_hol, monoHol_apply, monoHol_apply, ← zpow_natCast, ← zpow_mul, neg_one_mul]

theorem alg_monoHol_neg_nat (i : ℕ) :
    algebraMap (holSubring K) (MeroRing K) (monoHol K (Omega K) (-(i : ℤ))) = tX K ^ i := by
  rw [monoHol_neg_nat, map_pow]

theorem holExpand_monoHol {m : ℤ} (hm : m ≠ 0) (n : ℤ) :
    EntireLaurent.holExpand K (Omega K) m hm (monoHol K (Omega K) n) =
      monoHol K (Omega K) (m * n) := by
  refine Subtype.ext (funext fun x => ?_)
  rw [EntireLaurent.holExpand_apply, monoHol_apply, monoHol_apply, zpow_mul]

theorem tX_ne_zero : tX K ≠ 0 :=
  alg_hol_ne_zero (monoHol_ne_zero (K := K) (-1))

theorem tX_pow_mem {m : ℕ} (hm : 0 < m) : tX K ^ m ∈ Sm K m := by
  refine ⟨tX K, ?_⟩
  rw [substPow_alg (EntireLaurent.mHol_ne_zero hm), holExpand_monoHol, mul_neg_one,
    alg_monoHol_neg_nat]

/-- Every holomorphic function is a polynomial in `X⁻¹` with coefficients in `μ_m(M_K)`. -/
theorem alg_eq_sum {m : ℕ} (hm : 0 < m) (f : holSubring K) :
    algebraMap (holSubring K) (MeroRing K) f = ∑ i ∈ Finset.range m,
      tX K ^ i * substPow K m (algebraMap (holSubring K) (MeroRing K)
        (EntireLaurent.holComponent K (Omega K) hm i f)) := by
  conv_lhs => rw [EntireLaurent.hol_decomp K hm f]
  rw [map_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [map_mul, alg_monoHol_neg_nat, substPow_alg (EntireLaurent.mHol_ne_zero hm)]

/-- Linear independence of `1, X⁻¹, …, X^{-(m-1)}` over `μ_m(M_K)`. -/
theorem tX_pow_linearIndependent {m : ℕ} (hm : 0 < m) :
    LinearIndependent (Sm K m) (fun i : Fin m => tX K ^ (i : ℕ)) := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro g hg i
  have hmz := EntireLaurent.mHol_ne_zero hm
  choose y hy using fun j : Fin m => (g j).2
  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors (holSubring K))
    Finset.univ y
  choose h hh using fun j : Fin m => hb j (Finset.mem_univ j)
  have hb0 : (b : holSubring K) ≠ 0 := nonZeroDivisors.ne_zero b.2
  -- the relation with integral coefficients
  have hrel : ∑ j : Fin m, tX K ^ (j : ℕ) *
      substPow K m (algebraMap (holSubring K) (MeroRing K) (h j)) = 0 := by
    have := congrArg (fun z => substPow K m (algebraMap (holSubring K) (MeroRing K) b) * z) hg
    simp only [mul_zero, Finset.mul_sum] at this
    rw [← this]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    have e : g j • tX K ^ (j : ℕ) = ((g j : Sm K m) : MeroRing K) * tX K ^ (j : ℕ) := rfl
    rw [hh j, Algebra.smul_def, map_mul, e, ← hy j]
    ring
  let G : ℕ → holSubring K := fun j => if hj : j < m then h ⟨j, hj⟩ else 0
  have hsum : ∑ j ∈ Finset.range m, monoHol K (Omega K) (-(j : ℤ)) *
      EntireLaurent.holExpand K (Omega K) m hmz (G j) = 0 := by
    apply IsFractionRing.injective (holSubring K) (MeroRing K)
    rw [map_zero, map_sum, ← hrel, ← Fin.sum_univ_eq_sum_range (fun j =>
      algebraMap (holSubring K) (MeroRing K) (monoHol K (Omega K) (-(j : ℤ)) *
        EntireLaurent.holExpand K (Omega K) m hmz (G j)))]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_mul, alg_monoHol_neg_nat, ← substPow_alg hmz]
    simp [G, j.2]
  have hGi := EntireLaurent.eq_zero_of_sum_mono_mul_holExpand K hm G hsum i i.2
  simp only [G, i.2, dite_eq_left] at hGi
  have hGi' : h i = 0 := by simpa using hGi
  have h1 : (b : holSubring K) • y i = 0 := by
    rw [← hh i, hGi', map_zero]
  rw [Algebra.smul_def] at h1
  have hy0 : y i = 0 := (mul_eq_zero.mp h1).resolve_left (alg_hol_ne_zero hb0)
  apply Subtype.ext
  rw [← hy i, hy0, map_zero]; rfl

/-- The span of `1, X⁻¹, …, X^{-(m-1)}` over `μ_m(M_K)`. -/
noncomputable abbrev Vm (m : ℕ) : Submodule (Sm K m) (MeroRing K) :=
  Submodule.span (Sm K m) (Set.range (fun i : Fin m => tX K ^ (i : ℕ)))

theorem tX_pow_mem_Vm {m : ℕ} (hm : 0 < m) (k : ℕ) : tX K ^ k ∈ Vm (K := K) m := by
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    by_cases hk : k < m
    · exact Submodule.subset_span ⟨⟨k, hk⟩, rfl⟩
    · have e : tX K ^ k = (⟨tX K ^ m, tX_pow_mem hm⟩ : Sm K m) • tX K ^ (k - m) := by
        show _ = tX K ^ m * tX K ^ (k - m)
        rw [← pow_add, Nat.add_sub_cancel' (not_lt.mp hk)]
      rw [e]
      exact Submodule.smul_mem _ _ (ih _ (by omega))

theorem mul_mem_Vm {m : ℕ} (hm : 0 < m) {x y : MeroRing K} (hx : x ∈ Vm (K := K) m)
    (hy : y ∈ Vm (K := K) m) : x * y ∈ Vm (K := K) m := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨j, rfl⟩ := hy
      rw [← pow_add]; exact tX_pow_mem_Vm hm _
    | zero => rw [mul_zero]; exact Submodule.zero_mem _
    | add y z _ _ h1 h2 => rw [mul_add]; exact Submodule.add_mem _ h1 h2
    | smul c y _ h =>
      rw [show tX K ^ (i : ℕ) * c • y = c • (tX K ^ (i : ℕ) * y) from mul_smul_comm c _ y]
      exact Submodule.smul_mem _ _ h
  | zero => rw [zero_mul]; exact Submodule.zero_mem _
  | add x z _ _ h1 h2 => rw [add_mul]; exact Submodule.add_mem _ h1 h2
  | smul c x _ h => rw [smul_mul_assoc]; exact Submodule.smul_mem _ _ h

theorem alg_mem_Vm {m : ℕ} (hm : 0 < m) (f : holSubring K) :
    algebraMap (holSubring K) (MeroRing K) f ∈ Vm (K := K) m := by
  rw [alg_eq_sum hm f]
  refine Submodule.sum_mem _ (fun i hi => ?_)
  have hz : substPow K m (algebraMap (holSubring K) (MeroRing K)
      (EntireLaurent.holComponent K (Omega K) hm i f)) ∈ Sm K m := ⟨_, rfl⟩
  rw [mul_comm, show substPow K m (algebraMap (holSubring K) (MeroRing K)
      (EntireLaurent.holComponent K (Omega K) hm i f)) * tX K ^ i =
      (⟨_, hz⟩ : Sm K m) • tX K ^ i from rfl]
  exact Submodule.smul_mem _ _ (tX_pow_mem_Vm hm i)


end upper
end AnalyticTheory
