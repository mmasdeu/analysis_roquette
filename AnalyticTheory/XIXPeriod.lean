module

public import AnalyticTheory.Basic

/-!
# §6, Theorem XIX: the constant extension of an elliptic subfield

If `E` is an elliptic field embedded in a function field `F | L` and `L | K` is finite, the subfield
`EL` of `F` generated by `E` and `L` is an elliptic function field over `L` (the first step of the
proof of Theorem XIX (i)).
-/

@[expose] public section

namespace AnalyticTheory

universe u

section constExtSub

variable {K L F E : Type u} [Field K] [Field L] [Field F] [Field E] [Algebra K L] [Algebra L F]
  [Algebra K F] [IsScalarTower K L F] [Algebra K E]

/-- The subfield of `F` generated by `E` and `L`. -/
def elSub (ι : E →+* F) : Subfield F := Subfield.closure (Set.range ι ∪ Set.range (algebraMap L F))

theorem algebraMap_mem_elSub (ι : E →+* F) (l : L) : algebraMap L F l ∈ elSub (L := L) ι :=
  Subfield.subset_closure (Or.inr ⟨l, rfl⟩)

theorem range_mem_elSub (ι : E →+* F) (e : E) : ι e ∈ elSub (L := L) ι :=
  Subfield.subset_closure (Or.inl ⟨e, rfl⟩)

/-- The `L`-algebra structure on a subfield of an `L`-algebra containing `L` (as `subfieldAlgebra`,
for arbitrary fields). -/
@[instance_reducible] def subAlg {L F : Type u} [Field L] [Field F] [Algebra L F] (S : Subfield F)
    (h : ∀ l : L, algebraMap L F l ∈ S) : Algebra L S :=
  ((algebraMap L F).codRestrict S h).toAlgebra

/-- The inclusion of a subfield containing `L` as an `L`-algebra homomorphism. -/
def subVal {L F : Type u} [Field L] [Field F] [Algebra L F] (S : Subfield F)
    (h : ∀ l : L, algebraMap L F l ∈ S) :
    letI := subAlg S h; S →ₐ[L] F :=
  letI := subAlg S h
  { S.subtype with commutes' := fun _ => rfl }

/-- `EL` as an `E`-algebra. -/
@[instance_reducible] def elSubAlgebraE (ι : E →+* F) : Algebra E (elSub (L := L) ι) :=
  (ι.codRestrict _ (range_mem_elSub ι)).toAlgebra

section ffield

variable [Algebra.IsAlgebraic K L]
variable (ι : E →ₐ[K] F)

omit [Algebra K L] [IsScalarTower K L F] [Algebra.IsAlgebraic K L] in
theorem elSub_algClosed (hF : IsFunctionFieldOver L F) :
    letI := subAlg (elSub (L := L) ι.toRingHom) (algebraMap_mem_elSub _)
    ∀ x : elSub (L := L) ι.toRingHom, IsIntegral L x → ∃ l : L, algebraMap L _ l = x := by
  let := subAlg (elSub (L := L) ι.toRingHom) (algebraMap_mem_elSub _)
  intro x hx
  have h1 : IsIntegral L (x : F) := hx.map (subVal _ (algebraMap_mem_elSub (L := L) _))
  obtain ⟨l, hl⟩ := hF.algebraicallyClosed _ h1
  exact ⟨l, Subtype.ext hl⟩

omit [Algebra.IsAlgebraic K L] in
theorem elSub_fg (hE : IsFunctionFieldOver K E) :
    letI := subAlg (elSub (L := L) ι.toRingHom) (algebraMap_mem_elSub _)
    ∃ s : Finset (elSub (L := L) ι.toRingHom),
      IntermediateField.adjoin L (s : Set (elSub (L := L) ι.toRingHom)) = ⊤ := by
  classical
  let := subAlg (elSub (L := L) ι.toRingHom) (algebraMap_mem_elSub _)
  obtain ⟨s, hs⟩ := hE.fg
  let j : E → elSub (L := L) ι.toRingHom := fun e => ⟨ι e, range_mem_elSub ι.toRingHom e⟩
  refine ⟨s.image j, ?_⟩
  set A := IntermediateField.adjoin L ((s.image j : Finset _) : Set (elSub (L := L) ι.toRingHom)) with hA
  have hL : ∀ l : L, (algebraMap L (elSub (L := L) ι.toRingHom) l) ∈ A := fun l => A.algebraMap_mem l
  have hE' : ∀ e : E, j e ∈ A := by
    intro e
    have he : e ∈ IntermediateField.adjoin K (s : Set E) := by rw [hs]; trivial
    induction he using IntermediateField.adjoin_induction with
    | mem x hx =>
      exact IntermediateField.subset_adjoin L _ (by simp only [Finset.coe_image]; exact ⟨x, hx, rfl⟩)
    | algebraMap c =>
      have : j (algebraMap K E c) = algebraMap L (elSub (L := L) ι.toRingHom) (algebraMap K L c) := by
        apply Subtype.ext
        show ι (algebraMap K E c) = algebraMap L F (algebraMap K L c)
        rw [AlgHom.commutes, IsScalarTower.algebraMap_apply K L F]
      rw [this]; exact hL _
    | add x y _ _ hx hy =>
      have : j (x + y) = j x + j y := Subtype.ext (map_add ι x y)
      rw [this]; exact add_mem hx hy
    | inv x _ hx =>
      have : j x⁻¹ = (j x)⁻¹ := Subtype.ext (map_inv₀ ι x)
      rw [this]; exact inv_mem hx
    | mul x y _ _ hx hy =>
      have : j (x * y) = j x * j y := Subtype.ext (map_mul ι x y)
      rw [this]; exact mul_mem hx hy
  rw [eq_top_iff]
  intro z _
  obtain ⟨z, hz⟩ := z
  have key : ∀ x (hx : x ∈ Subfield.closure (Set.range ι.toRingHom ∪ Set.range (algebraMap L F))),
      (⟨x, hx⟩ : elSub (L := L) ι.toRingHom) ∈ A := by
    intro x hx
    induction hx using Subfield.closure_induction with
    | mem x hx =>
      rcases hx with ⟨e, rfl⟩ | ⟨l, rfl⟩
      · exact hE' e
      · exact hL l
    | one => exact one_mem A
    | add x y _ _ hx hy => exact add_mem hx hy
    | neg x _ hx => exact neg_mem hx
    | inv x _ hx => exact inv_mem hx
    | mul x y _ _ hx hy => exact mul_mem hx hy
  exact key z hz

theorem elSub_isFunctionField (hE : IsFunctionFieldOver K E) (hF : IsFunctionFieldOver L F) :
    letI := subAlg (elSub (L := L) ι.toRingHom) (algebraMap_mem_elSub _)
    IsFunctionFieldOver L (elSub (L := L) ι.toRingHom) := by
  let := subAlg (elSub (L := L) ι.toRingHom) (algebraMap_mem_elSub _)
  refine ⟨elSub_fg ι hE, ?_, elSub_algClosed ι hF⟩
  obtain ⟨t, ht⟩ := hE.transcendence_degree_one
  have htr : Transcendental K t := algebraicIndependent_unique_type_iff.mp ht.1
  have hK : Transcendental K (ι t) := by
    intro h
    exact htr ((isAlgebraic_algHom_iff ι ι.toRingHom.injective).mp h)
  have hL : Transcendental L (ι t) := (Algebra.IsAlgebraic.transcendental_iff (R := K) (S := L)).mp hK
  let τ : elSub (L := L) ι.toRingHom := ⟨ι t, range_mem_elSub ι.toRingHom t⟩
  let v := subVal (elSub (L := L) ι.toRingHom) (algebraMap_mem_elSub _)
  have hτ : Transcendental L τ := fun h => hL ((isAlgebraic_algHom_iff v Subtype.val_injective).mpr h)
  refine ⟨τ, ?_⟩
  have hind : AlgebraicIndependent L (fun _ : Unit => τ) := algebraicIndependent_unique_type_iff.mpr hτ
  obtain ⟨tF, htF⟩ := hF.transcendence_degree_one
  have h1 := lift_trdeg_le_of_injective v (Subtype.val_injective (p := (· ∈ elSub (L := L) ι.toRingHom)))
  have hF1 : Algebra.trdeg L F = 1 := by
    have := htF.lift_cardinalMk_eq_trdeg
    simpa using this.symm
  simp only [Cardinal.lift_id] at h1
  rw [hF1] at h1
  refine hind.isTranscendenceBasis_of_lift_trdeg_le_of_finite ?_
  simpa using h1

end ffield

section genusPart

variable [FiniteDimensional K L] (L) (ι : E →ₐ[K] F)

/-- The field `EL` as a type with its algebra structures. -/
def EL : Type u := elSub (L := L) ι.toRingHom

instance : Field (EL L ι) := inferInstanceAs (Field (elSub (L := L) ι.toRingHom))
instance : Algebra L (EL L ι) := subAlg (elSub (L := L) ι.toRingHom) (algebraMap_mem_elSub _)
instance : Algebra E (EL L ι) := elSubAlgebraE (L := L) ι.toRingHom
instance : Algebra K (EL L ι) := ((algebraMap L (EL L ι)).comp (algebraMap K L)).toAlgebra

/-- The inclusion `EL ⊂ F`. -/
def EL.val (x : EL L ι) : F := Subtype.val (α := F) x

omit [Algebra K L] [IsScalarTower K L F] [FiniteDimensional K L] in
theorem EL_algebraMap_L (l : L) : EL.val L ι (algebraMap L (EL L ι) l) = algebraMap L F l := rfl
omit [Algebra K L] [IsScalarTower K L F] [FiniteDimensional K L] in
theorem EL_algebraMap_E (e : E) : EL.val L ι (algebraMap E (EL L ι) e) = ι e := rfl

instance : IsScalarTower K L (EL L ι) := IsScalarTower.of_algebraMap_eq fun _ => rfl

instance : IsScalarTower K E (EL L ι) := IsScalarTower.of_algebraMap_eq fun c => by
  apply Subtype.ext
  show algebraMap L F (algebraMap K L c) = ι (algebraMap K E c)
  rw [AlgHom.commutes, IsScalarTower.algebraMap_apply K L F]

omit [FiniteDimensional K L] in
theorem EL_constExt : IsConstantExtension K E L (EL L ι) := by
  refine ⟨?_⟩
  rw [eq_top_iff]
  rintro ⟨z, hz⟩ -
  have key : ∀ x (hx : x ∈ Subfield.closure (Set.range ι.toRingHom ∪ Set.range (algebraMap L F))),
      (⟨x, hx⟩ : EL L ι) ∈ Subfield.closure
        (Set.range (algebraMap E (EL L ι)) ∪ Set.range (algebraMap L (EL L ι))) := by
    intro x hx
    induction hx using Subfield.closure_induction with
    | mem x hx =>
      rcases hx with ⟨e, rfl⟩ | ⟨l, rfl⟩
      · exact Subfield.subset_closure (Or.inl ⟨e, rfl⟩)
      · exact Subfield.subset_closure (Or.inr ⟨l, rfl⟩)
    | one => exact one_mem _
    | add x y _ _ hx hy => exact add_mem hx hy
    | neg x _ hx => exact neg_mem hx
    | inv x _ hx => exact inv_mem hx
    | mul x y _ _ hx hy => exact mul_mem hx hy
  exact key z hz

theorem EL_genus (hE : IsEllipticOver K E) : genus L (EL L ι) = 1 := by
  have := hE.conservative L inferInstance (EL L ι) (EL_constExt L ι)
  rw [this]; exact hE.genus_one

theorem EL_conservative (hE : IsEllipticOver K E) : IsConservative L (EL L ι) := by
  intro L' _ _ hL' FL' _ _ _ _ _ _ hFL'
  let : Algebra K L' := ((algebraMap L L').comp (algebraMap K L)).toAlgebra
  have : IsScalarTower K L L' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : FiniteDimensional K L' := Module.Finite.trans L L'
  let : Algebra K FL' := ((algebraMap L' FL').comp (algebraMap K L')).toAlgebra
  let : Algebra E FL' := ((algebraMap (EL L ι) FL').comp (algebraMap E (EL L ι))).toAlgebra
  have : IsScalarTower K L' FL' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower K E FL' := IsScalarTower.of_algebraMap_eq fun c => by
    show algebraMap L' FL' (algebraMap K L' c) =
      algebraMap (EL L ι) FL' (algebraMap E (EL L ι) (algebraMap K E c))
    have h1 : algebraMap K L' c = algebraMap L L' (algebraMap K L c) := rfl
    rw [h1, ← IsScalarTower.algebraMap_apply L L' FL', IsScalarTower.algebraMap_apply L (EL L ι) FL',
      ← IsScalarTower.algebraMap_apply K E (EL L ι), IsScalarTower.algebraMap_apply K L (EL L ι)]
  have hconst : IsConstantExtension K E L' FL' := by
    refine ⟨?_⟩
    rw [eq_top_iff, ← hFL'.generated]
    rw [Subfield.closure_le]
    rintro _ (⟨x, rfl⟩ | ⟨l', rfl⟩)
    · have hx : x ∈ Subfield.closure (Set.range (algebraMap E (EL L ι)) ∪
          Set.range (algebraMap L (EL L ι))) := by rw [(EL_constExt L ι).generated]; trivial
      induction hx using Subfield.closure_induction with
      | mem x hx =>
        rcases hx with ⟨e, rfl⟩ | ⟨l, rfl⟩
        · exact Subfield.subset_closure (Or.inl ⟨e, rfl⟩)
        · exact Subfield.subset_closure (Or.inr ⟨algebraMap L L' l, by
            show algebraMap L' FL' (algebraMap L L' l) = algebraMap (EL L ι) FL' (algebraMap L (EL L ι) l)
            rw [← IsScalarTower.algebraMap_apply L L' FL', IsScalarTower.algebraMap_apply L (EL L ι) FL']⟩)
      | one => simp
      | add x y _ _ hx hy => simpa using add_mem hx hy
      | neg x _ hx => simpa using neg_mem hx
      | inv x _ hx => simpa using inv_mem hx
      | mul x y _ _ hx hy => simpa using mul_mem hx hy
    · exact Subfield.subset_closure (Or.inr ⟨l', rfl⟩)
  rw [hE.conservative L' inferInstance FL' hconst, EL_genus L ι hE]
  exact hE.genus_one

theorem EL_isElliptic (hE : IsEllipticOver K E) (hF : IsFunctionFieldOver L F) :
    IsEllipticOver L (EL L ι) :=
  ⟨elSub_isFunctionField ι hE.functionField hF, EL_genus L ι hE, EL_conservative L ι hE⟩

end genusPart

end constExtSub

end AnalyticTheory
