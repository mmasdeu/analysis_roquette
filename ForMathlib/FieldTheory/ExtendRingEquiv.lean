import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
import Mathlib.RingTheory.AdjoinRoot

/-!
# Homomorphisms out of fields generated by a set, and extending isomorphisms of subfields

* `IntermediateField.algHom_ext_of_adjoin_eq_top`, `IntermediateField.ringHom_ext_of_adjoin_eq_top`:
  homomorphisms out of a field `E = F(s)` that agree on `F` and on `s` are equal.
* `minpoly.natDegree_eq_finrank_of_adjoin_eq_top`: if `E = F(a)` is finite over `F`, then
  `deg minpoly_F(a) = [E : F]`.
* `Subfield.exists_ringEquiv_extend`: let `E, E'` be subfields of `F` with `F = E(a) = E'(a)`,
  `F | E` finite, and `φ : E ≃+* E'` such that `p(a) = 0 ⇒ p^φ(a) = 0` for `p ∈ E[X]`. Then `φ`
  extends to a ring automorphism of `F` fixing `a`. This is the basic step of Galois descent
  arguments in which the base field is moved, e.g. for twisted Galois actions on function fields.
-/

open Polynomial

namespace IntermediateField

section ext

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- An `F`-algebra homomorphism `E →ₐ[F] A` is determined by its values on a set generating `E`
as a field over `F` (here `A` is any semiring). -/
theorem algHom_ext_of_adjoin_eq_top {A : Type*} [Semiring A] [Algebra F A] {s : Set E}
    (hs : adjoin F s = ⊤) {φ ψ : E →ₐ[F] A} (h : ∀ x ∈ s, φ x = ψ x) :
    φ = ψ := by
  ext z
  have hz : z ∈ adjoin F s := by rw [hs]; trivial
  induction hz using adjoin_induction with
  | mem w hw => exact h w hw
  | algebraMap c => rw [AlgHom.commutes, AlgHom.commutes]
  | add a b _ _ ha hb => rw [map_add, map_add, ha, hb]
  | inv a _ ha =>
    by_cases h0 : a = 0
    · simp [h0]
    · have h1 : φ a⁻¹ * φ a = 1 := by rw [← map_mul, inv_mul_cancel₀ h0, map_one]
      have h2 : ψ a * ψ a⁻¹ = 1 := by rw [← map_mul, mul_inv_cancel₀ h0, map_one]
      calc φ a⁻¹ = φ a⁻¹ * (ψ a * ψ a⁻¹) := by rw [h2, mul_one]
        _ = (φ a⁻¹ * φ a) * ψ a⁻¹ := by rw [ha, mul_assoc]
        _ = ψ a⁻¹ := by rw [h1, one_mul]
  | mul a b _ _ ha hb => rw [map_mul, map_mul, ha, hb]

/-- A `F`-algebra automorphism of `E = F(s)` fixing `s` pointwise is the identity. -/
theorem algEquiv_eq_one_of_adjoin_eq_top {s : Set E} (hs : adjoin F s = ⊤)
    {σ : E ≃ₐ[F] E} (h : ∀ x ∈ s, σ x = x) : σ = 1 := by
  have := algHom_ext_of_adjoin_eq_top hs (φ := (σ : E →ₐ[F] E)) (ψ := AlgHom.id F E) h
  ext z; exact congrArg (fun f : E →ₐ[F] E => f z) this

/-- Two `F`-algebra automorphisms of `E = F(s)` agreeing on `s` are equal. -/
theorem algEquiv_ext_of_adjoin_eq_top {s : Set E} (hs : adjoin F s = ⊤)
    {σ τ : E ≃ₐ[F] E} (h : ∀ x ∈ s, σ x = τ x) : σ = τ := by
  have := algHom_ext_of_adjoin_eq_top hs (φ := (σ : E →ₐ[F] E)) (ψ := (τ : E →ₐ[F] E)) h
  ext z; exact congrArg (fun f : E →ₐ[F] E => f z) this

end ext

section ringHom

variable {F : Type*} [Field F]

/-- Ring homomorphisms out of `F = E(s)` (`E` a subfield) agreeing on `E` and on `s` are equal. -/
theorem ringHom_ext_of_adjoin_eq_top {A : Type*} [CommSemiring A] (E : Subfield F)
    {s : Set F} (hs : adjoin E s = ⊤) {g₁ g₂ : F →+* A} (hE : ∀ e : E, g₁ e = g₂ e)
    (h : ∀ x ∈ s, g₁ x = g₂ x) : g₁ = g₂ := by
  letI : Algebra E A := (g₁.comp E.subtype).toAlgebra
  have hc : ∀ e : E, g₂ (e : F) = algebraMap E A e := fun e => (hE e).symm
  let φ₁ : F →ₐ[E] A := { g₁ with commutes' := fun _ => rfl }
  let φ₂ : F →ₐ[E] A := { g₂ with commutes' := fun e => hc e }
  have := algHom_ext_of_adjoin_eq_top hs (φ := φ₁) (ψ := φ₂) h
  ext z; exact congrArg (fun f : F →ₐ[E] A => f z) this

end ringHom

end IntermediateField

section degree

/-- If `E = F(a)` is finite over `F`, the degree of the minimal polynomial of `a` is `[E : F]`. -/
theorem minpoly.natDegree_eq_finrank_of_adjoin_eq_top {F E : Type*} [Field F] [Field E]
    [Algebra F E] [FiniteDimensional F E] {a : E}
    (h : IntermediateField.adjoin F ({a} : Set E) = ⊤) :
    (minpoly F a).natDegree = Module.finrank F E := by
  have hint : IsIntegral F a := IsIntegral.of_finite F a
  rw [← IntermediateField.adjoin.finrank hint,
    (IntermediateField.equivOfEq h).toLinearEquiv.finrank_eq, IntermediateField.finrank_top']

end degree

namespace Subfield

section extend

variable {F : Type*} [Field F]

/-- `F` regarded as an `E`-algebra through `E ≃ E' ⊆ F` (implementation detail of
`Subfield.exists_ringEquiv_extend`). -/
def TwistAlg (_E _E' : Subfield F) (_φ : _E ≃+* _E') : Type _ := F

noncomputable instance (E E' : Subfield F) (φ : E ≃+* E') : Field (TwistAlg E E' φ) :=
  inferInstanceAs (Field F)

noncomputable instance (E E' : Subfield F) (φ : E ≃+* E') : Algebra E (TwistAlg E E' φ) :=
  ((algebraMap E' F).comp (φ : E →+* E')).toAlgebra

/-- The identity `F → TwistAlg E E' φ`. -/
def TwistAlg.mk (E E' : Subfield F) (φ : E ≃+* E') (x : F) : TwistAlg E E' φ := x

/-- Let `E, E'` be subfields of `F` with `F = E(a) = E'(a)` and `F | E` finite, and let
`φ : E ≃+* E'` map every polynomial over `E` vanishing at `a` to one vanishing at `a`. Then `φ`
extends to a ring automorphism `Φ` of `F` with `Φ a = a`. -/
theorem exists_ringEquiv_extend (E E' : Subfield F) (φ : E ≃+* E') (a : F)
    [FiniteDimensional E F]
    (hE : IntermediateField.adjoin E ({a} : Set F) = ⊤)
    (hE' : IntermediateField.adjoin E' ({a} : Set F) = ⊤)
    (hmin : ∀ p : E[X], aeval a p = 0 → aeval a (p.map (φ : E →+* E')) = 0) :
    ∃ Φ : F ≃+* F, (∀ e : E, Φ e = φ e) ∧ Φ a = a := by
  have hint : IsIntegral E a := IsIntegral.of_finite E a
  let e : IntermediateField.adjoin E ({a} : Set F) ≃ₐ[E] F :=
    (IntermediateField.equivOfEq hE).trans IntermediateField.topEquiv
  let pb : PowerBasis E F := (IntermediateField.adjoin.powerBasis hint).map e
  have hgen : pb.gen = a := by simp [pb, e]
  have hy : Polynomial.aeval (TwistAlg.mk E E' φ a) (minpoly E pb.gen) = 0 := by
    have h1 : aeval a (minpoly E pb.gen) = 0 := by rw [hgen]; exact minpoly.aeval E a
    have h2 := hmin _ h1
    have h3 : Polynomial.aeval (TwistAlg.mk E E' φ a) (minpoly E pb.gen) =
        aeval a ((minpoly E pb.gen).map (φ : E →+* E')) := by
      simp only [Polynomial.aeval_def]
      rw [Polynomial.eval₂_map]
      rfl
    rw [h3]; exact h2
  let Φ₀ : F →ₐ[E] TwistAlg E E' φ := pb.lift (TwistAlg.mk E E' φ a) hy
  let Φ₁ : F →+* F :=
    { toFun := fun x => (Φ₀ x : F)
      map_one' := Φ₀.map_one
      map_mul' := Φ₀.map_mul
      map_zero' := Φ₀.map_zero
      map_add' := Φ₀.map_add }
  have hΦe : ∀ x : E, Φ₁ x = φ x := fun x => Φ₀.commutes x
  have hΦa : Φ₁ a = a := by
    have := pb.lift_gen (TwistAlg.mk E E' φ a) hy
    rw [hgen] at this
    exact this
  have hsurj : Function.Surjective Φ₁ := by
    intro z
    have hz : z ∈ IntermediateField.adjoin E' ({a} : Set F) := by rw [hE']; trivial
    have hmem : z ∈ Φ₁.range := by
      induction hz using IntermediateField.adjoin_induction with
      | mem w hw =>
        rw [Set.mem_singleton_iff.mp hw]; exact ⟨a, hΦa⟩
      | algebraMap c =>
        refine ⟨((φ.symm c : E) : F), ?_⟩
        rw [hΦe, RingEquiv.apply_symm_apply]; rfl
      | add x y _ _ hx hy => exact add_mem hx hy
      | inv x _ hx => obtain ⟨y, rfl⟩ := hx; exact ⟨y⁻¹, map_inv₀ Φ₁ y⟩
      | mul x y _ _ hx hy => exact mul_mem hx hy
    exact hmem
  exact ⟨RingEquiv.ofBijective Φ₁ ⟨Φ₁.injective, hsurj⟩, hΦe, hΦa⟩

end extend

end Subfield
